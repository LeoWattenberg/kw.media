---
import BaseLayout from '../../../../components/layout/BaseLayout.astro';
import Mp3Guesser from '../../../../components/games/Mp3Guesser.astro';

const title = 'MP3 Guesser';
const description =
	'The daily listening game: spot the uncompressed original among LAME MP3 files from V9 up to V0.';
const alternatePaths = {
	de: '/de/games/mp3guesser/',
	en: '/en/games/mp3guesser/',
};
---

<BaseLayout
	locale="en"
	title={title}
	description={description}
	canonicalPath="/en/games/mp3guesser/"
	alternatePaths={alternatePaths}
	breadcrumbs={[
		{ label: 'Games', href: '/en/games/' },
		{ label: title, href: '/en/games/mp3guesser/' },
	]}
>
	<Mp3Guesser locale="en" />
</BaseLayout>
