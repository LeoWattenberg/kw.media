---
import { sitePages } from '../../data/pages';
import { localeLabels, routeFor, type Locale, useTranslations } from '../../i18n';
import { withBase } from '../../lib/url';

type AlternatePaths = Partial<Record<Locale, string>>;

interface Props {
	locale: Locale;
	currentPath: string;
	alternatePaths?: AlternatePaths;
}

const { locale, currentPath, alternatePaths = {} } = Astro.props;
const t = useTranslations(locale);
const alternateLocale = locale === 'de' ? 'en' : 'de';
const alternatePath = alternatePaths[alternateLocale] ?? routeFor('home', alternateLocale);
const collapsedLanguageLabel = alternateLocale === 'de' ? 'DEU' : 'ENG';
const normalizedCurrentPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const themeLabels = {
	de: {
		toggle: 'Farbschema wechseln',
		light: 'Hell',
		dark: 'Dunkel',
		scrollHint: 'Wischen für mehr',
	},
	en: {
		toggle: 'Switch color theme',
		light: 'Light',
		dark: 'Dark',
		scrollHint: 'Swipe for more',
	},
}[locale];

const pageOrder = [
	'home',
	'creator',
	'brands',
	'courses',
	'live',
	'ads',
	'website-design-management',
	'vtuber',
	'dubbing',
	'tips',
	'audacity',
	'tools',
	'games',
	'imprint-service',
	'legal',
];

const labelKeys: Record<string, string> = {
	home: 'nav.home',
	creator: 'nav.forCreators',
	brands: 'nav.forBrands',
	courses: 'nav.courses',
	live: 'nav.live',
	ads: 'nav.ads',
	'website-design-management': 'nav.websiteDesignManagement',
	vtuber: 'nav.vtuber',
	dubbing: 'nav.dubbing',
	'imprint-service': 'nav.imprintService',
	tips: 'nav.tips',
	audacity: 'nav.audacity',
	tools: 'nav.tools',
	games: 'nav.games',
	legal: 'nav.legal',
};

function pageGroup(id: string) {
	return id.replace(/-(de|en)$/, '');
}

const sidebarPages = sitePages
	.filter((page) => page.locale === locale || page.id === 'legal')
	.filter((page) => pageOrder.includes(pageGroup(page.id)))
	.sort((first, second) => pageOrder.indexOf(pageGroup(first.id)) - pageOrder.indexOf(pageGroup(second.id)));
---

<aside class="site-sidebar" aria-label={t('a11y.siteNavigation')}>
	<a class="brand" href={withBase(routeFor('home', locale))} aria-label={t('siteName')}>
		<img class="logo-light" src={withBase('/logo/logo-schwarz.svg')} alt="" width="230" height="91" />
		<img class="logo-dark" src={withBase('/logo/logo-weiß.svg')} alt="" width="230" height="91" />
		<img class="logo-light logo-small" src={withBase('/logo/logo-klein-schwarz.svg')} alt="" width="48" height="48" />
		<img class="logo-dark logo-small" src={withBase('/logo/logo-klein-weiß.svg')} alt="" width="48" height="48" />
	</a>

	<nav class="sidebar-nav" aria-label={t('a11y.mainNavigation')}>
		<div class="nav-links">
			{
				sidebarPages.map((page) => {
					const group = pageGroup(page.id);
					const isCurrentPage = page.path === normalizedCurrentPath;
					const isActive = isCurrentPage || ((group === 'tools' || group === 'games') && normalizedCurrentPath.startsWith(page.path));

					return (
						<a
							class:list={['sidebar-link', { 'is-active': isActive }]}
							href={withBase(page.path)}
							aria-current={isCurrentPage ? 'page' : isActive ? 'location' : undefined}
						>
							<span>{t(labelKeys[group] ?? page.title)}</span>
						</a>
					);
				})
			}
		</div>
	</nav>
	<p class="sidebar-scroll-hint" aria-hidden="true">{themeLabels.scrollHint}</p>

	<div class="sidebar-actions">
		<button
			class="theme-toggle"
			type="button"
			data-theme-toggle
			data-theme-light-label={themeLabels.light}
			data-theme-dark-label={themeLabels.dark}
			aria-label={themeLabels.toggle}
			aria-pressed="false"
		>
			<span class="theme-toggle-track" aria-hidden="true">
				<span class="theme-toggle-thumb"></span>
			</span>
			<span data-theme-toggle-label>{themeLabels.light}</span>
		</button>
		<a class="language-link" href={withBase(alternatePath)}>
			<span class="lang-full">{localeLabels[alternateLocale]}</span>
			<span class="lang-small">{collapsedLanguageLabel}</span>
		</a>
		<button 
			class="sidebar-collapse-toggle" 
			type="button" 
			data-sidebar-collapse-toggle 
			aria-label={t('a11y.toggleSidebar')}
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
		</button>
	</div>
</aside>

<script>
	(() => {
		const storageKey = 'kwm_theme';
		const sidebarCollapseStorageKey = 'kwm_sidebar_collapsed';
		const validThemes = new Set(['light', 'dark']);
		const desktopSidebarQuery = window.matchMedia('(min-width: 901px)');
		const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'));

		if (!toggles.length) {
			return;
		}

		const storedTheme = () => {
			try {
				const theme = localStorage.getItem(storageKey);
				return theme && validThemes.has(theme) ? theme : undefined;
			} catch {
				return undefined;
			}
		};

		const systemTheme = () => (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		const currentTheme = () => document.documentElement.dataset.theme || storedTheme() || systemTheme();

		const updateToggleLabels = (theme) => {
			toggles.forEach((toggle) => {
				const isDark = theme === 'dark';
				const label = toggle.querySelector<HTMLElement>('[data-theme-toggle-label]');
				const labelText = isDark ? toggle.dataset.themeDarkLabel : toggle.dataset.themeLightLabel;

				toggle.setAttribute('aria-pressed', String(isDark));
				if (label && labelText) {
					label.textContent = labelText;
				}
			});
		};

		const applyTheme = (theme, persist = true) => {
			const nextTheme = validThemes.has(theme) ? theme : systemTheme();

			document.documentElement.dataset.theme = nextTheme;
			document.documentElement.style.colorScheme = nextTheme;
			updateToggleLabels(nextTheme);

			if (persist) {
				try {
					localStorage.setItem(storageKey, nextTheme);
				} catch {
					// Storage can be blocked; the visual state still changes for this page.
				}
			}
		};

		updateToggleLabels(currentTheme());

		toggles.forEach((toggle) => {
			toggle.addEventListener('click', () => {
				applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
			});
		});

		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
			if (!storedTheme()) {
				applyTheme(systemTheme(), false);
			}
		});

		const collapseToggle = document.querySelector<HTMLButtonElement>('[data-sidebar-collapse-toggle]');
		if (collapseToggle) {
			const sidebar = document.querySelector<HTMLElement>('.site-sidebar');
			if (sidebar) {
				const setCollapseIcon = (isCollapsed) => {
					const svg = collapseToggle.querySelector('svg');
					if (svg) {
						svg.innerHTML = isCollapsed
							? '<path d="m9 18-6-6 6-6"/>'
							: '<path d="m15 18-6-6 6-6"/>';
					}
				};

				const syncSidebarCollapseState = () => {
					if (!desktopSidebarQuery.matches) {
						sidebar.classList.remove('is-collapsed');
						collapseToggle.setAttribute('aria-expanded', 'true');
						setCollapseIcon(false);
						return;
					}

					const wasCollapsed = localStorage.getItem(sidebarCollapseStorageKey) === 'true';
					sidebar.classList.toggle('is-collapsed', wasCollapsed);
					collapseToggle.setAttribute('aria-expanded', String(!wasCollapsed));
					setCollapseIcon(wasCollapsed);
				};

				const toggleCollapse = () => {
					if (!desktopSidebarQuery.matches) {
						return;
					}

					const isCollapsed = sidebar.classList.toggle('is-collapsed');
					localStorage.setItem(sidebarCollapseStorageKey, String(isCollapsed));
					collapseToggle.setAttribute('aria-expanded', String(!isCollapsed));
					setCollapseIcon(isCollapsed);
				};

				syncSidebarCollapseState();
				collapseToggle.addEventListener('click', toggleCollapse);
				desktopSidebarQuery.addEventListener('change', syncSidebarCollapseState);
			}
		}
	})();
</script>

<style>
	.site-sidebar {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		flex-direction: column;
		width: 280px;
		height: 100vh;
		padding: 28px 20px;
		color: var(--color-ink);
		background: var(--color-surface-raised);
		border-right: 1px solid var(--color-line);
		transition: width 0.2s ease, padding 0.2s ease;
	}

	.site-sidebar.is-collapsed {
		width: 80px;
		padding: 28px 12px;
	}

	.brand {
		display: block;
		min-width: 0;
		color: var(--color-ink);
		font-weight: 800;
		text-decoration: none;
	}

	.brand img {
		display: none;
		width: min(190px, 100%);
		height: auto;
	}

	.site-sidebar:not(.is-collapsed) .brand .logo-light:not(.logo-small) {
		display: block;
		width: 230px;
	}

	:global(:root[data-theme='dark']) .site-sidebar:not(.is-collapsed) .brand .logo-light:not(.logo-small) {
		display: none;
	}

	:global(:root[data-theme='dark']) .site-sidebar:not(.is-collapsed) .brand .logo-dark:not(.logo-small) {
		display: block;
	}

	.site-sidebar.is-collapsed .brand .logo-light.logo-small {
		display: block;
		width: 48px;
		margin: 0 auto;
	}

	:global(:root[data-theme='dark']) .site-sidebar.is-collapsed .brand .logo-light.logo-small {
		display: none;
	}

	:global(:root[data-theme='dark']) .site-sidebar.is-collapsed .brand .logo-dark.logo-small {
		display: block;
		width: 48px;
		margin: 0 auto;
	}

	.site-sidebar.is-collapsed .brand img:not(.logo-small) {
		display: none;
	}

	.sidebar-nav {
		display: grid;
		gap: 4px;
		margin-top: 34px;
	}

	.sidebar-link,
	.language-link,
	.theme-toggle {
		text-decoration: none;
	}

	.sidebar-link {
		display: flex;
		align-items: center;
		min-height: 42px;
		padding: 10px 12px;
		color: var(--color-muted);
		border-radius: 6px;
		font-size: 0.95rem;
		font-weight: 800;
	}

	.sidebar-link:hover,
	.sidebar-link.is-active {
		color: var(--color-accent-dark);
		background: var(--color-surface-alt);
	}

	.site-sidebar.is-collapsed .nav-links {
		display: none;
	}

	.sidebar-actions {
		margin-top: auto;
		display: grid;
		gap: 8px;
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		min-height: 42px;
		width: 100%;
		padding: 8px 12px;
		color: var(--color-ink);
		background: var(--color-control-surface);
		border: 1px solid var(--color-line);
		border-radius: 6px;
		font: inherit;
		font-size: 0.92rem;
		font-weight: 800;
		cursor: pointer;
	}

	.theme-toggle:hover {
		color: var(--color-accent-dark);
		border-color: var(--color-accent);
	}

	.site-sidebar.is-collapsed .theme-toggle span[data-theme-toggle-label] {
		display: none;
	}

	.site-sidebar.is-collapsed .theme-toggle {
		justify-content: center;
		padding: 8px 0;
	}

	.language-link {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		width: 100%;
		padding: 8px 12px;
		color: var(--color-muted);
		background: var(--color-control-surface);
		border: 1px solid var(--color-line);
		border-radius: 6px;
		font: inherit;
		font-size: 0.92rem;
		font-weight: 800;
		cursor: pointer;
		text-decoration: none;
	}

	.language-link:hover {
		color: var(--color-accent-dark);
		border-color: var(--color-accent);
	}

	.site-sidebar.is-collapsed .lang-full {
		display: none;
	}

	.site-sidebar.is-collapsed .lang-small {
		display: block;
	}

	.lang-small {
		display: none;
	}

	.sidebar-collapse-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		width: 100%;
		padding: 8px 0;
		color: var(--color-muted);
		background: transparent;
		border: 1px solid var(--color-line);
		border-radius: 6px;
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.sidebar-collapse-toggle:hover {
		color: var(--color-accent-dark);
		border-color: var(--color-accent);
	}

	.theme-toggle-track {
		position: relative;
		display: inline-flex;
		width: 38px;
		height: 22px;
		padding: 3px;
		background: var(--color-surface-alt);
		border: 1px solid var(--color-line);
		border-radius: 999px;
	}

	.theme-toggle-thumb {
		width: 14px;
		height: 14px;
		background: var(--color-accent);
		border-radius: 50%;
		transition: transform 160ms ease;
	}

	.theme-toggle[aria-pressed='true'] .theme-toggle-thumb {
		transform: translateX(16px);
	}

	.language-link {
		padding: 10px 12px;
		color: var(--color-ink);
		font-size: 0.92rem;
		font-weight: 800;
	}

	.language-link:hover {
		color: var(--color-accent-dark);
	}

	.sidebar-scroll-hint {
		display: none;
	}

	@media (max-width: 900px) {
		.site-sidebar {
			position: relative;
			width: 100%;
			height: auto;
			padding: 16px;
			border-right: 0;
			border-bottom: 1px solid var(--color-line);
		}

		.sidebar-nav {
			display: flex;
			gap: 8px;
			margin-top: 16px;
			overflow-x: auto;
			padding: 0 44px 8px 0;
			scrollbar-width: thin;
			mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 42px), transparent 100%);
			-webkit-mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 42px), transparent 100%);
		}

		.nav-links {
			display: flex;
			gap: 8px;
			min-width: max-content;
		}

		.sidebar-link {
			flex: 0 0 auto;
			min-height: 38px;
			white-space: nowrap;
		}

		.sidebar-scroll-hint {
			display: block;
			margin: 6px 0 0;
			color: var(--color-muted);
			font-size: 0.72rem;
			font-weight: 800;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		.sidebar-scroll-hint::after {
			content: '  →';
			color: var(--color-accent-dark);
		}

		.sidebar-actions {
			position: absolute;
			top: 16px;
			right: 16px;
			display: flex;
			align-items: center;
			gap: 8px;
			margin-top: 0;
		}

		.theme-toggle {
			min-height: 38px;
			width: auto;
			padding: 8px 10px;
		}

		.theme-toggle > span:last-child {
			display: none;
		}

		.language-link {
			padding: 9px 10px;
		}

		.sidebar-collapse-toggle {
			display: none;
		}
	}
</style>
