---
import type { Locale } from '../../i18n';
import type { GamePage } from '../../data/games';
import BaseLayout from './BaseLayout.astro';

interface Props {
	game: GamePage;
	alternatePaths: Partial<Record<Locale, string>>;
}

const { game, alternatePaths } = Astro.props;
const gamesPath = game.locale === 'de' ? '/de/games/' : '/en/games/';
const gamesLabel = game.locale === 'de' ? 'Spiele' : 'Games';
---

<BaseLayout
	locale={game.locale}
	title={game.title}
	description={game.description}
	canonicalPath={game.path}
	alternatePaths={alternatePaths}
	breadcrumbs={[
		{ label: gamesLabel, href: gamesPath },
		{ label: game.title, href: game.path },
	]}
>
	<div class="games-layout">
		<slot />
	</div>
</BaseLayout>
