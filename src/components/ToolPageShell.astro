---
import type { Locale } from '../i18n';
import type { ToolPage } from '../data/tools';
import ToolsLayout from './layout/ToolsLayout.astro';
import ToolDescription from './tools/shared/ToolDescription.astro';

interface Props {
	tool: ToolPage;
	alternatePaths: Partial<Record<Locale, string>>;
}

const { tool, alternatePaths } = Astro.props;
---

<ToolsLayout tool={tool} alternatePaths={alternatePaths}>
	<slot />
	<ToolDescription locale={tool.locale} description={tool.description} content={tool.content} />
</ToolsLayout>
