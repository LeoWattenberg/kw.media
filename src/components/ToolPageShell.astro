---
import type { Locale } from '../i18n';
import type { ToolPage } from '../data/tools';
import ToolsLayout from './layout/ToolsLayout.astro';

interface Props {
	tool: ToolPage;
	alternatePaths: Partial<Record<Locale, string>>;
}

const { tool, alternatePaths } = Astro.props;
---

<ToolsLayout tool={tool} alternatePaths={alternatePaths}>
	<slot />
</ToolsLayout>
