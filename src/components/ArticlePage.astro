---
import { getPostNavigation, getRelatedPosts, type Category, type SourcePost } from '../lib/source-content';
import { withBase } from '../lib/url';
import { getAuthorByName, getAuthorPath } from '../data/authors';
import { routeFor } from '../i18n';
import ContentHtml from './blocks/ContentHtml.astro';
import YouTubeConsentEmbed from './YouTubeConsentEmbed.astro';

interface Props {
	post: SourcePost;
}

const { post } = Astro.props;
const authorProfile = getAuthorByName(post.authorName);
const authorPath = getAuthorPath(post.authorName, post.locale);
const isShortVideo = post.video?.watchUrl.includes('/shorts/');
const videoClass = `container hero-video ${isShortVideo ? 'hero-video--short' : 'hero-video--wide'}`;
const articleContentHtml = post.postCta ? `${post.contentHtml}\n${postCtaHtml(post.postCta)}` : post.contentHtml;
const postNavigation = getPostNavigation(post);
const relatedPosts = getRelatedPosts(post);
const isVideoPost = Boolean(post.video);
const relatedVideos = isVideoPost ? relatedPosts.filter((relatedPost) => relatedPost.video) : [];
const videoNavigation = {
	previous: postNavigation.category.previous?.video
		? postNavigation.category.previous
		: postNavigation.chronological.previous?.video
			? postNavigation.chronological.previous
			: undefined,
	next: postNavigation.category.next?.video
		? postNavigation.category.next
		: postNavigation.chronological.next?.video
			? postNavigation.chronological.next
			: undefined,
};
const postOverviewPath = post.category === 'audacity'
	? routeFor('audacity', post.locale)
	: routeFor('tips', post.locale);
const formattedDate = new Date(post.date).toLocaleDateString(post.locale === 'de' ? 'de-DE' : 'en-US', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const categoryLabels: Record<typeof post.locale, Record<Category, string>> = {
	de: {
		blog: 'Blog',
		'short-tutorial': 'Kurztutorials',
		'video-tutorial': 'Video-Tutorials',
		'news-video': 'News-Videos',
		audacity: 'Audacity',
	},
	en: {
		blog: 'Blog',
		'short-tutorial': 'Short tutorials',
		'video-tutorial': 'Video tutorials',
		'news-video': 'News videos',
		audacity: 'Audacity',
	},
};

const navigationLabels = {
	de: {
		heading: 'Weitere Beiträge',
		related: 'Passende Beiträge',
		videoHeading: 'Weitere Videos',
		relatedVideos: 'Ähnliche Videos',
		previousVideo: 'Vorheriges Video',
		nextVideo: 'Nächstes Video',
		chronological: 'Chronologisch',
		category: 'In derselben Kategorie',
		previous: 'Älterer Beitrag',
		next: 'Neuerer Beitrag',
	},
	en: {
		heading: 'More posts',
		related: 'Related posts',
		videoHeading: 'More videos',
		relatedVideos: 'Related videos',
		previousVideo: 'Previous video',
		nextVideo: 'Next video',
		chronological: 'Chronological',
		category: 'In the same category',
		previous: 'Older post',
		next: 'Newer post',
	},
}[post.locale];

const authorLabels = {
	de: {
		eyebrow: 'Geschrieben von',
		credentials: 'Qualifikationen',
		profile: 'Profil ansehen',
		contact: 'Kontakt aufnehmen',
	},
	en: {
		eyebrow: 'Written by',
		credentials: 'Credentials',
		profile: 'View profile',
		contact: 'Get in touch',
	},
}[post.locale];

const navigationSections = [
	{
		title: navigationLabels.chronological,
		previous: postNavigation.chronological.previous,
		next: postNavigation.chronological.next,
	},
	{
		title: navigationLabels.category,
		categoryLabel: categoryLabels[post.locale][post.category],
		categoryHref: post.category === 'audacity' ? postOverviewPath : `${postOverviewPath}?category=${post.category}`,
		previous: postNavigation.category.previous,
		next: postNavigation.category.next,
	},
];
const hasPostNavigation = navigationSections.some((section) => section.previous || section.next);
const hasRelatedPosts = relatedPosts.length > 0;
const hasVideoNavigation = Boolean(videoNavigation.previous || videoNavigation.next);
const hasMorePosts = isVideoPost ? relatedVideos.length > 0 || hasVideoNavigation : hasRelatedPosts || hasPostNavigation;

function formatPostDate(navigationPost: SourcePost): string {
	return new Date(navigationPost.date).toLocaleDateString(navigationPost.locale === 'de' ? 'de-DE' : 'en-US', {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
	});
}

function getPostThumbnail(navigationPost: SourcePost): string | undefined {
	return navigationPost.video?.thumbnailUrl ?? navigationPost.image;
}

function postCtaHtml(postCta: NonNullable<SourcePost['postCta']>): string {
	const [beforeLink, ...afterParts] = postCta.text.split('{page}');
	const afterLink = afterParts.join('{page}');
	const pageLink = `<a href="${escapeAttribute(postCta.pagePath)}">${escapeHtml(postCta.pageTitle)}</a>`;

	return `<p>${escapeHtml(beforeLink)}${pageLink}${escapeHtml(afterLink)}</p>`;
}

function escapeHtml(value: string): string {
	return value
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;')
		.replace(/'/g, '&#39;');
}

function escapeAttribute(value: string): string {
	return escapeHtml(value).replace(/`/g, '&#96;');
}
---

<article>
	<header class="article-hero">
		<div class="container article-head">
			<div class="article-meta">
				<time class="eyebrow" datetime={post.date}>{formattedDate}</time>
				{
					authorPath ? (
						<a class="eyebrow" href={withBase(authorPath)}>{post.authorName}</a>
					) : (
						<span class="eyebrow">{post.authorName}</span>
					)
				}
			</div>
			<h1>{post.title}</h1>
			{post.excerpt && <p>{post.excerpt}</p>}
		</div>
		{
			post.video ? (
				<YouTubeConsentEmbed class={videoClass} locale={post.locale} title={post.title} src={post.video.embedUrl} loading="eager" />
			) : (
				post.image && <img src={withBase(post.image)} alt="" loading="eager" />
			)
		}
	</header>
	<ContentHtml html={articleContentHtml} locale={post.locale} />
	{
		authorProfile && (
			<section class="author-block" aria-labelledby="author-block-heading">
				<div class="container author-block-inner">
					<img src={withBase(authorProfile.image)} alt={authorProfile.imageAlt} loading="lazy" />
					<div>
						<p class="eyebrow">{authorLabels.eyebrow}</p>
						<h2 id="author-block-heading">{authorProfile.name}</h2>
						<p class="author-role">{authorProfile.role}</p>
						<p>{authorProfile.description[post.locale]}</p>
						<ul class="author-credentials" aria-label={authorLabels.credentials}>
							{authorProfile.credentials.map((credential) => <li>{credential}</li>)}
						</ul>
						<div class="author-actions">
							{authorPath && <a href={withBase(authorPath)}>{authorLabels.profile}</a>}
							<a href={`mailto:${authorProfile.email}`}>{authorLabels.contact}</a>
						</div>
					</div>
				</div>
			</section>
		)
	}
	{
		hasMorePosts && (
			<aside class:list={['more-posts', isVideoPost && 'more-posts--videos']} aria-labelledby="more-posts-heading">
				<div class="container more-posts-inner">
					<h2 id="more-posts-heading">{isVideoPost ? navigationLabels.videoHeading : navigationLabels.heading}</h2>
					{isVideoPost ? (
						<div class="more-posts-grid video-more-grid">
							{
								relatedVideos.length > 0 && (
									<section class="video-related" aria-labelledby="related-videos-heading">
										<h3 id="related-videos-heading">{navigationLabels.relatedVideos}</h3>
										<div class="video-card-grid">
											{relatedVideos.map((relatedVideo) => (
												<a class="video-card" href={withBase(relatedVideo.path)}>
													{getPostThumbnail(relatedVideo) && (
														<img src={withBase(getPostThumbnail(relatedVideo)!)} alt="" loading="lazy" />
													)}
													<span>{categoryLabels[post.locale][relatedVideo.category]}</span>
													<strong>{relatedVideo.title}</strong>
												</a>
											))}
										</div>
									</section>
								)
							}
							{
								hasVideoNavigation && (
									<nav class="video-navigation" aria-label={navigationLabels.videoHeading}>
										<div class="video-navigation-grid">
											{videoNavigation.previous && (
												<a class="video-card video-nav-card" href={withBase(videoNavigation.previous.path)}>
													{getPostThumbnail(videoNavigation.previous) && (
														<img src={withBase(getPostThumbnail(videoNavigation.previous)!)} alt="" loading="lazy" />
													)}
													<span>{navigationLabels.previousVideo}</span>
													<strong>{videoNavigation.previous.title}</strong>
													<time datetime={videoNavigation.previous.date}>{formatPostDate(videoNavigation.previous)}</time>
												</a>
											)}
											{videoNavigation.next && (
												<a class="video-card video-nav-card" href={withBase(videoNavigation.next.path)}>
													{getPostThumbnail(videoNavigation.next) && (
														<img src={withBase(getPostThumbnail(videoNavigation.next)!)} alt="" loading="lazy" />
													)}
													<span>{navigationLabels.nextVideo}</span>
													<strong>{videoNavigation.next.title}</strong>
													<time datetime={videoNavigation.next.date}>{formatPostDate(videoNavigation.next)}</time>
												</a>
											)}
										</div>
									</nav>
								)
							}
						</div>
					) : (
						<div class="more-posts-grid">
						{
							hasRelatedPosts && (
								<section class="related-posts" aria-labelledby="related-posts-heading">
									<h3 id="related-posts-heading">{navigationLabels.related}</h3>
									<ul class="related-posts-list">
										{relatedPosts.map((relatedPost) => (
											<li>
												<a href={withBase(relatedPost.path)}>{relatedPost.title}</a>
											</li>
										))}
									</ul>
								</section>
							)
						}
						{
							hasPostNavigation && (
								<nav class="post-navigation" aria-label={navigationLabels.heading}>
									<div class="post-navigation-grid">
										{navigationSections.map((section) => (
											<section class="post-navigation-section">
												<h3>
													{section.categoryLabel && section.categoryHref && (
														<>
															{section.title}: {' '}
															<a href={withBase(section.categoryHref)}>{section.categoryLabel}</a>
														</>
													)}
													{!section.categoryLabel && section.title}
												</h3>
												<div class="post-navigation-links">
													{section.previous && (
														<a class="post-navigation-card" href={withBase(section.previous.path)}>
															<span>{navigationLabels.previous}</span>
															<strong>{section.previous.title}</strong>
															<time datetime={section.previous.date}>{formatPostDate(section.previous)}</time>
														</a>
													)}
													{section.next && (
														<a class="post-navigation-card post-navigation-card--next" href={withBase(section.next.path)}>
															<span>{navigationLabels.next}</span>
															<strong>{section.next.title}</strong>
															<time datetime={section.next.date}>{formatPostDate(section.next)}</time>
														</a>
													)}
												</div>
											</section>
										))}
									</div>
								</nav>
							)
						}
						</div>
					)}
				</div>
			</aside>
		)
	}
</article>

<style>
	.article-hero {
		padding-block: clamp(48px, 8vw, 92px);
		background: var(--color-surface-alt);
		border-bottom: 1px solid var(--color-line);
	}

	.article-head {
		max-width: 920px;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 14px;
		align-items: center;
		margin-bottom: 8px;
	}

	.article-meta a {
		color: var(--color-accent-dark);
		text-decoration: none;
	}

	.article-meta a:hover {
		text-decoration: underline;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.6rem, 7vw, 5.6rem);
		line-height: 0.98;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.article-head > p:not(.eyebrow) {
		max-width: 720px;
		margin: 1rem 0 1rem;
		color: var(--color-muted);
		font-size: 1.12rem;
	}

	.article-hero img {
		display: block;
		width: min(1120px, calc(100% - 32px));
		max-height: 560px;
		margin: 36px auto 0;
		object-fit: cover;
		border-radius: 8px;
	}

	.hero-video {
		margin-top: 2rem;
	}

	.hero-video--short {
		aspect-ratio: 9 / 16;
		max-width: 420px;
	}

	.hero-video :global(iframe),
	.hero-video :global(.youtube-consent-placeholder) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		border: 0;
		border-radius: 8px;
		background: var(--color-media-background);
	}

	.hero-video--short :global(iframe),
	.hero-video--short :global(.youtube-consent-placeholder) {
		aspect-ratio: 9 / 16;
	}

	.author-block {
		background: var(--color-surface-raised);
	}

	.author-block-inner {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: 24px;
		max-width: 860px;
		padding: 24px;
		background: var(--color-surface-alt);
		border: 1px solid var(--color-line);
		border-radius: 8px;
	}

	.author-block img {
		width: 120px;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 8px;
	}

	.author-block h2 {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2.35rem);
		line-height: 1.08;
		letter-spacing: 0;
	}

	.author-block p {
		max-width: 62ch;
		margin: 0;
		color: var(--color-muted);
		font-size: 1rem;
	}

	.author-block .eyebrow {
		margin-bottom: 6px;
	}

	.author-block .author-role {
		margin: 4px 0 10px;
		color: var(--color-ink);
		font-weight: 800;
	}

	.author-credentials {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
	}

	.author-credentials li {
		padding: 6px 10px;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-line);
		border-radius: 999px;
		color: var(--color-muted);
		font-size: 0.82rem;
		font-weight: 750;
	}

	.author-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 18px;
	}

	.author-actions a {
		color: var(--color-accent-dark);
		font-weight: 850;
		text-decoration: none;
	}

	.author-actions a:hover {
		text-decoration: underline;
	}

	.more-posts {
		padding-block: clamp(42px, 7vw, 76px);
		background: var(--color-surface-raised);
	}

	.more-posts-inner {
		max-width: 860px;
	}

	.more-posts h2 {
		margin: 0 0 24px;
		font-size: clamp(1.9rem, 4vw, 3rem);
		line-height: 1.08;
		letter-spacing: 0;
	}

	.more-posts-grid {
		display: grid;
		gap: 28px;
	}

	.more-posts--videos .more-posts-inner {
		max-width: 1120px;
	}

	.video-more-grid {
		gap: 32px;
	}

	.related-posts h3,
	.post-navigation-section h3,
	.video-related h3 {
		margin: 0 0 12px;
		color: var(--color-muted);
		font-size: 0.86rem;
		font-weight: 850;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.video-card-grid,
	.video-navigation-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
	}

	.video-navigation-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.video-card {
		display: grid;
		grid-template-rows: auto auto 1fr;
		gap: 8px;
		min-width: 0;
		color: inherit;
		text-decoration: none;
	}

	.video-card img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		background: var(--color-media-background);
		border: 1px solid var(--color-line);
		border-radius: 8px;
	}

	.video-card:hover img {
		border-color: var(--color-accent-dark);
	}

	.video-card span {
		color: var(--color-accent-dark);
		font-size: 0.76rem;
		font-weight: 850;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.video-card strong {
		display: -webkit-box;
		overflow: hidden;
		font-size: 1rem;
		line-height: 1.28;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.video-card time {
		color: var(--color-muted);
		font-size: 0.86rem;
		font-weight: 750;
	}

	.video-nav-card {
		grid-template-columns: minmax(150px, 38%) minmax(0, 1fr);
		grid-template-rows: auto auto auto;
		align-items: start;
		column-gap: 14px;
		padding: 14px;
		background: var(--color-surface-alt);
		border: 1px solid var(--color-line);
		border-radius: 8px;
	}

	.video-nav-card:hover {
		border-color: var(--color-accent-dark);
	}

	.video-nav-card img {
		grid-row: 1 / 4;
		border: 0;
	}

	.related-posts-list {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		border-block: 1px solid var(--color-line);
	}

	.related-posts-list li + li {
		border-top: 1px solid var(--color-line);
	}

	.related-posts-list a {
		display: block;
		padding: 12px 0;
		color: var(--color-accent-dark);
		font-size: 1.02rem;
		font-weight: 750;
		line-height: 1.35;
		text-decoration: none;
	}

	.related-posts-list a:hover {
		text-decoration: underline;
	}

	.post-navigation {
		min-width: 0;
	}

	.post-navigation-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.post-navigation-section {
		min-width: 0;
	}

	.post-navigation-section h3 a {
		color: var(--color-accent-dark);
		text-decoration: none;
	}

	.post-navigation-section h3 a:hover {
		text-decoration: underline;
	}

	.post-navigation-links {
		display: grid;
		gap: 16px;
	}

	.post-navigation-card {
		display: grid;
		gap: 6px;
		min-height: 132px;
		align-content: start;
		padding: 18px;
		background: var(--color-surface-alt);
		border: 1px solid var(--color-line);
		border-radius: 8px;
		color: inherit;
		text-decoration: none;
	}

	.post-navigation-card:hover {
		border-color: var(--color-accent-dark);
	}

	.post-navigation-card span {
		color: var(--color-accent-dark);
		font-size: 0.78rem;
		font-weight: 850;
		text-transform: uppercase;
	}

	.post-navigation-card strong {
		font-size: 1.08rem;
		line-height: 1.22;
	}

	.post-navigation-card time {
		margin-top: auto;
		color: var(--color-muted);
		font-size: 0.88rem;
		font-weight: 750;
	}

	@media (max-width: 760px) {
		.author-block-inner {
			grid-template-columns: 1fr;
		}

		.author-block img {
			width: 96px;
		}

		.post-navigation-grid {
			grid-template-columns: 1fr;
		}

		.video-card-grid,
		.video-navigation-grid {
			grid-template-columns: 1fr;
		}

		.video-nav-card {
			grid-template-columns: minmax(104px, 36%) minmax(0, 1fr);
			padding: 12px;
		}
	}
</style>
