---
import type { Locale } from '../../i18n';
import FilePicker from './shared/FilePicker.astro';
import RangeControl from './shared/RangeControl.astro';
import SelectControl from './shared/SelectControl.astro';
import ToolActions from './shared/ToolActions.astro';
import ToolIntro from './shared/ToolIntro.astro';
import ToolPanel from './shared/ToolPanel.astro';
import ToolStatus from './shared/ToolStatus.astro';

interface Props { locale: Locale }

const { locale } = Astro.props;
const copy = {
	de: {
		eyebrow: 'Punktbasierte Segmentierung', title: 'Bildobjekt freistellen',
		intro: 'Klicke auf ein Objekt im Bild und exportiere es als transparente Datei mit MediaPipe im Browser.',
		privacy: 'Das Bild bleibt lokal. Das Segmentierungsmodell läuft clientseitig.',
		source: 'Quelle', choose: 'Bild auswählen', hint: 'PNG, JPEG, WebP und weitere Browser-Bildformate',
		settings: 'Extraktion', threshold: 'Masken-Schwelle', feather: 'Kanten weichzeichnen', format: 'Ausgabeformat',
		cut: 'Objekt ausschneiden', clear: 'Zurücksetzen', result: 'Ergebnis', download: 'Objekt herunterladen',
		exportSize: 'Ausgabe: {width} x {height}px', exportScaled: 'Ausgabe: {width} x {height}px, verkleinert von {sourceWidth} x {sourceHeight}px',
		waiting: 'Wähle ein Bild und klicke auf das Objekt.', loading: 'MediaPipe-Modell wird geladen…', ready: 'Modell bereit. Klicke auf das Objekt.',
		selected: 'Punkt gewählt. Starte Extraktion.', processing: 'Objekt wird segmentiert…', done: 'Objekt wurde ausgeschnitten.',
		noPoint: 'Klicke zuerst auf das Objekt im Bild.', loadError: 'MediaPipe konnte nicht geladen werden: {message}', error: 'Extraktion fehlgeschlagen: {message}', generic: 'Unbekannter Fehler',
	},
	en: {
		eyebrow: 'Point-based segmentation', title: 'Image Object Extractor',
		intro: 'Click an object in an image and export it as a transparent asset with MediaPipe in the browser.',
		privacy: 'The image stays local. The segmentation model runs client-side.',
		source: 'Source', choose: 'Choose image', hint: 'PNG, JPEG, WebP, and other browser image formats',
		settings: 'Extraction', threshold: 'Mask threshold', feather: 'Edge feather', format: 'Output format',
		cut: 'Cut object', clear: 'Reset', result: 'Result', download: 'Download object',
		exportSize: 'Export: {width} x {height}px', exportScaled: 'Export: {width} x {height}px, scaled down from {sourceWidth} x {sourceHeight}px',
		waiting: 'Choose an image, then click the object.', loading: 'Loading MediaPipe model…', ready: 'Model ready. Click the object.',
		selected: 'Point selected. Ready to extract.', processing: 'Segmenting object…', done: 'Object extracted.',
		noPoint: 'Click the object in the image first.', loadError: 'Could not load MediaPipe: {message}', error: 'Extraction failed: {message}', generic: 'Unknown error',
	},
}[locale];
const copyJson = JSON.stringify(copy);
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />

<section class="section object-extractor-section tool-workspace">
	<div class="container">
		<div class="object-extractor" data-object-extractor data-copy={copyJson}>
			<ToolPanel title={copy.source}>
				<FilePicker label={copy.choose} name={copy.choose} hint={copy.hint} accept="image/*,.avif,.bmp,.gif,.jpeg,.jpg,.png,.svg,.webp" nameAttrs={{ 'data-file-name': true }} metaAttrs={{ 'data-file-meta': true }} inputAttrs={{ 'data-file': true }} />
				<div class="extractor-canvas-wrap" data-canvas-wrap hidden>
					<canvas data-canvas></canvas>
					<span class="target-dot" data-target hidden></span>
				</div>
			</ToolPanel>

			<ToolPanel title={copy.settings}>
				<RangeControl label={copy.threshold} value="55%" valueAttrs={{ 'data-threshold-label': true }} inputAttrs={{ 'data-threshold': true, min: 1, max: 99, step: 1, value: 55 }} />
				<RangeControl label={copy.feather} value="2px" valueAttrs={{ 'data-feather-label': true }} inputAttrs={{ 'data-feather': true, min: 0, max: 12, step: 1, value: 2 }} />
				<SelectControl label={copy.format} selectAttrs={{ 'data-format': true }}>
					<option value="image/png">PNG</option><option value="image/webp">WebP</option>
				</SelectControl>
				<ToolActions>
					<button class="button primary" data-cut type="button" disabled>{copy.cut}</button>
					<button class="button secondary" data-clear type="button">{copy.clear}</button>
				</ToolActions>
				<ToolStatus data-status text={copy.waiting} />
			</ToolPanel>

			<ToolPanel class="result-panel" data-result-panel title={copy.result} hidden>
				<div class="result-frame" data-result-frame hidden><img data-result-image alt="" /></div>
				<p class="result-size" data-result-size hidden></p>
				<a class="tool-download-link" data-download href="#" download hidden>{copy.download}</a>
			</ToolPanel>
		</div>
	</div>
</section>

<script is:inline>
	(() => {
		const roots = document.querySelectorAll('[data-object-extractor]:not([data-object-extractor-bound])');
		for (const root of roots) {
			root.dataset.objectExtractorBound = 'true';
			initObjectExtractor(root);
		}

		function initObjectExtractor(root) {
			const copy = JSON.parse(root.dataset.copy || '{}');
			const fileInput = root.querySelector('[data-file]');
			const fileName = root.querySelector('[data-file-name]');
			const fileMeta = root.querySelector('[data-file-meta]');
			const canvasWrap = root.querySelector('[data-canvas-wrap]');
			const canvas = root.querySelector('[data-canvas]');
			const target = root.querySelector('[data-target]');
			const thresholdInput = root.querySelector('[data-threshold]');
			const thresholdLabel = root.querySelector('[data-threshold-label]');
			const featherInput = root.querySelector('[data-feather]');
			const featherLabel = root.querySelector('[data-feather-label]');
			const formatSelect = root.querySelector('[data-format]');
			const cutButton = root.querySelector('[data-cut]');
			const clearButton = root.querySelector('[data-clear]');
			const status = root.querySelector('[data-status]');
			const resultFrame = root.querySelector('[data-result-frame]');
			const resultPanel = root.querySelector('[data-result-panel]');
			const resultImage = root.querySelector('[data-result-image]');
			const resultSize = root.querySelector('[data-result-size]');
			const download = root.querySelector('[data-download]');
			const context = canvas.getContext('2d');
			const image = new Image();
			let sourceUrl = null;
			let outputUrl = null;
			let point = null;
			let segmenterPromise = null;

			thresholdInput.addEventListener('input', () => thresholdLabel.textContent = `${thresholdInput.value}%`);
			featherInput.addEventListener('input', () => featherLabel.textContent = `${featherInput.value}px`);
			fileInput.addEventListener('change', onFile);
			canvas.addEventListener('click', onPickPoint);
			cutButton.addEventListener('click', () => void cutObject());
			clearButton.addEventListener('click', reset);
			thresholdLabel.textContent = `${thresholdInput.value}%`;
			featherLabel.textContent = `${featherInput.value}px`;

			function onFile() {
				const file = fileInput.files?.[0];
				if (!file) return;
				if (sourceUrl) URL.revokeObjectURL(sourceUrl);
				sourceUrl = URL.createObjectURL(file);
				image.onload = () => {
					const maxWidth = 1200;
					const scale = Math.min(1, maxWidth / image.naturalWidth);
					canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
					canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
					context.drawImage(image, 0, 0, canvas.width, canvas.height);
					canvasWrap.hidden = false;
					point = null;
					target.hidden = true;
					cutButton.disabled = true;
					setStatus(copy.ready, 'success');
				};
				image.onerror = () => setStatus(format(copy.error, { message: copy.generic }), 'error');
				image.src = sourceUrl;
				fileName.textContent = file.name;
				fileMeta.textContent = `${formatBytes(file.size)} · ${file.type || 'image'}`;
				resultFrame.hidden = true;
				resultPanel.hidden = true;
				resultSize.hidden = true;
				download.hidden = true;
			}

			function onPickPoint(event) {
				if (!image.naturalWidth) return;
				const rect = canvas.getBoundingClientRect();
				point = {
					x: (event.clientX - rect.left) / rect.width,
					y: (event.clientY - rect.top) / rect.height,
				};
				target.style.left = `${point.x * 100}%`;
				target.style.top = `${point.y * 100}%`;
				target.hidden = false;
				cutButton.disabled = false;
				setStatus(copy.selected, 'success');
			}

			async function cutObject() {
				if (!point) { setStatus(copy.noPoint, 'error'); return; }
				try {
					const segmenter = await loadSegmenter();
					setStatus(copy.processing, 'info');
					const result = await new Promise((resolve, reject) => {
						try {
							segmenter.segment(image, { keypoint: point }, resolve);
						} catch (error) {
							reject(error);
						}
					});
					const outputCanvas = buildCutout(result);
					const mime = formatSelect.value;
					const blob = await canvasToBlob(outputCanvas, mime, 0.92);
					if (outputUrl) URL.revokeObjectURL(outputUrl);
					outputUrl = URL.createObjectURL(blob);
					resultImage.src = outputUrl;
					/* Segmentation runs on a canvas capped at 1200px wide, so the export can be smaller than the source. */
					resultSize.textContent = outputCanvas.width < image.naturalWidth || outputCanvas.height < image.naturalHeight
						? format(copy.exportScaled, { width: outputCanvas.width, height: outputCanvas.height, sourceWidth: image.naturalWidth, sourceHeight: image.naturalHeight })
						: format(copy.exportSize, { width: outputCanvas.width, height: outputCanvas.height });
					resultSize.hidden = false;
					resultPanel.hidden = false;
					resultFrame.hidden = false;
					download.href = outputUrl;
					download.download = `cut-object.${mime === 'image/webp' ? 'webp' : 'png'}`;
					download.hidden = false;
					result.categoryMask?.close?.();
					result.confidenceMasks?.forEach((mask) => mask.close?.());
					setStatus(copy.done, 'success');
				} catch (error) {
					setStatus(format(copy.error, { message: error?.message || copy.generic }), 'error');
				}
			}

			async function loadSegmenter() {
				if (segmenterPromise) return segmenterPromise;
				setStatus(copy.loading, 'info');
				segmenterPromise = (async () => {
					try {
						const vision = await import('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/+esm');
						const fileset = await vision.FilesetResolver.forVisionTasks('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm');
						const segmenter = await vision.InteractiveSegmenter.createFromOptions(fileset, {
							baseOptions: {
								modelAssetPath: 'https://storage.googleapis.com/mediapipe-tasks/interactive_segmenter/ptm_512_hdt_ptm_woid.tflite',
								delegate: 'GPU',
							},
						});
						setStatus(copy.ready, 'success');
						return segmenter;
					} catch (error) {
						segmenterPromise = null;
						throw new Error(format(copy.loadError, { message: error?.message || copy.generic }));
					}
				})();
				return segmenterPromise;
			}

			function buildCutout(result) {
				const mask = readMask(result);
				const alphaCanvas = document.createElement('canvas');
				alphaCanvas.width = canvas.width;
				alphaCanvas.height = canvas.height;
				const alphaContext = alphaCanvas.getContext('2d');
				const alphaImage = alphaContext.createImageData(canvas.width, canvas.height);
				const threshold = Number(thresholdInput.value) / 100;

				for (let y = 0; y < canvas.height; y++) {
					for (let x = 0; x < canvas.width; x++) {
						const maskX = Math.min(mask.width - 1, Math.floor(x * mask.width / canvas.width));
						const maskY = Math.min(mask.height - 1, Math.floor(y * mask.height / canvas.height));
						const value = mask.values[maskY * mask.width + maskX];
						const alpha = value >= threshold ? 255 : 0;
						const index = (y * canvas.width + x) * 4;
						alphaImage.data[index] = 255;
						alphaImage.data[index + 1] = 255;
						alphaImage.data[index + 2] = 255;
						alphaImage.data[index + 3] = alpha;
					}
				}
				alphaContext.putImageData(alphaImage, 0, 0);

				const feather = Number(featherInput.value || 0);
				const outputCanvas = document.createElement('canvas');
				outputCanvas.width = canvas.width;
				outputCanvas.height = canvas.height;
				const outputContext = outputCanvas.getContext('2d');
				outputContext.drawImage(image, 0, 0, canvas.width, canvas.height);
				outputContext.globalCompositeOperation = 'destination-in';
				if (feather > 0) {
					outputContext.filter = `blur(${feather}px)`;
				}
				outputContext.drawImage(alphaCanvas, 0, 0);
				outputContext.filter = 'none';
				outputContext.globalCompositeOperation = 'source-over';
				return outputCanvas;
			}

			function readMask(result) {
				const categoryMask = result.categoryMask;
				if (categoryMask) {
					const data = categoryMask.getAsUint8Array();
					return {
						width: categoryMask.width || canvas.width,
						height: categoryMask.height || canvas.height,
						values: Array.from(data, (value) => value > 0 ? 1 : 0),
					};
				}
				/* confidenceMasks[0] scores the background, [1] the object under the click. */
				const confidenceMask = result.confidenceMasks?.[1] || result.confidenceMasks?.[0];
				if (confidenceMask) {
					return {
						width: confidenceMask.width || canvas.width,
						height: confidenceMask.height || canvas.height,
						values: confidenceMask.getAsFloat32Array(),
					};
				}
				throw new Error(copy.generic);
			}

			function reset() {
				fileInput.value = '';
				fileName.textContent = copy.choose;
				fileMeta.textContent = copy.hint;
				canvasWrap.hidden = true;
				target.hidden = true;
				resultFrame.hidden = true;
				resultPanel.hidden = true;
				resultSize.hidden = true;
				download.hidden = true;
				cutButton.disabled = true;
				point = null;
				for (const url of [sourceUrl, outputUrl]) if (url) URL.revokeObjectURL(url);
				sourceUrl = outputUrl = null;
				setStatus(copy.waiting, 'info');
			}

			function setStatus(message, state) { status.textContent = message; status.dataset.state = state; }
			function format(template, values) { return Object.entries(values).reduce((text, [key, value]) => text.replace(`{${key}}`, String(value)), template); }
			function canvasToBlob(targetCanvas, type, quality) {
				return new Promise((resolve, reject) => targetCanvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error(copy.generic)), type, quality));
			}
			function formatBytes(bytes) { const units = ['B','KB','MB','GB']; const i = Math.min(units.length - 1, Math.floor(Math.log(Math.max(bytes,1))/Math.log(1024))); return `${(bytes/1024**i).toFixed(i ? 1 : 0)} ${units[i]}`; }
		}
	})();
</script>

<style>
	.object-extractor { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
	.object-extractor .result-panel { grid-column: 1 / -1; }
	.object-extractor [hidden] { display: none !important; }
	.extractor-canvas-wrap { position: relative; margin-top: 14px; overflow: hidden; border: 1px solid var(--color-line); border-radius: 6px; background: var(--color-surface-raised); }
	.extractor-canvas-wrap canvas { display: block; width: 100%; height: auto; cursor: crosshair; }
	.target-dot { position: absolute; width: 18px; height: 18px; border: 2px solid #fff; border-radius: 50%; box-shadow: 0 0 0 2px var(--color-accent), 0 8px 18px rgba(0,0,0,.28); transform: translate(-50%, -50%); pointer-events: none; }
	.result-frame { display: grid; place-items: center; min-height: 220px; border: 1px solid var(--color-line); border-radius: 6px; background-image: linear-gradient(45deg, rgba(127,127,127,.18) 25%, transparent 25%), linear-gradient(-45deg, rgba(127,127,127,.18) 25%, transparent 25%), linear-gradient(45deg, transparent 75%, rgba(127,127,127,.18) 75%), linear-gradient(-45deg, transparent 75%, rgba(127,127,127,.18) 75%); background-size: 24px 24px; background-position: 0 0, 0 12px, 12px -12px, -12px 0; }
	.result-frame img { display: block; max-width: 100%; height: auto; }
	.result-size { margin: 12px 0 0; color: var(--color-muted); font-size: 0.9rem; }
	@media (max-width: 860px) { .object-extractor { grid-template-columns: 1fr; } }
</style>
