---
import type { Locale } from '../../../i18n';

interface Props {
	locale: Locale;
	description: string;
	content?: string[];
}

const { locale, description, content = [] } = Astro.props;
const paragraphs = content.length ? content : [description];
const copy = locale === 'de'
	? { eyebrow: 'Tool-Beschreibung', title: 'Was dieses Tool macht' }
	: { eyebrow: 'Tool description', title: 'What this tool does' };

function inlineInternalLinks(paragraph: string) {
	const parts: Array<{ text: string; href?: string }> = [];
	const pattern = /\[([^\]]+)]\((\/(?:de|en)\/[^)]+\/)\)/g;
	let cursor = 0;
	let match;

	while ((match = pattern.exec(paragraph))) {
		parts.push({ text: paragraph.slice(cursor, match.index) });
		parts.push({ text: match[1], href: match[2] });
		cursor = match.index + match[0].length;
	}

	parts.push({ text: paragraph.slice(cursor) });
	return parts;
}
---

<section class="section tool-description">
	<div class="container">
		<div class="tool-description-card">
			<p class="eyebrow">{copy.eyebrow}</p>
			<h2>{copy.title}</h2>
			<div class="tool-description-copy">
				{paragraphs.map((paragraph) => (
					<p>{inlineInternalLinks(paragraph).map((part) => part.href ? <a href={part.href}>{part.text}</a> : part.text)}</p>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.tool-description {
		background: var(--color-surface-alt);
		border-top: 1px solid var(--color-line);
	}

	.tool-description-card {
		max-width: 780px;
	}

	.tool-description-card .eyebrow,
	.tool-description-card h2,
	.tool-description-copy,
	.tool-description-copy p {
		margin: 0;
	}

	.tool-description-copy a {
		color: var(--color-accent);
	}

	.tool-description-card h2 {
		margin-top: 6px;
		font-size: clamp(1.55rem, 3vw, 2.3rem);
		letter-spacing: 0;
	}

	.tool-description-copy {
		margin-top: 14px;
		display: grid;
		gap: 12px;
	}

	.tool-description-copy p {
		color: var(--color-muted);
		font-size: 1.04rem;
		line-height: 1.6;
	}
</style>
