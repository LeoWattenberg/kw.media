---
interface Props {
	label: string;
	class?: string;
	inputAttrs?: Record<string, unknown>;
	[key: string]: unknown;
}

const { label, class: className, inputAttrs = {}, ...attrs } = Astro.props;

const mergedInputAttrs = {
	type: 'checkbox',
	...inputAttrs,
};
---

<label {...attrs} class:list={[className, 'toggle-control']}>
	<input {...mergedInputAttrs} />
	<span>{label}</span>
</label>
