---
import type { Locale } from '../../i18n';
import ToolIntro from './shared/ToolIntro.astro';
import AnalysisPanel from './audio-analyzer/AnalysisPanel.astro';
import FileLoader from './audio-analyzer/FileLoader.astro';
import TransportToolbar from './audio-analyzer/TransportToolbar.astro';
import VisualizationPanel from './audio-analyzer/VisualizationPanel.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copyByLocale = {
	de: {
		eyebrow: 'Audio analysieren',
		title: 'Audio Analyzer',
		intro: 'Untersuche Pegel, Lautheit und Frequenzen in einer Wellenform und einem Spektrogramm.',
		privacy: 'Deine Audiodatei bleibt lokal und wird vollständig in deinem Browser analysiert.',
		choose: 'Audiodatei auswählen',
		hint: 'WAV, MP3, FLAC, OGG, M4A und weitere vom Browser unterstützte Formate',
		waiting: 'Wähle eine Audiodatei aus, um die Analyse zu starten.',
		decoding: 'Audio wird dekodiert und analysiert…',
		ready: 'Analyse bereit. Ziehe in den Ansichten, um einen Bereich auszuwählen.',
		error: 'Die Audiodatei konnte nicht analysiert werden: {message}',
		waveform: 'Wellenform',
		spectrogram: 'Spektrogramm · Roseus',
		analysis: 'Analyse',
		selection: 'Auswahl',
		entireFile: 'Gesamte Datei',
		clearSelection: 'Auswahl aufheben',
		peak: 'Peak',
		rms: 'RMS',
		momentary: 'LUFS Momentary (max.)',
		shortTerm: 'LUFS Short-term (max.)',
		integrated: 'LUFS Integrated',
		spectrum: 'Frequenzspektrum',
		frequency: 'Frequenz',
		level: 'Pegel (dBFS)',
		transport: 'Wiedergabesteuerung',
		play: 'Abspielen',
		pause: 'Pause',
		skipStart: 'Zum Start',
		stop: 'Stopp',
		fileMeta: '{duration} · {sampleRate} Hz · {channels} Kanäle',
		mono: 'Kanal',
		channels: 'Kanäle',
	},
	en: {
		eyebrow: 'Analyze audio',
		title: 'Audio Analyzer',
		intro: 'Inspect levels, loudness, and frequency content in a waveform and spectrogram.',
		privacy: 'Your audio stays local and is analyzed entirely in your browser.',
		choose: 'Select audio file',
		hint: 'WAV, MP3, FLAC, OGG, M4A, and other formats supported by your browser',
		waiting: 'Choose an audio file to start the analysis.',
		decoding: 'Decoding and analyzing audio…',
		ready: 'Analysis ready. Drag in either view to select a region.',
		error: 'The audio file could not be analyzed: {message}',
		waveform: 'Waveform',
		spectrogram: 'Spectrogram',
		analysis: 'Analysis',
		selection: 'Selection',
		entireFile: 'Entire file',
		clearSelection: 'Clear selection',
		peak: 'Peak',
		rms: 'RMS',
		momentary: 'LUFS momentary (max)',
		shortTerm: 'LUFS short-term (max)',
		integrated: 'LUFS integrated',
		spectrum: 'Frequency spectrum',
		frequency: 'Frequency',
		level: 'Level (dBFS)',
		transport: 'Playback controls',
		play: 'Play',
		pause: 'Pause',
		skipStart: 'To start',
		stop: 'Stop',
		fileMeta: '{duration} · {sampleRate} Hz · {channels} channels',
		mono: 'channel',
		channels: 'channels',
	},
} satisfies Record<Locale, Record<string, string>>;

const copy = copyByLocale[locale];
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />

<section class="section audio-analyzer-section tool-workspace">
	<div class="container analyzer-container">
		<div class="audio-analyzer" data-audio-analyzer data-copy={JSON.stringify(copy)}>
			<FileLoader chooseLabel={copy.choose} hint={copy.hint} waitingText={copy.waiting} />

			<div class="analyzer-workspace" data-workspace hidden>
				<div class="visualization-column">
					<TransportToolbar
						transportLabel={copy.transport}
						playLabel={copy.play}
						pauseLabel={copy.pause}
						skipStartLabel={copy.skipStart}
						stopLabel={copy.stop}
					/>
					<VisualizationPanel id={`spectrogram-title-${locale}`} title={copy.spectrogram} kind="spectrogram" />
					<VisualizationPanel id={`waveform-title-${locale}`} title={copy.waveform} kind="waveform" />
				</div>

				<AnalysisPanel
					id={`analysis-title-${locale}`}
					selectionLabel={copy.selection}
					analysisTitle={copy.analysis}
					clearSelectionLabel={copy.clearSelection}
					entireFileLabel={copy.entireFile}
					peakLabel={copy.peak}
					rmsLabel={copy.rms}
					momentaryLabel={copy.momentary}
					shortTermLabel={copy.shortTerm}
					integratedLabel={copy.integrated}
					spectrumTitle={copy.spectrum}
				/>
			</div>
		</div>
	</div>
</section>

<script>
	import {
		analyzeLevels,
		averageSpectrum,
		clamp,
		createSpectrogram,
		downmixChannels,
		formatAnalyzerTime,
		normalizeSelection,
		roseusColor,
	} from '../../lib/tools/audio-analyzer';
	import { formatBytes, formatTemplate } from '../../lib/tools/format';

	for (const root of document.querySelectorAll('[data-audio-analyzer]:not([data-audio-analyzer-bound])')) {
		root.dataset.audioAnalyzerBound = 'true';
		initAudioAnalyzer(root);
	}

	function initAudioAnalyzer(root) {
		const copy = JSON.parse(root.dataset.copy || '{}');
		const fileInput = root.querySelector('[data-file-input]');
		const fileName = root.querySelector('[data-file-name]');
		const fileMeta = root.querySelector('[data-file-meta]');
		const status = root.querySelector('[data-status]');
		const workspace = root.querySelector('[data-workspace]');
		const audio = root.querySelector('[data-audio]');
		const waveform = root.querySelector('[data-waveform]');
		const spectrogram = root.querySelector('[data-spectrogram]');
		const spectrum = root.querySelector('[data-spectrum]');
		const clearSelection = root.querySelector('[data-clear-selection]');
		const playPauseButton = root.querySelector('[data-play-pause]');
		const skipStartButton = root.querySelector('[data-skip-start]');
		const stopButton = root.querySelector('[data-stop]');
		const playbackTime = root.querySelector('[data-playback-time]');
		const state = {
			loadToken: 0,
			samples: null,
			sampleRate: 0,
			duration: 0,
			nyquist: 0,
			selection: null,
			waveformBase: document.createElement('canvas'),
			spectrogramBase: document.createElement('canvas'),
			spectrogramData: null,
			objectUrl: null,
			drag: null,
			verticalDrag: null,
			animationFrame: 0,
			redrawFrame: 0,
			playbackOrigin: 0,
			transportState: 'stopped',
			viewStartTime: 0,
			viewEndTime: 0,
			viewLowFrequency: 0,
			viewHighFrequency: 0,
		};

		fileInput.addEventListener('change', () => void loadFile(fileInput.files?.[0]));
		clearSelection.addEventListener('click', () => setSelection(null));
		playPauseButton.addEventListener('click', togglePlayback);
		skipStartButton.addEventListener('click', skipToStart);
		stopButton.addEventListener('click', stopPlayback);
		document.addEventListener('keydown', handleTransportShortcut);
		bindSelectionCanvas(waveform, 'waveform');
		bindSelectionCanvas(spectrogram, 'spectrogram');
		bindViewportWheel(waveform, 'waveform');
		bindViewportWheel(spectrogram, 'spectrogram');
		audio.addEventListener('play', () => {
			state.transportState = 'playing';
			updateTransport();
			animatePlayback();
		});
		audio.addEventListener('pause', () => {
			cancelAnimationFrame(state.animationFrame);
			if (state.transportState === 'playing') state.transportState = 'paused';
			updateTransport();
			renderOverlays();
		});
		audio.addEventListener('seeked', () => {
			updateTransport();
			renderOverlays();
		});
		audio.addEventListener('ended', stopPlayback);

		async function loadFile(file) {
			if (!file) return;
			/*
			 * Decoding is slow enough that a visitor can pick a second file first. Only the newest
			 * load may write to the workspace: without this a late failure would tear down the file
			 * that already loaded successfully.
			 */
			const load = ++state.loadToken;
			setStatus(copy.decoding, 'info');
			fileName.textContent = file.name;
			fileMeta.textContent = `${formatBytes(file.size)} · ${file.type || 'audio'}`;
			workspace.hidden = true;
			let context = null;

			try {
				const AudioContextClass = window.AudioContext || window.webkitAudioContext;
				if (!AudioContextClass) throw new Error('Web Audio API is not supported by this browser.');
				context = new AudioContextClass();
				const buffer = await context.decodeAudioData((await file.arrayBuffer()).slice(0));
				if (load !== state.loadToken) return;
				const channels = Array.from({ length: buffer.numberOfChannels }, (_, index) => buffer.getChannelData(index));
				state.samples = downmixChannels(channels);
				state.sampleRate = buffer.sampleRate;
				state.duration = buffer.duration;
				state.nyquist = buffer.sampleRate / 2;
				state.selection = null;
				state.playbackOrigin = 0;
				state.transportState = 'stopped';
				state.viewStartTime = 0;
				state.viewEndTime = buffer.duration;
				state.viewLowFrequency = 0;
				state.viewHighFrequency = buffer.sampleRate / 2;

				if (state.objectUrl) URL.revokeObjectURL(state.objectUrl);
				state.objectUrl = URL.createObjectURL(file);
				audio.src = state.objectUrl;
				root.querySelector('[data-loaded-name]').textContent = file.name;
				root.querySelector('[data-loaded-meta]').textContent = formatTemplate(copy.fileMeta, {
					duration: formatAnalyzerTime(buffer.duration),
					sampleRate: String(buffer.sampleRate),
					channels: String(buffer.numberOfChannels),
				});
				workspace.hidden = false;
				updateTransport();
				state.spectrogramData = createSpectrogram(state.samples, state.sampleRate);
				redrawVisualizations();
				setSelection(null);
				setStatus(copy.ready, 'success');
			} catch (error) {
				if (load !== state.loadToken) return;
				/* The workspace is gone, so the file before this one must not stay playable either. */
				unloadAudio();
				const message = error instanceof Error ? error.message : String(error);
				setStatus(formatTemplate(copy.error, { message }), 'error');
			} finally {
				if (context) await context.close().catch(() => {});
			}
		}

		function unloadAudio() {
			workspace.hidden = true;
			audio.pause();
			audio.removeAttribute('src');
			audio.load();
			if (state.objectUrl) URL.revokeObjectURL(state.objectUrl);
			state.objectUrl = null;
			state.samples = null;
			state.spectrogramData = null;
			state.sampleRate = 0;
			state.duration = 0;
			state.nyquist = 0;
			state.selection = null;
			state.playbackOrigin = 0;
			state.transportState = 'stopped';
		}

		function setSelection(selection) {
			state.selection = selection ? normalizeSelection(selection, state.duration, state.nyquist) : null;
			if (state.selection) {
				audio.pause();
				audio.currentTime = state.selection.startTime;
				state.playbackOrigin = state.selection.startTime;
				state.transportState = 'stopped';
			}
			clearSelection.disabled = !state.selection;
			updateAnalysis();
			updateTransport();
			renderOverlays();
		}

		function togglePlayback() {
			if (state.transportState === 'playing') {
				state.transportState = 'paused';
				audio.pause();
				return;
			}

			const selection = activeSelection();
			if (audio.currentTime < selection.startTime || audio.currentTime >= selection.endTime) {
				audio.currentTime = selection.startTime;
			}
			if (state.transportState !== 'paused') state.playbackOrigin = audio.currentTime;
			void audio.play();
		}

		function handleTransportShortcut(event) {
			if (!state.samples || event.repeat || event.code !== 'Space') return;

			if (event.ctrlKey && !event.altKey && !event.metaKey) {
				event.preventDefault();
				stopPlayback();
				return;
			}

			if (event.ctrlKey || event.altKey || event.metaKey || event.shiftKey) return;
			const target = event.target;
			if (target instanceof Element && target.closest('button, a, input, select, textarea, [contenteditable="true"]')) return;

			event.preventDefault();
			togglePlayback();
		}

		function skipToStart() {
			const wasPlaying = state.transportState === 'playing';
			const start = activeSelection().startTime;
			audio.currentTime = start;
			state.playbackOrigin = start;
			if (!wasPlaying) state.transportState = 'stopped';
			updateTransport();
			renderOverlays();
		}

		function stopPlayback() {
			state.transportState = 'stopped';
			audio.pause();
			audio.currentTime = clamp(state.playbackOrigin, 0, state.duration);
			updateTransport();
			renderOverlays();
		}

		function updateTransport() {
			const playing = state.transportState === 'playing';
			const label = playing ? playPauseButton.dataset.pauseLabel : playPauseButton.dataset.playLabel;
			playPauseButton.dataset.state = state.transportState;
			playPauseButton.setAttribute('aria-pressed', String(playing));
			playPauseButton.setAttribute('aria-label', label);
			playPauseButton.querySelector('[data-transport-icon]').textContent = playing ? '❚❚' : '▶';
			playPauseButton.querySelector('[data-transport-label]').textContent = label;
			playbackTime.textContent = `${formatAnalyzerTime(audio.currentTime)} / ${formatAnalyzerTime(state.duration)}`;
		}

		function activeSelection() {
			return normalizeSelection(state.selection, state.duration, state.nyquist);
		}

		function updateAnalysis() {
			if (!state.samples) return;
			const selection = activeSelection();
			const first = Math.floor(selection.startTime * state.sampleRate);
			const last = Math.max(first + 1, Math.ceil(selection.endTime * state.sampleRate));
			const selectedSamples = state.samples.subarray(first, Math.min(last, state.samples.length));
			const levels = analyzeLevels(selectedSamples, state.sampleRate);
			const values = {
				peak: levels.peakDbfs,
				rms: levels.rmsDbfs,
				momentary: levels.momentaryLufs,
				shortTerm: levels.shortTermLufs,
				integrated: levels.integratedLufs,
			};
			for (const [name, value] of Object.entries(values)) {
				root.querySelector(`[data-metric="${name}"]`).textContent = formatLevel(value);
			}

			root.querySelector('[data-selection-summary]').textContent = state.selection
				? `${formatAnalyzerTime(selection.startTime)}–${formatAnalyzerTime(selection.endTime)} · ${formatFrequency(selection.lowFrequency)}–${formatFrequency(selection.highFrequency)}`
				: copy.entireFile;
			root.querySelector('[data-time-readout]').textContent = `${formatAnalyzerTime(selection.startTime)}–${formatAnalyzerTime(selection.endTime)}`;
			root.querySelector('[data-spectrogram-readout]').textContent = `${formatFrequency(selection.lowFrequency)}–${formatFrequency(selection.highFrequency)}`;
			drawSpectrum(averageSpectrum(selectedSamples, state.sampleRate, selection));
		}

		function timeViewDuration() {
			return state.viewEndTime - state.viewStartTime;
		}

		function frequencyViewSpan() {
			return state.viewHighFrequency - state.viewLowFrequency;
		}

		function redrawVisualizations() {
			if (!state.samples || !state.spectrogramData) return;
			cancelAnimationFrame(state.redrawFrame);
			drawWaveformBase();
			drawSpectrogramBase();
			waveform.dataset.viewStart = String(state.viewStartTime);
			waveform.dataset.viewEnd = String(state.viewEndTime);
			spectrogram.dataset.viewStart = String(state.viewStartTime);
			spectrogram.dataset.viewEnd = String(state.viewEndTime);
			spectrogram.dataset.viewLowFrequency = String(state.viewLowFrequency);
			spectrogram.dataset.viewHighFrequency = String(state.viewHighFrequency);
			renderOverlays();
		}

		function scheduleVisualizationRedraw() {
			cancelAnimationFrame(state.redrawFrame);
			state.redrawFrame = requestAnimationFrame(redrawVisualizations);
		}

		function setTimeViewport(startTime, endTime) {
			const minimumSpan = Math.min(state.duration, Math.max(0.01, 32 / state.sampleRate));
			const span = clamp(endTime - startTime, minimumSpan, state.duration);
			let start = startTime;
			if (start < 0) start = 0;
			if (start + span > state.duration) start = state.duration - span;
			state.viewStartTime = clamp(start, 0, Math.max(0, state.duration - span));
			state.viewEndTime = state.viewStartTime + span;
			scheduleVisualizationRedraw();
		}

		function setFrequencyViewport(lowFrequency, highFrequency) {
			const minimumSpan = Math.min(state.nyquist, Math.max(20, state.nyquist / 1000));
			const span = clamp(highFrequency - lowFrequency, minimumSpan, state.nyquist);
			let low = lowFrequency;
			if (low < 0) low = 0;
			if (low + span > state.nyquist) low = state.nyquist - span;
			state.viewLowFrequency = clamp(low, 0, Math.max(0, state.nyquist - span));
			state.viewHighFrequency = state.viewLowFrequency + span;
			scheduleVisualizationRedraw();
		}

		function resetFrequencyViewport() {
			state.viewLowFrequency = 0;
			state.viewHighFrequency = state.nyquist;
			scheduleVisualizationRedraw();
		}

		function bindViewportWheel(canvas, kind) {
			canvas.addEventListener('wheel', (event) => {
				if (!state.samples) return;
				const point = canvasPoint(canvas, event);
				const bounds = plotBounds(canvas, kind);

				if (event.ctrlKey) {
					if (kind !== 'spectrogram') return;
					event.preventDefault();
					const shift = -event.deltaY * frequencyViewSpan() / 500;
					setFrequencyViewport(state.viewLowFrequency + shift, state.viewHighFrequency + shift);
					return;
				}

				event.preventDefault();
				if (event.shiftKey) {
					const delta = event.deltaX || event.deltaY;
					const shift = delta * timeViewDuration() / 500;
					setTimeViewport(state.viewStartTime + shift, state.viewEndTime + shift);
					return;
				}

				const anchorRatio = clamp((point.x - bounds.left) / bounds.width, 0, 1);
				const anchorTime = state.viewStartTime + anchorRatio * timeViewDuration();
				const nextSpan = timeViewDuration() * Math.exp(event.deltaY * 0.0025);
				setTimeViewport(anchorTime - anchorRatio * nextSpan, anchorTime + (1 - anchorRatio) * nextSpan);
			}, { passive: false });
		}

		function drawWaveformBase() {
			const canvas = state.waveformBase;
			canvas.width = waveform.width;
			canvas.height = waveform.height;
			const context = canvas.getContext('2d');
			const bounds = plotBounds(canvas, 'waveform');
			fillCanvas(context, canvas);
			drawTimeAxis(context, bounds);
			context.strokeStyle = cssColor('--color-accent', '#d54f70');
			context.lineWidth = 1.4;
			context.beginPath();
			const visibleFirst = Math.floor(state.viewStartTime * state.sampleRate);
			const visibleLast = Math.min(state.samples.length, Math.ceil(state.viewEndTime * state.sampleRate));
			const samplesPerPixel = Math.max(1, visibleLast - visibleFirst) / bounds.width;
			for (let x = 0; x < bounds.width; x += 1) {
				const first = visibleFirst + Math.floor(x * samplesPerPixel);
				const last = Math.max(first + 1, visibleFirst + Math.floor((x + 1) * samplesPerPixel));
				let minimum = 1;
				let maximum = -1;
				for (let index = first; index < last && index < visibleLast; index += 1) {
					minimum = Math.min(minimum, state.samples[index]);
					maximum = Math.max(maximum, state.samples[index]);
				}
				const px = bounds.left + x + 0.5;
				context.moveTo(px, bounds.top + (1 - maximum) * bounds.height / 2);
				context.lineTo(px, bounds.top + (1 - minimum) * bounds.height / 2);
			}
			context.stroke();
		}

		function drawSpectrogramBase() {
			const data = state.spectrogramData;
			const canvas = state.spectrogramBase;
			canvas.width = spectrogram.width;
			canvas.height = spectrogram.height;
			const context = canvas.getContext('2d');
			const bounds = plotBounds(canvas, 'spectrogram');
			fillCanvas(context, canvas);
			const image = context.createImageData(bounds.width, bounds.height);
			for (let x = 0; x < bounds.width; x += 1) {
				const time = state.viewStartTime + x / bounds.width * timeViewDuration();
				const frameIndex = Math.min(data.frames.length - 1, Math.floor(time / state.duration * data.frames.length));
				const frame = data.frames[Math.max(0, frameIndex)];
				for (let y = 0; y < bounds.height; y += 1) {
					const frequency = state.viewHighFrequency - y / bounds.height * frequencyViewSpan();
					const bin = Math.min(frame.length - 1, Math.floor(frequency / state.nyquist * frame.length));
					const color = roseusColor((frame[bin] + 100) / 100);
					const offset = (y * bounds.width + x) * 4;
					image.data[offset] = color[0];
					image.data[offset + 1] = color[1];
					image.data[offset + 2] = color[2];
					image.data[offset + 3] = 255;
				}
			}
			context.putImageData(image, bounds.left, bounds.top);
			drawTimeAxis(context, bounds);
			drawFrequencyAxis(context, bounds);
		}

		function renderOverlays() {
			if (!state.samples) return;
			drawOverlay(waveform, state.waveformBase, 'waveform');
			drawOverlay(spectrogram, state.spectrogramBase, 'spectrogram');
		}

		function drawOverlay(canvas, base, kind) {
			const context = canvas.getContext('2d');
			context.clearRect(0, 0, canvas.width, canvas.height);
			context.drawImage(base, 0, 0);
			const bounds = plotBounds(canvas, kind);
			const selection = state.drag?.kind === kind ? state.drag.preview : state.selection;
			if (selection) {
				const normalized = normalizeSelection(selection, state.duration, state.nyquist);
				const x = bounds.left + (normalized.startTime - state.viewStartTime) / timeViewDuration() * bounds.width;
				const width = Math.max(1, (normalized.endTime - normalized.startTime) / timeViewDuration() * bounds.width);
				let y = bounds.top;
				let height = bounds.height;
				if (kind === 'spectrogram') {
					y = bounds.top + (state.viewHighFrequency - normalized.highFrequency) / frequencyViewSpan() * bounds.height;
					height = Math.max(1, (normalized.highFrequency - normalized.lowFrequency) / frequencyViewSpan() * bounds.height);
				}
				context.save();
				context.beginPath();
				context.rect(bounds.left, bounds.top, bounds.width, bounds.height);
				context.clip();
				context.fillStyle = 'rgba(255, 255, 255, 0.17)';
				context.fillRect(x, y, width, height);
				context.strokeStyle = '#ffffff';
				context.lineWidth = 2;
				context.strokeRect(x, y, width, height);
				context.restore();
			}
			canvas.dataset.playheadTime = String(audio.currentTime);
			if (audio.currentTime >= state.viewStartTime && audio.currentTime <= state.viewEndTime) {
				const playhead = bounds.left + (audio.currentTime - state.viewStartTime) / timeViewDuration() * bounds.width;
				context.strokeStyle = '#4bf3d1';
				context.lineWidth = 2;
				context.beginPath();
				context.moveTo(playhead, bounds.top);
				context.lineTo(playhead, bounds.top + bounds.height);
				context.stroke();
			}
		}

		function bindSelectionCanvas(canvas, kind) {
			canvas.addEventListener('pointerdown', (event) => {
				if (!state.samples) return;
				const point = canvasPoint(canvas, event);
				const bounds = plotBounds(canvas, kind);
				if (kind === 'spectrogram' && isFrequencyScale(point, bounds)) {
					event.preventDefault();
					if (event.ctrlKey) {
						resetFrequencyViewport();
						return;
					}
					canvas.setPointerCapture(event.pointerId);
					state.verticalDrag = {
						start: point,
						lowFrequency: state.viewLowFrequency,
						highFrequency: state.viewHighFrequency,
					};
					return;
				}

				canvas.setPointerCapture(event.pointerId);
				state.drag = { kind, start: point, preview: selectionFromPoints(kind, point, point), moved: false };
				renderOverlays();
			});
			canvas.addEventListener('pointermove', (event) => {
				const point = canvasPoint(canvas, event);
				const bounds = plotBounds(canvas, kind);
				if (kind === 'spectrogram' && state.verticalDrag) {
					const drag = state.verticalDrag;
					const startSpan = drag.highFrequency - drag.lowFrequency;
					const anchorRatio = clamp((drag.start.y - bounds.top) / bounds.height, 0, 1);
					const anchorFrequency = drag.highFrequency - anchorRatio * startSpan;
					const nextSpan = startSpan * Math.exp((point.y - drag.start.y) * 0.012);
					setFrequencyViewport(
						anchorFrequency - (1 - anchorRatio) * nextSpan,
						anchorFrequency + anchorRatio * nextSpan,
					);
					return;
				}

				if (kind === 'spectrogram' && !state.drag) {
					canvas.style.cursor = isFrequencyScale(point, bounds) ? 'ns-resize' : 'crosshair';
				}
				if (!state.drag || state.drag.kind !== kind) return;
				state.drag.moved ||= Math.hypot(point.x - state.drag.start.x, point.y - state.drag.start.y) > 4;
				state.drag.preview = selectionFromPoints(kind, state.drag.start, point);
				renderOverlays();
			});
			canvas.addEventListener('pointerup', (event) => {
				if (kind === 'spectrogram' && state.verticalDrag) {
					state.verticalDrag = null;
					canvas.releasePointerCapture(event.pointerId);
					return;
				}
				if (!state.drag || state.drag.kind !== kind) return;
				const drag = state.drag;
				state.drag = null;
				if (drag.moved) {
					setSelection(drag.preview);
				} else {
					audio.currentTime = clamp(drag.preview.startTime, 0, state.duration);
					state.playbackOrigin = audio.currentTime;
					if (state.transportState !== 'playing') state.transportState = 'stopped';
					updateTransport();
					renderOverlays();
				}
				canvas.releasePointerCapture(event.pointerId);
			});
			canvas.addEventListener('dblclick', (event) => {
				if (kind !== 'spectrogram') return;
				const point = canvasPoint(canvas, event);
				if (!isFrequencyScale(point, plotBounds(canvas, kind))) return;
				event.preventDefault();
				resetFrequencyViewport();
			});
			canvas.addEventListener('pointerleave', () => {
				if (kind === 'spectrogram' && !state.verticalDrag) canvas.style.cursor = 'crosshair';
			});
		}

		function isFrequencyScale(point, bounds) {
			return point.x >= 0 && point.x < bounds.left && point.y >= bounds.top && point.y <= bounds.top + bounds.height;
		}

		function selectionFromPoints(kind, first, second) {
			const bounds = plotBounds(kind === 'waveform' ? waveform : spectrogram, kind);
			const startTime = state.viewStartTime + clamp((Math.min(first.x, second.x) - bounds.left) / bounds.width, 0, 1) * timeViewDuration();
			const endTime = state.viewStartTime + clamp((Math.max(first.x, second.x) - bounds.left) / bounds.width, 0, 1) * timeViewDuration();
			if (kind === 'waveform') {
				return { startTime, endTime, lowFrequency: 0, highFrequency: state.nyquist };
			}
			const lowFrequency = state.viewLowFrequency + (1 - clamp((Math.max(first.y, second.y) - bounds.top) / bounds.height, 0, 1)) * frequencyViewSpan();
			const highFrequency = state.viewLowFrequency + (1 - clamp((Math.min(first.y, second.y) - bounds.top) / bounds.height, 0, 1)) * frequencyViewSpan();
			return { startTime, endTime, lowFrequency, highFrequency };
		}

		function drawSpectrum(points) {
			const context = spectrum.getContext('2d');
			const bounds = { left: 54, top: 18, width: spectrum.width - 72, height: spectrum.height - 58 };
			fillCanvas(context, spectrum);
			context.strokeStyle = cssColor('--color-line', '#d6d2cc');
			context.fillStyle = cssColor('--color-muted', '#6f6a64');
			context.font = '12px sans-serif';
			context.textAlign = 'right';
			for (const db of [-100, -80, -60, -40, -20, 0]) {
				const y = bounds.top + (-db / 100) * bounds.height;
				context.beginPath();
				context.moveTo(bounds.left, y);
				context.lineTo(bounds.left + bounds.width, y);
				context.stroke();
				context.fillText(String(db), bounds.left - 7, y + 4);
			}
			if (!points.length) return;
			const minimumFrequency = Math.max(20, points[0].frequency);
			const maximumFrequency = Math.max(minimumFrequency * 1.01, points.at(-1).frequency);
			const logMinimum = Math.log10(minimumFrequency);
			const logRange = Math.log10(maximumFrequency) - logMinimum;
			context.beginPath();
			let started = false;
			for (const point of points) {
				if (point.frequency < minimumFrequency) continue;
				const x = bounds.left + (Math.log10(point.frequency) - logMinimum) / logRange * bounds.width;
				const y = bounds.top + clamp(-point.db / 100, 0, 1) * bounds.height;
				if (started) context.lineTo(x, y);
				else context.moveTo(x, y);
				started = true;
			}
			context.lineTo(bounds.left + bounds.width, bounds.top + bounds.height);
			context.lineTo(bounds.left, bounds.top + bounds.height);
			context.closePath();
			const gradient = context.createLinearGradient(bounds.left, 0, bounds.left + bounds.width, 0);
			gradient.addColorStop(0, '#5f164f');
			gradient.addColorStop(0.55, '#d45152');
			gradient.addColorStop(1, '#f9d383');
			context.fillStyle = gradient;
			context.globalAlpha = 0.55;
			context.fill();
			context.globalAlpha = 1;
			context.strokeStyle = '#d54f70';
			context.lineWidth = 2;
			context.stroke();
			context.fillStyle = cssColor('--color-muted', '#6f6a64');
			context.textAlign = 'center';
			for (const frequency of [20, 100, 1000, 10000, 20000]) {
				if (frequency < minimumFrequency || frequency > maximumFrequency) continue;
				const x = bounds.left + (Math.log10(frequency) - logMinimum) / logRange * bounds.width;
				context.fillText(formatFrequency(frequency), x, bounds.top + bounds.height + 20);
			}
		}

		function drawTimeAxis(context, bounds) {
			context.fillStyle = cssColor('--color-muted', '#6f6a64');
			context.font = '12px sans-serif';
			context.textAlign = 'center';
			for (let index = 0; index <= 4; index += 1) {
				const x = bounds.left + index / 4 * bounds.width;
				const time = state.viewStartTime + index / 4 * timeViewDuration();
				context.fillText(formatAnalyzerTime(time), x, bounds.top + bounds.height + 18);
			}
		}

		function drawFrequencyAxis(context, bounds) {
			context.fillStyle = '#ffffff';
			context.font = '12px sans-serif';
			context.textAlign = 'right';
			for (let index = 0; index <= 4; index += 1) {
				const frequency = state.viewHighFrequency - index / 4 * frequencyViewSpan();
				context.fillText(formatFrequency(frequency), bounds.left - 7, bounds.top + index / 4 * bounds.height + 4);
			}
		}

		function animatePlayback() {
			cancelAnimationFrame(state.animationFrame);
			const tick = () => {
				const selection = activeSelection();
				if (audio.currentTime >= selection.endTime) {
					stopPlayback();
					return;
				}
				updateTransport();
				renderOverlays();
				if (!audio.paused) state.animationFrame = requestAnimationFrame(tick);
			};
			tick();
		}

		function canvasPoint(canvas, event) {
			const rectangle = canvas.getBoundingClientRect();
			return {
				x: (event.clientX - rectangle.left) / rectangle.width * canvas.width,
				y: (event.clientY - rectangle.top) / rectangle.height * canvas.height,
			};
		}

		function plotBounds(canvas, kind) {
			const left = kind === 'spectrogram' ? 62 : 12;
			const bottom = 27;
			return { left, top: 10, width: canvas.width - left - 10, height: canvas.height - 10 - bottom };
		}

		function fillCanvas(context, canvas) {
			context.fillStyle = cssColor('--color-surface-alt', '#f4f1ec');
			context.fillRect(0, 0, canvas.width, canvas.height);
		}

		function cssColor(name, fallback) {
			return getComputedStyle(root).getPropertyValue(name).trim() || fallback;
		}

		function formatFrequency(value) {
			return value >= 1000 ? `${(value / 1000).toFixed(value >= 10000 ? 0 : 1)} kHz` : `${Math.round(value)} Hz`;
		}

		function formatLevel(value) {
			return value <= -119.9 ? '−∞' : value.toFixed(1).replace('-', '−');
		}

		function setStatus(message, stateName) {
			status.textContent = message;
			status.dataset.state = stateName;
		}
	}
</script>

<style>
	.audio-analyzer-section .analyzer-container {
		width: min(1500px, calc(100% - 32px));
	}

	.audio-analyzer {
		display: grid;
		gap: 18px;
	}

	.analyzer-workspace {
		display: grid;
		grid-template-columns: minmax(0, 2.2fr) minmax(340px, 0.9fr);
		gap: 18px;
		align-items: start;
	}

	.analyzer-workspace[hidden] {
		display: none;
	}

	.visualization-column {
		display: grid;
		gap: 14px;
		min-width: 0;
	}

	@media (max-width: 1100px) {
		.analyzer-workspace {
			grid-template-columns: 1fr;
		}
	}
</style>
