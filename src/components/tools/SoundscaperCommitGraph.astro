---
import type { Locale } from '../../i18n';
import ToolIntro from './shared/ToolIntro.astro';
import ToolPanel from './shared/ToolPanel.astro';
import ToolStatus from './shared/ToolStatus.astro';
import { withBase } from '../../lib/url';
import { COMMIT_GRAPH_DAYS, COMMIT_GRAPH_REPO, COMMIT_GRAPH_SNAPSHOT_PATH } from '../../lib/tools/commit-graph.js';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = {
	de: {
		eyebrow: 'Commit-Rhythmus', title: 'Soundscaper Commit-Graph',
		intro: `Zeigt, zu welcher Stunde die Commits der letzten ${COMMIT_GRAPH_DAYS} Tage in ${COMMIT_GRAPH_REPO} entstanden sind.`,
		privacy: 'Alles hier stammt aus einem Snapshot, den ein GitHub-Actions-Job regelmäßig neu erzeugt und der mit der Seite ausgeliefert wird. Dein Browser fragt GitHub nie selbst an: Die Zeilenzahlen allein kosten eine Anfrage pro Commit, weit mehr als ein Besuch je bekommen könnte.',
		summaryTitle: 'Überblick', statTotal: 'Commits', statActiveDays: 'Aktive Tage', statBusiestHour: 'Stärkste Stunde', statBusiestDay: 'Stärkster Tag',
		statAdded: 'Zeilen hinzugefügt', statRemoved: 'Zeilen entfernt',
		statPerDay: '{value} pro Tag im Schnitt', statOfDays: 'von {days} Tagen', statNet: 'Netto {value} Zeilen',
		linesTitle: 'Zeilen im Zeitverlauf',
		linesCaption: '{added} hinzugefügte und {removed} entfernte Zeilen, ein Balken pro Stunde.',
		linesCoverage: 'Zeilenzahlen liegen für {counted} von {total} Commits vor.',
		linesClipped: 'Balken über {ceiling} Zeilen sind gekappt — {count} von {total} Stunden.',
		linesPending: 'Für dieses Fenster liegen noch keine Zeilenzahlen vor. Der Snapshot-Job holt sie schrittweise nach.',
		legendAdded: 'hinzugefügt', legendRemoved: 'entfernt',
		tableAdded: 'Hinzugefügt', tableRemoved: 'Entfernt', tableNet: 'Netto',
		linesCellTitle: '{day}, {range}: {added} hinzugefügt, {removed} entfernt',
		linesAria: 'Balkendiagramm der hinzugefügten Zeilen über und der entfernten Zeilen unter der Nulllinie, ein Balken pro Stunde der letzten {days} Tage. Spitze am {day} um {range} mit {count} geänderten Zeilen.',
		hoursTitle: 'Commits im Zeitverlauf', hoursCaption: '{total} aus den letzten {days} Tagen, ein Balken pro Stunde.',
		heatTitle: 'Tag mal Stunde', heatCaption: 'Eine Zeile pro Tag, der neueste unten.',
		legendLess: 'weniger', legendMore: 'mehr',
		tableToggle: 'Tageswerte als Tabelle anzeigen', tableDay: 'Tag', tableCommits: 'Commits', tableShare: 'Anteil',
		loading: 'Snapshot wird geladen…',
		snapshot: '{total} aus dem Snapshot der Seite ({age} alt).',
		snapshotPlain: '{total} aus dem Snapshot der Seite.',
		empty: 'Keine Commits in den letzten {days} Tagen.',
		truncated: 'Der Snapshot wurde vorzeitig gestoppt, ältere Commits im Zeitraum fehlen.',
		error: 'Snapshot konnte nicht geladen werden: {message}', generic: 'Unbekannter Fehler',
		countOne: '1 Commit', countMany: '{count} Commits',
		cellTitle: '{day}, {range}: {count}',
		hoursAria: 'Balkendiagramm der Commits, ein Balken pro Stunde der letzten {days} Tage. Spitze am {day} um {range} mit {count}.',
		heatAria: 'Heatmap der Commits pro Tag und Stunde der letzten {days} Tage.',
	},
	en: {
		eyebrow: 'Commit rhythm', title: 'Soundscaper Commit Graph',
		intro: `See what hour the last ${COMMIT_GRAPH_DAYS} days of commits to ${COMMIT_GRAPH_REPO} were actually made.`,
		privacy: 'Everything here comes from a snapshot that a GitHub Actions job regenerates on a schedule and that ships with the page. Your browser never asks GitHub itself: the line counts alone cost one request per commit, far more than any one visit could be given.',
		summaryTitle: 'Summary', statTotal: 'Commits', statActiveDays: 'Active days', statBusiestHour: 'Busiest hour', statBusiestDay: 'Busiest day',
		statAdded: 'Lines added', statRemoved: 'Lines removed',
		statPerDay: '{value} per day on average', statOfDays: 'of {days} days', statNet: 'net {value} lines',
		linesTitle: 'Lines changed over time',
		linesCaption: '{added} lines added and {removed} removed, one bar per hour.',
		linesCoverage: 'Line counts are available for {counted} of {total} commits.',
		linesClipped: 'Bars past {ceiling} lines are cut off — {count} of {total} hours.',
		linesPending: 'No line counts for this window yet. The snapshot job backfills them run by run.',
		legendAdded: 'added', legendRemoved: 'removed',
		tableAdded: 'Added', tableRemoved: 'Removed', tableNet: 'Net',
		linesCellTitle: '{day}, {range}: {added} added, {removed} removed',
		linesAria: 'Bar chart of lines added above and lines removed below the zero line, one bar per hour across the last {days} days. Peak on {day} at {range} with {count} lines changed.',
		hoursTitle: 'Commits over time', hoursCaption: '{total} from the last {days} days, one bar per hour.',
		heatTitle: 'Day by hour', heatCaption: 'One row per day, newest at the bottom.',
		legendLess: 'less', legendMore: 'more',
		tableToggle: 'Show daily totals as a table', tableDay: 'Day', tableCommits: 'Commits', tableShare: 'Share',
		loading: 'Loading the snapshot…',
		snapshot: '{total} from the site snapshot ({age} old).',
		snapshotPlain: '{total} from the site snapshot.',
		empty: 'No commits in the last {days} days.',
		truncated: 'The snapshot stopped early, so older commits in the window are missing.',
		error: 'Could not load the snapshot: {message}', generic: 'Unknown error',
		countOne: '1 commit', countMany: '{count} commits',
		cellTitle: '{day}, {range}: {count}',
		hoursAria: 'Bar chart of commits, one bar per hour across the last {days} days. Peak on {day} at {range} with {count}.',
		heatAria: 'Heatmap of commits per day and hour over the last {days} days.',
	},
}[locale];
const copyJson = JSON.stringify(copy);
const snapshotUrl = withBase(COMMIT_GRAPH_SNAPSHOT_PATH);
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />
<section class="section commit-graph-section tool-workspace">
	<div class="container">
		<div class="commit-graph" data-commit-graph data-copy={copyJson} data-locale={locale} data-snapshot-url={snapshotUrl}>
			<ToolStatus class="commit-graph-status" data-status text={copy.loading} />
			<ToolPanel title={copy.summaryTitle} data-summary-panel hidden>
				<ul class="commit-graph-stats">
					<li><span class="stat-label">{copy.statTotal}</span><strong data-stat-total>–</strong><span class="stat-note" data-stat-total-note></span></li>
					<li><span class="stat-label">{copy.statActiveDays}</span><strong data-stat-days>–</strong><span class="stat-note" data-stat-days-note></span></li>
					<li><span class="stat-label">{copy.statBusiestHour}</span><strong data-stat-hour>–</strong><span class="stat-note" data-stat-hour-note></span></li>
					<li><span class="stat-label">{copy.statBusiestDay}</span><strong data-stat-day>–</strong><span class="stat-note" data-stat-day-note></span></li>
					<li><span class="stat-label">{copy.statAdded}</span><strong data-stat-added>–</strong><span class="stat-note" data-stat-added-note></span></li>
					<li><span class="stat-label">{copy.statRemoved}</span><strong data-stat-removed>–</strong><span class="stat-note" data-stat-removed-note></span></li>
				</ul>
			</ToolPanel>
			<ToolPanel class="commit-graph-wide" title={copy.hoursTitle} data-hours-panel hidden>
				<p class="commit-graph-caption" data-hours-caption></p>
				<div class="time-scroll">
					<div class="chart-frame time-frame">
						<div class="chart-axis time-axis" data-hours-axis></div>
						<div class="time-plot" data-bars role="img" aria-label={copy.hoursTitle}></div>
						<div></div>
						<div class="time-days" data-hours-days></div>
					</div>
				</div>
				<details class="commit-graph-table">
					<summary>{copy.tableToggle}</summary>
					<table>
						<thead><tr><th scope="col">{copy.tableDay}</th><th scope="col">{copy.tableCommits}</th><th scope="col">{copy.tableShare}</th></tr></thead>
						<tbody data-hours-table></tbody>
					</table>
				</details>
			</ToolPanel>
			<ToolPanel class="commit-graph-wide" title={copy.linesTitle} data-lines-panel hidden>
				<p class="commit-graph-caption" data-lines-caption></p>
				<div data-lines-body hidden>
					<p class="lines-legend">
						<span class="lines-key"><span class="lines-swatch" data-series="added"></span>{copy.legendAdded}</span>
						<span class="lines-key"><span class="lines-swatch" data-series="removed"></span>{copy.legendRemoved}</span>
					</p>
					<div class="time-scroll">
						<div class="chart-frame time-frame">
							<div class="chart-axis time-axis" data-lines-axis></div>
							<div class="time-plot lines-plot" data-lines role="img" aria-label={copy.linesTitle}></div>
							<div></div>
							<div class="time-days" data-lines-days></div>
						</div>
					</div>
					<details class="commit-graph-table">
						<summary>{copy.tableToggle}</summary>
						<table>
							<thead><tr><th scope="col">{copy.tableDay}</th><th scope="col">{copy.tableAdded}</th><th scope="col">{copy.tableRemoved}</th><th scope="col">{copy.tableNet}</th></tr></thead>
							<tbody data-lines-table></tbody>
						</table>
					</details>
				</div>
			</ToolPanel>
			<ToolPanel class="commit-graph-wide" title={copy.heatTitle} data-heat-panel hidden>
				<p class="commit-graph-caption" data-heat-caption></p>
				<div class="heat-scroll">
					<table class="heat-table" data-heatmap></table>
				</div>
				<p class="heat-legend">
					<span>{copy.legendLess}</span>
					<span class="heat-swatch" data-level="0"></span>
					<span class="heat-swatch" data-level="1"></span>
					<span class="heat-swatch" data-level="2"></span>
					<span class="heat-swatch" data-level="3"></span>
					<span class="heat-swatch" data-level="4"></span>
					<span class="heat-swatch" data-level="5"></span>
					<span>{copy.legendMore}</span>
				</p>
			</ToolPanel>
		</div>
	</div>
</section>

<script>
	import {
		COMMIT_GRAPH_DAYS,
		COMMIT_GRAPH_SNAPSHOT_PATH,
		buildCommitGrid,
		dayKey,
		filterCommits,
		formatAge,
		formatDayLabel,
		formatHourLabel,
		formatHourRange,
		formatLineCount,
		formatSignedLines,
		heatLevel,
		isWeekend,
		parseCommitSnapshot,
		summarizeGrid,
		utcMsToDayKey,
	} from '../../lib/tools/commit-graph.js';

	for (const root of document.querySelectorAll('[data-commit-graph]:not([data-bound])')) {
		root.dataset.bound = 'true';
		const copy = JSON.parse(root.dataset.copy || '{}');
		const locale = root.dataset.locale || 'en';
		const snapshotUrl = root.dataset.snapshotUrl || COMMIT_GRAPH_SNAPSHOT_PATH;
		const status = root.querySelector('[data-status]');
		const summaryPanel = root.querySelector('[data-summary-panel]');
		const hoursPanel = root.querySelector('[data-hours-panel]');
		const linesPanel = root.querySelector('[data-lines-panel]');
		const heatPanel = root.querySelector('[data-heat-panel]');
		const hoursCaption = root.querySelector('[data-hours-caption]');
		const linesCaption = root.querySelector('[data-lines-caption]');
		const linesBody = root.querySelector('[data-lines-body]');
		const heatCaption = root.querySelector('[data-heat-caption]');
		const axis = root.querySelector('[data-hours-axis]');
		const bars = root.querySelector('[data-bars]');
		const hoursTable = root.querySelector('[data-hours-table]');
		const hoursDays = root.querySelector('[data-hours-days]');
		const linesAxis = root.querySelector('[data-lines-axis]');
		const linesBars = root.querySelector('[data-lines]');
		const linesTable = root.querySelector('[data-lines-table]');
		const linesDays = root.querySelector('[data-lines-days]');
		const heatmap = root.querySelector('[data-heatmap]');
		let commits = [];
		let charted = 0;
		let loadedSnapshot = null;

		void load();

		/*
		 * The snapshot is the only source: line counts cost one GitHub request per commit, so asking
		 * for them from a visitor's browser would burn an anonymous hourly allowance many times over.
		 */
		async function load() {
			try {
				const response = await fetch(snapshotUrl, { cache: 'no-cache' });
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				const snapshot = parseCommitSnapshot(await response.json());
				if (!snapshot) throw new Error(copy.generic);
				loadedSnapshot = snapshot;
				commits = snapshot.commits;
				renderAndReport();
			} catch (error) {
				setStatus(format(copy.error, { message: error?.message || copy.generic }), 'error');
			}
		}

		/*
		 * The status counts what the chart currently shows. Without a snapshot there is nothing to
		 * report and the failure message stays on screen.
		 */
		function renderAndReport() {
			render();
			if (!loadedSnapshot || !charted) return;
			setStatus(snapshotStatus(loadedSnapshot, Date.now()), loadedSnapshot.truncated ? 'info' : 'success');
		}

		function snapshotStatus(snapshot, nowMs) {
			const total = countText(charted);
			const generatedAt = Date.parse(snapshot.generatedAt);
			const loaded = Number.isFinite(generatedAt)
				? format(copy.snapshot, { total, age: formatAge(nowMs - generatedAt, locale) })
				: format(copy.snapshotPlain, { total });
			return snapshot.truncated ? `${loaded} ${copy.truncated}` : loaded;
		}

		function render() {
			const grid = buildCommitGrid(filterCommits(commits), {
				mode: 'commit',
				days: COMMIT_GRAPH_DAYS,
				endDayKey: todayKey('commit'),
			});
			const summary = summarizeGrid(grid);
			charted = grid.total;

			summaryPanel.hidden = false;
			hoursPanel.hidden = false;
			linesPanel.hidden = false;
			heatPanel.hidden = false;
			renderSummary(summary);
			renderBars(grid, summary);
			renderLines(grid, summary);
			renderHeatmap(grid);
			hoursCaption.textContent = format(copy.hoursCaption, { total: countText(grid.total), days: COMMIT_GRAPH_DAYS });
			heatCaption.textContent = copy.heatCaption;
			if (!grid.total && loadedSnapshot) setStatus(format(copy.empty, { days: COMMIT_GRAPH_DAYS }), 'info');
		}

		function renderSummary(summary) {
			setStat('total', String(summary.total), format(copy.statPerDay, { value: summary.dailyAverage.toFixed(1) }));
			setStat('days', String(summary.activeDays), format(copy.statOfDays, { days: summary.trackedDays }));
			setStat('hour', summary.busiestHourTotal ? formatHourRange(summary.busiestHour) : '–', summary.busiestHourTotal ? countText(summary.busiestHourTotal) : '');
			setStat('day', summary.busiestDayTotal ? formatDayLabel(summary.busiestDayKey, locale) : '–', summary.busiestDayTotal ? countText(summary.busiestDayTotal) : '');
			setStat('added', summary.statCommits ? formatSignedLines(summary.added, locale) : '–',
				summary.statCommits ? format(copy.statPerDay, { value: formatLineCount(Math.round(summary.dailyAddedAverage), locale) }) : '');
			setStat('removed', summary.statCommits ? formatSignedLines(-summary.removed, locale) : '–',
				summary.statCommits ? format(copy.statNet, { value: formatSignedLines(summary.net, locale) }) : '');
		}

		function setStat(name, value, note) {
			root.querySelector(`[data-stat-${name}]`).textContent = value;
			root.querySelector(`[data-stat-${name}-note]`).textContent = note;
		}

		function renderBars(grid, summary) {
			const max = grid.maxCell;
			axis.replaceChildren(...[max, Math.round(max / 2), 0].map((value) => element('span', { textContent: String(value) })));
			bars.setAttribute('aria-label', `${copy.hoursTitle}. ${format(copy.hoursAria, {
				days: COMMIT_GRAPH_DAYS,
				day: formatDayLabel(summary.peakDayKey, locale),
				range: formatHourRange(summary.peakHour),
				count: countText(summary.peakTotal),
			})}`);
			bars.replaceChildren(...grid.days.map((day) => element('div', { className: 'time-day' }, day.hours.map((count, hour) =>
				element('div', {
					className: 'time-bar',
					title: format(copy.cellTitle, { day: formatDayLabel(day.dayKey, locale), range: formatHourRange(hour), count: countText(count) }),
				}, [element('span', { className: 'time-bar-fill', style: `height: ${max ? (count / max) * 100 : 0}%` })])))));
			renderDayLabels(hoursDays, grid);
			hoursTable.replaceChildren(...grid.days.map((day) => element('tr', {}, [
				element('th', { scope: 'row', textContent: formatDayLabel(day.dayKey, locale) }),
				element('td', { textContent: String(day.total) }),
				element('td', { textContent: `${grid.total ? ((day.total / grid.total) * 100).toFixed(1) : '0.0'}%` }),
			])));
		}

		/* Anything past the clipped ceiling stops at full height and carries a break at its open end. */
		function fillProps(series, value, max) {
			const clipped = value > max;
			return {
				className: `lines-bar-fill ${series}${clipped ? ' clipped' : ''}`,
				style: `height: ${max ? Math.min(100, (value / max) * 100) : 0}%`,
			};
		}

		/* The plot is one equal-width group per day, so the label row mirrors that to stay aligned. */
		function renderDayLabels(target, grid) {
			const step = Math.max(1, Math.ceil(grid.days.length / 6));
			const newest = grid.days.length - 1;
			target.replaceChildren(...grid.days.map((day, index) => element('span', {
				className: 'time-day-label',
				textContent: (newest - index) % step === 0 ? formatDayLabel(day.dayKey, locale).replace(/^\S+\s/, '') : '',
			})));
		}

		function renderLines(grid, summary) {
			const covered = summary.statCommits > 0;
			const scale = grid.lineScale;
			linesBody.hidden = !covered;
			linesCaption.textContent = covered ? [
				format(copy.linesCaption, { added: formatLineCount(grid.added, locale), removed: formatLineCount(grid.removed, locale) }),
				summary.statMissing && format(copy.linesCoverage, { counted: formatLineCount(summary.statCommits, locale), total: formatLineCount(summary.total, locale) }),
				scale.clipped && format(copy.linesClipped, {
					ceiling: formatLineCount(scale.ceiling, locale),
					count: formatLineCount(scale.clipped, locale),
					total: formatLineCount(grid.days.length * 24, locale),
				}),
			].filter(Boolean).join(' ') : copy.linesPending;
			if (!covered) {
				linesBars.replaceChildren();
				linesDays.replaceChildren();
				linesTable.replaceChildren();
				return;
			}

			const max = scale.ceiling;
			linesAxis.replaceChildren(...[formatSignedLines(max, locale), '0', formatSignedLines(-max, locale)].map((value) => element('span', { textContent: value })));
			linesBars.setAttribute('aria-label', `${copy.linesTitle}. ${format(copy.linesAria, {
				days: COMMIT_GRAPH_DAYS,
				day: formatDayLabel(summary.peakLinesDayKey, locale),
				range: formatHourRange(summary.peakLinesHour),
				count: formatLineCount(summary.peakLinesTotal, locale),
			})}`);
			linesBars.replaceChildren(...grid.days.map((day) => element('div', { className: 'time-day' }, day.additions.map((added, hour) => {
				const removed = day.deletions[hour];
				return element('div', {
					className: 'time-bar lines-bar',
					title: format(copy.linesCellTitle, {
						day: formatDayLabel(day.dayKey, locale),
						range: formatHourRange(hour),
						added: formatLineCount(added, locale),
						removed: formatLineCount(removed, locale),
					}),
				}, [
					element('span', fillProps('added', added, max)),
					element('span', fillProps('removed', removed, max)),
				]);
			}))));
			renderDayLabels(linesDays, grid);
			linesTable.replaceChildren(...grid.days.map((day) => element('tr', {}, [
				element('th', { scope: 'row', textContent: formatDayLabel(day.dayKey, locale) }),
				element('td', { textContent: formatLineCount(day.added, locale) }),
				element('td', { textContent: formatLineCount(day.removed, locale) }),
				element('td', { textContent: formatSignedLines(day.added - day.removed, locale) }),
			])));
		}

		function renderHeatmap(grid) {
			const headerCells = [element('th', { scope: 'col', className: 'heat-corner' })];
			for (let hour = 0; hour < 24; hour += 1) {
				headerCells.push(element('th', { scope: 'col', className: 'heat-hour', textContent: hour % 3 === 0 ? formatHourLabel(hour).slice(0, 2) : '' }));
			}

			const rows = grid.days.map((day) => element('tr', { className: isWeekend(day.dayKey) ? 'heat-row weekend' : 'heat-row' }, [
				element('th', { scope: 'row', className: 'heat-day', textContent: formatDayLabel(day.dayKey, locale) }),
				...day.hours.map((count, hour) => {
					const cell = element('td', { className: 'heat-cell', title: format(copy.cellTitle, { day: formatDayLabel(day.dayKey, locale), range: formatHourRange(hour), count: countText(count) }) });
					cell.dataset.level = String(heatLevel(count, grid.heatScale));
					if (count > 0) cell.append(element('span', { className: 'visually-hidden', textContent: String(count) }));
					return cell;
				}),
			]));

			heatmap.replaceChildren(
				element('caption', { className: 'visually-hidden', textContent: format(copy.heatAria, { days: COMMIT_GRAPH_DAYS }) }),
				element('thead', {}, [element('tr', {}, headerCells)]),
				element('tbody', {}, rows),
			);
		}

		function todayKey(mode) {
			const now = new Date();
			return mode === 'viewer' ? dayKey(now.getFullYear(), now.getMonth() + 1, now.getDate()) : utcMsToDayKey(now.getTime());
		}

		function countText(count) {
			return count === 1 ? copy.countOne : format(copy.countMany, { count });
		}

		function element(tag, props = {}, children = []) {
			const node = Object.assign(document.createElement(tag), props);
			if (props.style) node.setAttribute('style', props.style);
			if (props.scope) node.setAttribute('scope', props.scope);
			node.append(...children);
			return node;
		}

		function setStatus(message, state) { status.textContent = message; status.dataset.state = state; }
		function format(template, values) { return Object.entries(values).reduce((text, [key, value]) => text.replaceAll(`{${key}}`, String(value)), String(template)); }
	}
</script>

<style>
	/*
	 * Added and removed lines sit on opposite sides of the zero line, so position already carries the
	 * distinction; these two steps only reinforce it. They are lightness-separated rather than the
	 * site's status green/red, which collapse to the same tone for red-green colour blindness.
	 */
	.commit-graph { --commit-graph-added: #4f9e57; --commit-graph-removed: #a8301f; }
	:global(:root[data-theme='dark']) .commit-graph { --commit-graph-added: #74c47f; --commit-graph-removed: #e2593f; }

	.commit-graph { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
	.commit-graph [hidden] { display: none !important; }
	/* Grid items default to min-width: auto, which would widen the page instead of scrolling the chart. */
	.commit-graph .commit-graph-wide { grid-column: 1 / -1; min-width: 0; }
	.commit-graph-caption { margin: 0 0 14px; color: var(--color-muted); font-size: 0.92rem; }
	.commit-graph-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none; }
	.commit-graph-stats li { display: grid; gap: 2px; }
	.commit-graph-stats .stat-label { color: var(--color-muted); font-size: 0.85rem; }
	.commit-graph-stats strong { font-size: 1.5rem; line-height: 1.2; }
