---
import type { Locale } from '../../i18n';
import FilePicker from './shared/FilePicker.astro';
import ToolActions from './shared/ToolActions.astro';
import ToolIntro from './shared/ToolIntro.astro';
import ToolPanel from './shared/ToolPanel.astro';
import ToolStatus from './shared/ToolStatus.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = {
	de: {
		eyebrow: 'EXIF, XMP & Containerdaten', title: 'Metadaten entfernen',
		intro: 'Entferne EXIF, XMP, Kapitel, Container-Tags und eingebettete Metadaten aus lokalen Medien.',
		privacy: 'Alles bleibt im Browser. Bilder werden neu gerendert, Audio/Video per FFmpeg ohne Metadaten remuxt.',
		source: 'Datei', choose: 'Datei auswählen', hint: 'Bilder, Audio und Video',
		settings: 'Bereinigung', preserve: 'Das erkannte Bildformat oder der erkannte Mediencontainer wird automatisch beibehalten.',
		metadata: 'MediaInfo-Metadaten', before: 'Vor der Bereinigung', after: 'Nach der Bereinigung', inspecting: 'Metadaten werden analysiert…', notYet: 'Nach der Bereinigung verfügbar.',
		scrub: 'Metadaten entfernen', clear: 'Zurücksetzen', result: 'Ergebnis', download: 'Bereinigte Datei herunterladen',
		waiting: 'Wähle eine Datei.', selected: '{name} ist bereit.', processing: 'Metadaten werden entfernt…',
		loading: 'FFmpeg WASM wird geladen…', ffmpegReady: 'FFmpeg WASM ist bereit.', progress: 'FFmpeg arbeitet… {progress}%',
		done: 'Metadaten wurden entfernt.', timeout: 'FFmpeg WASM hat nicht innerhalb von 90 Sekunden geladen.',
		error: 'Scrubbing fehlgeschlagen: {message}', generic: 'Unbekannter Fehler',
	},
	en: {
		eyebrow: 'EXIF, XMP & container data', title: 'Metadata Remover',
		intro: 'Remove EXIF, XMP, chapters, container tags, and embedded metadata from local media.',
		privacy: 'Everything stays in the browser. Images are re-rendered; audio/video is remuxed without metadata via FFmpeg.',
		source: 'File', choose: 'Choose file', hint: 'Images, audio, and video',
		settings: 'Scrubbing', preserve: 'The detected image format or media container is preserved automatically.',
		metadata: 'MediaInfo metadata', before: 'Before scrubbing', after: 'After scrubbing', inspecting: 'Analyzing metadata…', notYet: 'Available after scrubbing.',
		scrub: 'Remove metadata', clear: 'Reset', result: 'Result', download: 'Download scrubbed file',
		waiting: 'Choose a file.', selected: '{name} is ready.', processing: 'Removing metadata…',
		loading: 'Loading FFmpeg WASM…', ffmpegReady: 'FFmpeg WASM is ready.', progress: 'FFmpeg is working… {progress}%',
		done: 'Metadata removed.', timeout: 'FFmpeg WASM did not load within 90 seconds.',
		error: 'Scrubbing failed: {message}', generic: 'Unknown error',
	},
}[locale];
const copyJson = JSON.stringify(copy);
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />

<section class="section metadata-scrubber-section tool-workspace">
	<div class="container">
		<div class="metadata-scrubber" data-metadata-scrubber data-copy={copyJson}>
			<ToolPanel title={copy.source}>
				<FilePicker label={copy.choose} name={copy.choose} hint={copy.hint} accept="image/*,audio/*,video/*,.mkv,.mov,.mp4,.webm,.wav,.m4a,.mp3,.png,.jpg,.jpeg,.webp" nameAttrs={{ 'data-file-name': true }} metaAttrs={{ 'data-file-meta': true }} inputAttrs={{ 'data-file': true }} />
			</ToolPanel>
			<ToolPanel title={copy.settings}>
				<p class="preserve-note">{copy.preserve}</p>
				<ToolActions><button class="button primary" data-scrub type="button" disabled>{copy.scrub}</button><button class="button secondary" data-clear type="button">{copy.clear}</button></ToolActions>
				<ToolStatus data-status text={copy.waiting} />
			</ToolPanel>
			<ToolPanel class="metadata-panel" data-metadata-panel title={copy.metadata} hidden>
				<div class="metadata-comparison">
					<div><h3>{copy.before}</h3><pre data-metadata-before>{copy.inspecting}</pre></div>
					<div><h3>{copy.after}</h3><pre data-metadata-after>{copy.notYet}</pre></div>
				</div>
			</ToolPanel>
			<ToolPanel class="result-panel" data-result-panel title={copy.result} hidden>
				<p data-result-meta>{copy.waiting}</p>
				<a class="tool-download-link" data-download href="#" download hidden>{copy.download}</a>
			</ToolPanel>
		</div>
	</div>
</section>

<script>
	import { createFfmpegRuntime } from '../../lib/ffmpeg-runtime';
	import { baseName, fileExtension as extension } from '../../lib/tools/media-file';
	import { formatBytes, formatTemplate as format } from '../../lib/tools/format';
	import { analyzeMediaFile, loadMediaInfo } from '../../lib/tools/media-info-browser';
	import {
		buildScrubMediaArgs,
		metadataOutputProfile,
	} from '../../lib/tools/metadata-privacy-scrubber';

	for (const root of document.querySelectorAll('[data-metadata-scrubber]:not([data-bound])')) {
		root.dataset.bound = 'true';
		const copy = JSON.parse(root.dataset.copy || '{}');
		const fileInput = root.querySelector('[data-file]');
		const fileName = root.querySelector('[data-file-name]');
		const fileMeta = root.querySelector('[data-file-meta]');
		const scrubButton = root.querySelector('[data-scrub]');
		const clearButton = root.querySelector('[data-clear]');
		const status = root.querySelector('[data-status]');
		const resultMeta = root.querySelector('[data-result-meta]');
		const resultPanel = root.querySelector('[data-result-panel]');
		const metadataPanel = root.querySelector('[data-metadata-panel]');
		const metadataBefore = root.querySelector('[data-metadata-before]');
		const metadataAfter = root.querySelector('[data-metadata-after]');
		const download = root.querySelector('[data-download]');
		let outputUrl = null;
		let mediaInfo = null;
		const runtime = createFfmpegRuntime({
			timeoutMessage: copy.timeout,
			onLoading: () => setStatus(copy.loading, 'info'),
			onReady: () => setStatus(copy.ffmpegReady, 'success'),
			onProgress: (progress) => setStatus(format(copy.progress, { progress }), 'info'),
		});

		fileInput.addEventListener('change', update);
		scrubButton.addEventListener('click', () => void scrub());
		clearButton.addEventListener('click', reset);

		function update() {
			const file = fileInput.files?.[0];
			scrubButton.disabled = !file;
			if (!file) return;
			resultPanel.hidden = true;
			metadataPanel.hidden = false;
			metadataBefore.textContent = copy.inspecting;
			metadataAfter.textContent = copy.notYet;
			fileName.textContent = file.name;
			fileMeta.textContent = `${formatBytes(file.size)} · ${file.type || 'file'}`;
			setStatus(format(copy.selected, { name: file.name }), 'success');
			void inspect(file, metadataBefore);
		}

		async function scrub() {
			const file = fileInput.files?.[0];
			if (!file) return;
			setStatus(copy.processing, 'info');
			try {
				const profile = metadataOutputProfile(file);
				const blob = profile.isImage ? await scrubImage(file, profile.mimeType) : await scrubMedia(file, profile);
				if (outputUrl) URL.revokeObjectURL(outputUrl);
				outputUrl = URL.createObjectURL(blob);
				download.href = outputUrl;
				download.download = `${baseName(file.name)}-scrubbed.${profile.extension}`;
				download.hidden = false;
				resultMeta.textContent = `${download.download} · ${formatBytes(blob.size)}`;
				resultPanel.hidden = false;
				await inspect(new File([blob], download.download, { type: profile.mimeType }), metadataAfter);
				setStatus(copy.done, 'success');
			} catch (error) {
				setStatus(format(copy.error, { message: error?.message || copy.generic }), 'error');
			}
		}

		async function scrubImage(file, mimeType) {
			const url = URL.createObjectURL(file);
			try {
				const image = await loadImage(url);
				const canvas = document.createElement('canvas');
				canvas.width = image.naturalWidth;
				canvas.height = image.naturalHeight;
				canvas.getContext('2d').drawImage(image, 0, 0);
				return await canvasToBlob(canvas, mimeType, 0.92);
			} finally {
				URL.revokeObjectURL(url);
			}
		}

		async function scrubMedia(file, profile) {
			const bytes = await runtime.run(async (ffmpeg) => {
				const stamp = `${Date.now()}-${Math.random().toString(16).slice(2)}`;
				const input = `input-${stamp}${extension(file.name)}`;
				const output = `scrubbed-${stamp}.${profile.extension}`;
				await ffmpeg.writeFile(input, new Uint8Array(await file.arrayBuffer()));
				try {
					const args = buildScrubMediaArgs(input, output, profile.extension);
					const code = await ffmpeg.exec(args);
					if (code !== 0) throw new Error(`FFmpeg exited with code ${code}`);
					const result = await ffmpeg.readFile(output);
					return result instanceof Uint8Array ? result : new TextEncoder().encode(String(result));
				} finally {
					await ffmpeg.deleteFile(input).catch(() => {});
					await ffmpeg.deleteFile(output).catch(() => {});
				}
			});
			return new Blob([bytes], { type: profile.mimeType });
		}

		async function inspect(file, target) {
			try {
				mediaInfo ||= await loadMediaInfo();
				target.textContent = JSON.stringify(await analyzeMediaFile(file, mediaInfo), null, 2);
			} catch (error) {
				target.textContent = format(copy.error, { message: error?.message || copy.generic });
			}
		}

		function reset() {
			fileInput.value = ''; fileName.textContent = copy.choose; fileMeta.textContent = copy.hint; scrubButton.disabled = true;
			download.hidden = true; resultPanel.hidden = true; metadataPanel.hidden = true; resultMeta.textContent = copy.waiting; if (outputUrl) URL.revokeObjectURL(outputUrl); outputUrl = null; setStatus(copy.waiting, 'info');
		}
		function loadImage(url) { return new Promise((resolve, reject) => { const image = new Image(); image.onload = () => resolve(image); image.onerror = reject; image.src = url; }); }
		function canvasToBlob(canvas, type, quality) { return new Promise((resolve, reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error(copy.generic)), type, quality)); }
		function setStatus(message, state) { status.textContent = message; status.dataset.state = state; }
	}
</script>

<style>
	.metadata-scrubber { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
	.metadata-scrubber .result-panel, .metadata-scrubber .metadata-panel { grid-column: 1 / -1; }
	.metadata-scrubber [hidden] { display: none !important; }
	.preserve-note { margin: 0; color: var(--color-muted); }
	.metadata-comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
	.metadata-comparison h3 { margin: 0 0 8px; font-size: 1rem; }
	.metadata-comparison pre { box-sizing: border-box; max-height: 460px; margin: 0; padding: 12px; overflow: auto; border: 1px solid var(--color-line); border-radius: 6px; background: var(--color-surface-alt); white-space: pre-wrap; overflow-wrap: anywhere; }
	@media (max-width: 860px) { .metadata-scrubber, .metadata-comparison { grid-template-columns: 1fr; } }
</style>
