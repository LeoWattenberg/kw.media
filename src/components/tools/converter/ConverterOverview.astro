---
import type { Locale } from '../../../i18n';
import { toolPages } from '../../../data/tools';
import { withBase } from '../../../lib/url';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const copy = {
	de: {
		eyebrow: 'Konverter',
		title: 'Konverter-Tools',
		intro: 'Clientseitige Konverter fuer Bild-, Dokument-, Audio- und Videoformate direkt im Browser.',
		open: 'Konverter oeffnen',
	},
	en: {
		eyebrow: 'Converters',
		title: 'Converter Tools',
		intro: 'Client-side converters for image, document, audio, and video formats right in the browser.',
		open: 'Open converter',
	},
}[locale];

const converters = toolPages
	.filter((tool) => tool.locale === locale)
	.filter((tool) => tool.path.startsWith(`/${locale}/tools/converter/`) && tool.path !== `/${locale}/tools/converter/`)
	.sort((first, second) => first.title.localeCompare(second.title));
---

<section class="converter-hero">
	<div class="container">
		<p class="eyebrow">{copy.eyebrow}</p>
		<h1>{copy.title}</h1>
		<p>{copy.intro}</p>
	</div>
</section>

<section class="section converter-index-section">
	<div class="container converter-grid">
		{
			converters.map((tool) => (
				<a class="converter-card" href={withBase(tool.path)}>
					<span>{copy.open}</span>
					<h2>{tool.title}</h2>
					<p>{tool.description}</p>
				</a>
			))
		}
	</div>
</section>

<style>
	.converter-hero {
		padding-block: clamp(42px, 7vw, 82px);
		background: var(--color-surface-alt);
		border-bottom: 1px solid var(--color-line);
	}

	.converter-hero h1 {
		max-width: 780px;
		margin: 0;
		font-size: clamp(2.6rem, 7vw, 5.6rem);
		line-height: 0.96;
		letter-spacing: 0;
	}

	.converter-hero p:not(.eyebrow) {
		max-width: 720px;
		margin: 18px 0 0;
		color: var(--color-muted);
		font-size: 1.08rem;
	}

	.converter-index-section {
		background: var(--color-surface-raised);
	}

	.converter-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 16px;
	}

	.converter-card {
		display: grid;
		gap: 12px;
		padding: clamp(18px, 3vw, 28px);
		color: inherit;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-line);
		border-radius: 8px;
		text-decoration: none;
	}

	.converter-card:hover {
		background: var(--color-surface-alt);
		border-color: var(--color-accent);
	}

	.converter-card span {
		color: var(--color-accent-dark);
		font-size: 0.78rem;
		font-weight: 850;
		text-transform: uppercase;
	}

	.converter-card h2 {
		margin: 0;
		color: var(--color-ink);
		font-size: clamp(1.35rem, 3vw, 2rem);
		line-height: 1.1;
		letter-spacing: 0;
	}

	.converter-card p {
		margin: 0;
		color: var(--color-muted);
		font-weight: 700;
	}
</style>
