---
import type { Locale } from '../../../i18n';
import FilePicker from '../shared/FilePicker.astro';
import RangeControl from '../shared/RangeControl.astro';
import SelectControl from '../shared/SelectControl.astro';
import ToolIntro from '../shared/ToolIntro.astro';
import ToolPanel from '../shared/ToolPanel.astro';
import ToolStatus from '../shared/ToolStatus.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const outputFormats = [
	{ value: 'PNG', label: 'PNG', extension: 'png', mime: 'image/png', quality: false },
	{ value: 'JPEG', label: 'JPEG', extension: 'jpg', mime: 'image/jpeg', quality: true },
	{ value: 'WEBP', label: 'WebP', extension: 'webp', mime: 'image/webp', quality: true },
	{ value: 'AVIF', label: 'AVIF', extension: 'avif', mime: 'image/avif', quality: true },
	{ value: 'GIF', label: 'GIF', extension: 'gif', mime: 'image/gif', quality: false },
	{ value: 'TIFF', label: 'TIFF', extension: 'tiff', mime: 'image/tiff', quality: false },
	{ value: 'BMP', label: 'BMP', extension: 'bmp', mime: 'image/bmp', quality: false },
	{ value: 'ICO', label: 'ICO', extension: 'ico', mime: 'image/x-icon', quality: false },
];

const copyByLocale = {
	de: {
		eyebrow: 'Bild-Tool',
		title: 'Bildformat-Konverter',
		intro: 'Konvertiere lokale Bilder direkt im Browser mit ImageMagick WASM. Standardausgabe ist PNG.',
		privacy: 'Deine Datei wird nicht hochgeladen. Die Konvertierung läuft clientseitig in deinem Browser.',
		fileTitle: 'Quelldatei',
		chooseFile: 'Bilddatei wählen',
		fileHint: 'PNG, JPEG, WebP, AVIF, GIF, TIFF, BMP, ICO, SVG, HEIC und mehr',
		settingsTitle: 'Ausgabe',
		outputFormat: 'Zielformat',
		quality: 'Qualität',
		convert: 'Bild konvertieren',
		clear: 'Datei entfernen',
		resultTitle: 'Konvertiertes Bild',
		sourcePreview: 'Quelle',
		outputPreview: 'Ausgabe',
		download: 'Konvertiertes Bild herunterladen',
		client: {
			chooseFile: 'Bilddatei wählen',
			converted: '{name} wurde als {format} erzeugt.',
			converting: 'Konvertiere zu {format}...',
			fileHint: 'PNG, JPEG, WebP, AVIF, GIF, TIFF, BMP, ICO, SVG, HEIC und mehr',
			fileMeta: '{size} | {type}',
			fileReady: '{name} ist ausgewählt ({size}).',
			imageMeta: '{width} x {height}px | {frames} | {size}',
			loadingMagick: 'ImageMagick WASM wird geladen...',
			magickReady: '{version} ist bereit.',
			magickTimeout: 'ImageMagick WASM hat nicht innerhalb von 90 Sekunden geladen. Prüfe deine Verbindung und versuche es erneut.',
			noFile: 'Wähle zuerst eine Bilddatei.',
			noFrames: 'ImageMagick konnte kein Bild in dieser Datei finden.',
			previewUnavailable: 'Für dieses Format ist keine Browser-Vorschau verfügbar. Der Download ist trotzdem bereit.',
			reset: 'Die Datei wurde entfernt.',
			sourcePreviewUnavailable: 'Die Browser-Vorschau kann dieses Quellformat nicht anzeigen. Die Konvertierung kann trotzdem funktionieren.',
			singleFrame: '1 Frame',
			multipleFrames: '{count} Frames',
			unknownError: 'Unbekannter Fehler',
			waiting: 'Wähle ein Bild und konvertiere es in ein neues Format.',
		},
	},
	en: {
		eyebrow: 'Image tool',
		title: 'Image Format Converter',
		intro: 'Convert local images directly in your browser with ImageMagick WASM. The default output is PNG.',
		privacy: 'Your file is not uploaded. Conversion runs client-side in your browser.',
		fileTitle: 'Source file',
		chooseFile: 'Choose image file',
		fileHint: 'PNG, JPEG, WebP, AVIF, GIF, TIFF, BMP, ICO, SVG, HEIC and more',
		settingsTitle: 'Output',
		outputFormat: 'Target format',
		quality: 'Quality',
		convert: 'Convert image',
		clear: 'Clear file',
		resultTitle: 'Converted image',
		sourcePreview: 'Source',
		outputPreview: 'Output',
		download: 'Download converted image',
		client: {
			chooseFile: 'Choose image file',
			converted: '{name} was created as {format}.',
			converting: 'Converting to {format}...',
			fileHint: 'PNG, JPEG, WebP, AVIF, GIF, TIFF, BMP, ICO, SVG, HEIC and more',
			fileMeta: '{size} | {type}',
			fileReady: '{name} is selected ({size}).',
			imageMeta: '{width} x {height}px | {frames} | {size}',
			loadingMagick: 'Loading ImageMagick WASM...',
			magickReady: '{version} is ready.',
			magickTimeout: 'ImageMagick WASM did not finish loading within 90 seconds. Check your connection and try again.',
			noFile: 'Choose an image file first.',
			noFrames: 'ImageMagick could not find an image in this file.',
			previewUnavailable: 'This format cannot be previewed by the browser. The download is ready.',
			reset: 'The file has been cleared.',
			sourcePreviewUnavailable: 'The browser cannot preview this source format. Conversion may still work.',
			singleFrame: '1 frame',
			multipleFrames: '{count} frames',
			unknownError: 'Unknown error',
			waiting: 'Choose an image and convert it into a new format.',
		},
	},
} satisfies Record<Locale, Record<string, unknown> & { client: Record<string, string> }>;

const copy = copyByLocale[locale];
const copyJson = JSON.stringify(copy.client);
const outputFormatsJson = JSON.stringify(outputFormats);
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />

<section class="section image-converter-section tool-workspace">
	<div class="container">
		<div class="image-converter" data-image-converter data-copy={copyJson} data-formats={outputFormatsJson}>
			<div class="converter-grid">
				<ToolPanel class="converter-panel source-panel" title={copy.fileTitle}>
					<FilePicker
						label={copy.fileTitle}
						name={copy.chooseFile}
						hint={copy.fileHint}
						accept="image/*,.avif,.bmp,.gif,.heic,.heif,.ico,.jpeg,.jpg,.png,.psd,.svg,.tif,.tiff,.webp"
						nameAttrs={{ 'data-file-name': true }}
						metaAttrs={{ 'data-file-meta': true }}
						inputAttrs={{ 'data-file': true }}
					/>
					<div class="preview-card" data-source-preview hidden>
						<p>{copy.sourcePreview}</p>
						<div class="preview-frame">
							<img data-source-image alt="" />
							<span data-source-preview-note hidden>{copy.client.sourcePreviewUnavailable}</span>
						</div>
						<small data-source-meta></small>
					</div>
				</ToolPanel>

				<ToolPanel class="converter-panel settings-panel" title={copy.settingsTitle}>
					<SelectControl label={copy.outputFormat} selectAttrs={{ 'data-format': true }}>
						{
							outputFormats.map((format) => (
								<option value={format.value} selected={format.value === 'PNG'}>
									{format.label}
								</option>
							))
						}
					</SelectControl>
					<RangeControl
						data-quality-control
						hidden
						label={copy.quality}
						value="90"
						valueAttrs={{ 'data-quality-label': true }}
						inputAttrs={{ 'data-quality': true, min: 1, max: 100, step: 1, value: 90 }}
					/>
					<div class="converter-actions">
						<button class="button primary" data-convert type="button" disabled>{copy.convert}</button>
						<button class="button secondary" data-clear type="button">{copy.clear}</button>
					</div>
					<ToolStatus class="converter-status" data-status role="status" text={copy.client.waiting} />
				</ToolPanel>
			</div>

			<ToolPanel class="converter-panel result-panel" data-result hidden>
				<div class="result-heading">
					<div>
						<p class="eyebrow">{copy.outputPreview}</p>
						<h2>{copy.resultTitle}</h2>
					</div>
					<a class="button primary" data-download href="#" download hidden>{copy.download}</a>
				</div>
				<div class="result-preview">
					<div class="preview-frame output-frame">
						<img data-output-image alt="" />
						<span data-output-preview-note hidden>{copy.client.previewUnavailable}</span>
					</div>
					<dl class="result-meta">
						<div>
							<dt>{copy.outputFormat}</dt>
							<dd data-output-format></dd>
						</div>
						<div>
							<dt>{copy.resultTitle}</dt>
							<dd data-output-meta></dd>
						</div>
					</dl>
				</div>
			</ToolPanel>
		</div>
	</div>
</section>

<script>
	import { createOutputName, fileExtension, formatFrames } from '../../../lib/tools/image-format-converter';
	import { formatBytes, formatTemplate as format } from '../../../lib/tools/format';

	(() => {
		const roots = document.querySelectorAll('[data-image-converter]:not([data-image-converter-bound])');

		for (const root of roots) {
			root.dataset.imageConverterBound = 'true';
			initImageFormatConverter(root);
		}

		function initImageFormatConverter(root) {
			const copy = JSON.parse(root.dataset.copy || '{}');
			const outputFormats = JSON.parse(root.dataset.formats || '[]');
			const fileInput = root.querySelector('[data-file]');
			const fileName = root.querySelector('[data-file-name]');
			const fileMeta = root.querySelector('[data-file-meta]');
			const formatSelect = root.querySelector('[data-format]');
			const qualityControl = root.querySelector('[data-quality-control]');
			const qualityInput = root.querySelector('[data-quality]');
			const qualityLabel = root.querySelector('[data-quality-label]');
			const convertButton = root.querySelector('[data-convert]');
			const clearButton = root.querySelector('[data-clear]');
			const status = root.querySelector('[data-status]');
			const sourcePreview = root.querySelector('[data-source-preview]');
			const sourceImage = root.querySelector('[data-source-image]');
			const sourcePreviewNote = root.querySelector('[data-source-preview-note]');
			const sourceMeta = root.querySelector('[data-source-meta]');
			const result = root.querySelector('[data-result]');
			const outputImage = root.querySelector('[data-output-image]');
			const outputPreviewNote = root.querySelector('[data-output-preview-note]');
			const outputFormat = root.querySelector('[data-output-format]');
			const outputMeta = root.querySelector('[data-output-meta]');
			const downloadLink = root.querySelector('[data-download]');

			if (
				!fileInput || !fileName || !fileMeta || !formatSelect || !qualityControl || !qualityInput ||
				!qualityLabel || !convertButton || !clearButton || !status || !sourcePreview || !sourceImage ||
				!sourcePreviewNote || !sourceMeta || !result || !outputImage || !outputPreviewNote ||
				!outputFormat || !outputMeta || !downloadLink
			) {
				return;
			}

			const state = {
				file: null,
				inputUrl: null,
				outputUrl: null,
				isWorking: false,
				magick: null,
				magickPromise: null,
			};

			fileInput.addEventListener('change', () => {
				setSourceFile(fileInput.files && fileInput.files[0] ? fileInput.files[0] : null);
			});

			formatSelect.addEventListener('change', updateQualityControl);
			qualityInput.addEventListener('input', () => {
				qualityLabel.textContent = qualityInput.value;
			});
			convertButton.addEventListener('click', () => {
				void convertFile();
			});
			clearButton.addEventListener('click', clearFile);
			sourceImage.addEventListener('load', () => {
				sourceImage.hidden = false;
				sourcePreviewNote.hidden = true;
			});
			sourceImage.addEventListener('error', () => {
				sourceImage.hidden = true;
				sourcePreviewNote.hidden = false;
			});
			outputImage.addEventListener('load', () => {
				outputImage.hidden = false;
				outputPreviewNote.hidden = true;
			});
			outputImage.addEventListener('error', () => {
				outputImage.hidden = true;
				outputPreviewNote.hidden = false;
			});

			updateQualityControl();
			updateReadyState();

			function setSourceFile(file) {
				revokeUrl('inputUrl');
				resetOutput();
				state.file = file;

				if (!file) {
					fileName.textContent = copy.chooseFile || 'Choose image file';
					fileMeta.textContent = copy.fileHint || '';
					sourcePreview.hidden = true;
					sourceImage.removeAttribute('src');
					sourceMeta.textContent = '';
					setStatus(copy.waiting, 'info');
					updateReadyState();
					return;
				}

				state.inputUrl = URL.createObjectURL(file);
				fileName.textContent = file.name;
				fileMeta.textContent = format(copy.fileMeta, {
					size: formatBytes(file.size),
					type: file.type || fileExtension(file.name).slice(1).toUpperCase(),
				});
				sourceImage.hidden = false;
				sourcePreviewNote.hidden = true;
				sourceImage.src = state.inputUrl;
				sourcePreview.hidden = false;
				sourceMeta.textContent = format(copy.fileReady, {
					name: file.name,
					size: formatBytes(file.size),
				});
				setStatus(sourceMeta.textContent, 'success');
				updateReadyState();
			}

			async function convertFile() {
				if (!state.file) {
					setStatus(copy.noFile, 'error');
					return;
				}

				const selectedFormat = getSelectedFormat();
				const outputName = createOutputName(state.file.name, selectedFormat.extension);

				setWorking(true);
				resetOutput();

				try {
					const { ImageMagick, Magick } = await loadMagick();
					setStatus(format(copy.converting, { format: selectedFormat.label }), 'info');

					const inputBytes = new Uint8Array(await state.file.arrayBuffer());
					const conversion = convertWithMagick(ImageMagick, inputBytes, selectedFormat, Number(qualityInput.value));
					const outputBlob = new Blob([conversion.bytes], { type: selectedFormat.mime });

					state.outputUrl = URL.createObjectURL(outputBlob);
					outputImage.hidden = false;
					outputPreviewNote.hidden = true;
					outputImage.src = state.outputUrl;
					outputFormat.textContent = selectedFormat.label;
					outputMeta.textContent = format(copy.imageMeta, {
						width: conversion.width || '?',
						height: conversion.height || '?',
						frames: formatFrames(conversion.frames, copy),
						size: formatBytes(outputBlob.size),
					});
					downloadLink.href = state.outputUrl;
					downloadLink.download = outputName;
					downloadLink.hidden = false;
					result.hidden = false;
					setStatus(format(copy.converted, { name: outputName, format: selectedFormat.label }), 'success');

					if (Magick && Magick.imageMagickVersion) {
						root.dataset.magickVersion = Magick.imageMagickVersion;
					}
				} catch (error) {
					setStatus(messageFromError(error), 'error');
					resetOutput();
				} finally {
					setWorking(false);
				}
			}

			function convertWithMagick(ImageMagick, inputBytes, selectedFormat, quality) {
				let metadata = {
					width: 0,
					height: 0,
					frames: 0,
				};

				const bytes = ImageMagick.readCollection(inputBytes, (images) => {
					if (!images.length) {
						throw new Error(copy.noFrames);
					}

					metadata = {
						width: images[0].width,
						height: images[0].height,
						frames: images.length,
					};

					if (selectedFormat.quality) {
						for (const image of images) {
							image.quality = quality;
						}
					}

					return images.write(selectedFormat.value, (data) => new Uint8Array(data));
				});

				return {
					bytes,
					...metadata,
				};
			}

			async function loadMagick() {
				if (state.magick) {
					return state.magick;
				}

				if (state.magickPromise) {
					return state.magickPromise;
				}

				state.magickPromise = (async () => {
					setStatus(copy.loadingMagick, 'info');

					const magickVersion = '0.0.41';
					const moduleUrl = `https://cdn.jsdelivr.net/npm/@imagemagick/magick-wasm@${magickVersion}/+esm`;
					const wasmUrl = `https://cdn.jsdelivr.net/npm/@imagemagick/magick-wasm@${magickVersion}/dist/magick.wasm`;
					const magick = await import(/* @vite-ignore */ moduleUrl);

					await withTimeout(
						magick.initializeImageMagick(new URL(wasmUrl)),
						90000,
						copy.magickTimeout,
					);

					state.magick = magick;
					setStatus(format(copy.magickReady, {
						version: magick.Magick && magick.Magick.imageMagickVersion
							? magick.Magick.imageMagickVersion
							: 'ImageMagick WASM',
					}), 'success');

					return magick;
				})().catch((error) => {
					state.magickPromise = null;
					throw error;
				});

				return state.magickPromise;
			}

			function updateQualityControl() {
				const selectedFormat = getSelectedFormat();
				qualityControl.hidden = !selectedFormat.quality;
				qualityLabel.textContent = qualityInput.value;
			}

			function getSelectedFormat() {
				return outputFormats.find((formatOption) => formatOption.value === formatSelect.value) || outputFormats[0];
			}

			function updateReadyState() {
				convertButton.disabled = state.isWorking || !state.file;
				clearButton.disabled = state.isWorking || !state.file;
				formatSelect.disabled = state.isWorking;
				qualityInput.disabled = state.isWorking;
				fileInput.disabled = state.isWorking;
			}

			function setWorking(isWorking) {
				state.isWorking = isWorking;
				updateReadyState();
			}

			function resetOutput() {
				revokeUrl('outputUrl');
				result.hidden = true;
				downloadLink.hidden = true;
				downloadLink.removeAttribute('href');
				outputImage.removeAttribute('src');
				outputImage.hidden = false;
				outputPreviewNote.hidden = true;
				outputFormat.textContent = '';
				outputMeta.textContent = '';
			}

			function clearFile() {
				state.file = null;
				fileInput.value = '';
				revokeUrl('inputUrl');
				resetOutput();
				sourcePreview.hidden = true;
				sourceImage.removeAttribute('src');
				sourceImage.hidden = false;
				sourcePreviewNote.hidden = true;
				sourceMeta.textContent = '';
				fileName.textContent = copy.chooseFile || 'Choose image file';
				fileMeta.textContent = copy.fileHint || '';
				setStatus(copy.reset, 'info');
				updateReadyState();
			}

			function revokeUrl(key) {
				if (state[key]) {
					URL.revokeObjectURL(state[key]);
					state[key] = null;
				}
			}

			function setStatus(message, type) {
				status.textContent = message;
				status.dataset.state = type;
			}

			function messageFromError(error) {
				if (typeof error === 'string') {
					return error;
				}

				return error && typeof error === 'object' && 'message' in error
					? String(error.message)
					: copy.unknownError;
			}

			function withTimeout(promise, timeoutMs, message) {
				let timeoutId;
				const timeout = new Promise((_resolve, reject) => {
					timeoutId = window.setTimeout(() => reject(new Error(message)), timeoutMs);
				});

				return Promise.race([promise, timeout]).finally(() => {
					window.clearTimeout(timeoutId);
				});
			}
		}
	})();
</script>

<style>
	.image-converter,
	.converter-grid,
	.result-preview {
		display: grid;
		gap: 18px;
	}

	.image-converter [hidden] {
		display: none !important;
	}

	.converter-grid {
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.42fr);
		align-items: start;
	}

	.file-picker {
		min-height: 160px;
		margin-top: 18px;
	}

	.file-picker span,
	.select-control span,
	.range-control span,
	.preview-card p,
	.result-meta dt {
		color: var(--color-accent-dark);
		font-size: 0.78rem;
		font-weight: 850;
		text-transform: uppercase;
	}

	.file-picker small,
	.preview-card small {
		color: var(--color-muted);
		font-size: 0.88rem;
	}

	.converter-actions,
	.result-heading {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		align-items: center;
		justify-content: space-between;
		margin-top: 20px;
	}

	.preview-card {
		display: grid;
		gap: 10px;
		margin-top: 18px;
	}

	.preview-card p,
	.result-heading .eyebrow {
		margin: 0;
	}

	.preview-frame {
		display: grid;
		overflow: hidden;
		min-height: 260px;
		place-items: center;
		padding: 12px;
		background:
			linear-gradient(45deg, var(--color-checkerboard-square) 25%, var(--color-transparent) 25%),
			linear-gradient(-45deg, var(--color-checkerboard-square) 25%, var(--color-transparent) 25%),
			linear-gradient(45deg, var(--color-transparent) 75%, var(--color-checkerboard-square) 75%),
			linear-gradient(-45deg, var(--color-transparent) 75%, var(--color-checkerboard-square) 75%);
		background-color: var(--color-checkerboard-background);
		background-position: 0 0, 0 10px, 10px -10px, -10px 0;
		background-size: 20px 20px;
		border: 1px solid var(--color-line);
		border-radius: 8px;
	}

	.preview-frame img {
		display: block;
		max-width: 100%;
		max-height: 420px;
		object-fit: contain;
	}

	.preview-frame span {
		max-width: 42ch;
		color: var(--color-muted);
		font-weight: 700;
		text-align: center;
	}

	.result-panel {
		margin-top: 18px;
	}

	.result-heading {
		margin-top: 0;
	}

	.result-heading h2 {
		margin-top: 4px;
	}

	.result-preview {
		grid-template-columns: minmax(0, 1fr) minmax(240px, 0.35fr);
		margin-top: 18px;
		align-items: start;
	}

	.output-frame {
		min-height: 360px;
	}

	.result-meta {
		display: grid;
		gap: 12px;
		margin: 0;
	}

	.result-meta div {
		padding: 14px;
		background: var(--color-surface-alt);
		border: 1px solid var(--color-line);
		border-radius: 8px;
	}

	.result-meta dt,
	.result-meta dd {
		margin: 0;
	}

	.result-meta dd {
		margin-top: 6px;
		overflow-wrap: anywhere;
		color: var(--color-ink);
		font-weight: 800;
	}

	@media (max-width: 860px) {
		.converter-grid,
		.result-preview {
			grid-template-columns: 1fr;
		}
	}
</style>
