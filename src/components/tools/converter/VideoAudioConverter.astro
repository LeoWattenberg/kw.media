---
import type { Locale } from '../../../i18n';
import FilePicker from '../shared/FilePicker.astro';
import SelectControl from '../shared/SelectControl.astro';
import ToolActions from '../shared/ToolActions.astro';
import ToolIntro from '../shared/ToolIntro.astro';
import ToolPanel from '../shared/ToolPanel.astro';
import ToolResultCard from '../shared/ToolResultCard.astro';
import ToolStatus from '../shared/ToolStatus.astro';

interface Props {
	locale: Locale;
	defaultProfile?: string;
	title?: string;
	eyebrow?: string;
}

const { locale, defaultProfile = '', title, eyebrow } = Astro.props;

const profileDefinitions = [
	{ value: 'wav', label: 'WAV', extension: '.wav', mimeType: 'audio/wav', kind: 'audio', codec: 'pcm_s16le', args: ['-ar', '48000'] },
	{ value: 'mp3', label: 'MP3', extension: '.mp3', mimeType: 'audio/mpeg', kind: 'audio', codec: 'libmp3lame', args: ['-b:a', '192k'] },
	{ value: 'ogg', label: 'OGG', extension: '.ogg', mimeType: 'audio/ogg', kind: 'audio', codec: 'libopus', args: ['-b:a', '192k', '-ar', '48000'] },
	{ value: 'm4a', label: 'M4A', extension: '.m4a', mimeType: 'audio/mp4', kind: 'audio', codec: 'aac', args: ['-b:a', '192k'] },
	{ value: 'flac', label: 'FLAC', extension: '.flac', mimeType: 'audio/flac', kind: 'audio', codec: 'flac', args: ['-ar', '48000'] },
	{ value: 'mp4', label: 'MP4', extension: '.mp4', mimeType: 'video/mp4', kind: 'video', codec: 'copy', audioCodec: 'aac', audioArgs: ['-b:a', '192k'] },
	{ value: 'webm', label: 'WebM', extension: '.webm', mimeType: 'video/webm', kind: 'video', codec: 'copy', audioCodec: 'libopus', audioArgs: ['-b:a', '192k', '-ar', '48000'] },
	{ value: 'mov', label: 'MOV', extension: '.mov', mimeType: 'video/quicktime', kind: 'video', codec: 'copy', audioCodec: 'aac', audioArgs: ['-b:a', '192k'] },
];

const copyByLocale = {
	de: {
		eyebrow: 'Audio- & Video-Tool',
		title: 'Audio- und Video-Konverter',
		intro: 'Konvertiere lokale Audiodateien oder Videos direkt im Browser mit FFmpeg wasm. Die Verarbeitung bleibt vollständig lokal.',
		privacy: 'Deine Datei wird nicht hochgeladen. Die Konvertierung läuft clientseitig in deinem Browser.',
		fileLabel: 'Datei wählen',
		chooseFile: 'Datei auswählen',
		fileHint: 'Beliebige Datei, die FFmpeg lesen kann',
		profileLabel: 'Zielformat',
		profilePlaceholder: 'Bitte Datei auswählen',
		process: 'Konvertieren',
		clear: 'Zurücksetzen',
		download: 'Konvertierte Datei herunterladen',
		statusWaiting: 'Wähle eine Audiodatei oder ein Video aus, um zu starten.',
		statusPreparing: 'Datei wird vorbereitet…',
		statusProcessing: 'Konvertierung läuft…',
		statusReady: 'Die Datei wurde erfolgreich konvertiert.',
		statusError: 'Konvertierung fehlgeschlagen: {message}',
		statusFfmpegLoading: 'FFmpeg wasm wird geladen…',
		statusFfmpegProgress: 'FFmpeg arbeitet… {progress}%',
		statusFfmpegReady: 'FFmpeg wasm ist bereit.',
		statusFfmpegTimeout: 'FFmpeg wasm hat nicht innerhalb von 90 Sekunden geladen.',
		statusGeneric: 'Unbekannter Fehler',
		selectedFile: 'Ausgewählte Datei: {name}',
		selectedMeta: '{size} · {type}',
		outputTitle: 'Ergebnis',
		outputHelp: 'Die Ausgabe wird in einem passenden Container erzeugt und direkt heruntergeladen.',
		showSource: 'Original anzeigen',
		showOutput: 'Konvertierte Datei anzeigen',
	},
	en: {
		eyebrow: 'Audio & video tool',
		title: 'Audio and Video Converter',
		intro: 'Convert local audio files or videos directly in your browser with FFmpeg wasm. Everything stays local.',
		privacy: 'Your file is not uploaded. Conversion runs client-side in your browser.',
		fileLabel: 'Choose file',
		chooseFile: 'Select a file',
		fileHint: 'Any file that FFmpeg can read',
		profileLabel: 'Target format',
		profilePlaceholder: 'Choose a file first',
		process: 'Convert',
		clear: 'Reset',
		download: 'Download converted file',
		statusWaiting: 'Choose an audio file or video to start.',
		statusPreparing: 'Preparing file…',
		statusProcessing: 'Conversion in progress…',
		statusReady: 'The file was converted successfully.',
		statusError: 'Conversion failed: {message}',
		statusFfmpegLoading: 'Loading FFmpeg wasm…',
		statusFfmpegProgress: 'FFmpeg is working… {progress}%',
		statusFfmpegReady: 'FFmpeg wasm is ready.',
		statusFfmpegTimeout: 'FFmpeg wasm did not finish loading within 90 seconds.',
		statusGeneric: 'Unknown error',
		selectedFile: 'Selected file: {name}',
		selectedMeta: '{size} · {type}',
		outputTitle: 'Result',
		outputHelp: 'The output is generated in a matching container and downloaded right away.',
		showSource: 'Show original',
		showOutput: 'Show converted file',
	},
} satisfies Record<Locale, Record<string, string>>;

const defaultCopy = copyByLocale[locale];
const copy = {
	...defaultCopy,
	title: title || defaultCopy.title,
	eyebrow: eyebrow || defaultCopy.eyebrow,
};
const copyJson = JSON.stringify(copy);
const profilesJson = JSON.stringify(profileDefinitions);
const normalizedDefaultProfile = profileDefinitions.some((profile) => profile.value === defaultProfile) ? defaultProfile : '';
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />

<section class="section converter-section tool-workspace">
	<div class="container">
		<div class="converter-tool" data-video-audio-converter data-copy={copyJson} data-profiles={profilesJson} data-default-profile={normalizedDefaultProfile}>
			<div class="converter-workspace">
				<ToolPanel class="converter-panel converter-stage" title={copy.fileLabel}>
					<FilePicker
						label={copy.chooseFile}
						name={copy.chooseFile}
						hint={copy.fileHint}
						accept="*/*"
						nameAttrs={{ 'data-file-name': true }}
						metaAttrs={{ 'data-file-meta': true }}
						inputAttrs={{ 'data-file-input': true }}
					/>
					<div class="media-preview" data-media-preview hidden>
						<div class="media-preview-frame">
							<video data-source-video controls playsinline hidden></video>
							<audio data-source-audio controls hidden></audio>
							<video data-output-video controls playsinline hidden></video>
							<audio data-output-audio controls hidden></audio>
						</div>
					</div>
					<div class="converter-output" data-converter-output hidden>
						<ToolResultCard
							title={copy.selectedFile.replace('{name}', copy.chooseFile)}
							meta={copy.selectedMeta.replace('{size}', '—').replace('{type}', '—')}
							downloadLabel={copy.download}
							titleAttrs={{ 'data-result-title': true }}
							metaAttrs={{ 'data-result-meta': true }}
							downloadAttrs={{ 'data-download': true }}
						/>
					</div>
				</ToolPanel>

				<details class="converter-toolbar" open>
					<summary>{copy.profileLabel}</summary>
					<ToolPanel class="converter-panel" title={copy.profileLabel}>
						<SelectControl label={copy.profileLabel} selectAttrs={{ 'data-profile-select': true, disabled: true }}>
							<option value="">{copy.profilePlaceholder}</option>
						</SelectControl>
						<ToolActions>
							<button class="button primary" data-process type="button" disabled>{copy.process}</button>
							<button class="button secondary" data-clear type="button">{copy.clear}</button>
							<button class="button secondary" data-preview-toggle type="button" hidden>{copy.showOutput}</button>
						</ToolActions>
						<ToolStatus data-status text={copy.statusWaiting} />
					</ToolPanel>
				</details>
			</div>
		</div>
	</div>
</section>

<script>
	import { createFfmpegRuntime } from '../../../lib/ffmpeg-runtime';
	import { formatBytes, formatTemplate as format } from '../../../lib/tools/format';
	import {
		buildConversionArgs,
		buildOutputName,
		detectMediaKind,
		filterProfilesForMediaKind,
		inputExtension,
	} from '../../../lib/tools/video-audio-converter';

	(() => {
		const roots = document.querySelectorAll('[data-video-audio-converter]:not([data-video-audio-bound])');

		for (const root of roots) {
			root.dataset.videoAudioBound = 'true';
			initVideoAudioConverter(root);
		}

		function initVideoAudioConverter(root) {
			const copy = JSON.parse(root.dataset.copy || '{}');
			const profileDefinitions = JSON.parse(root.dataset.profiles || '[]');
			const fileInput = root.querySelector('[data-file-input]');
			const fileName = root.querySelector('[data-file-name]');
			const fileMeta = root.querySelector('[data-file-meta]');
			const profileSelect = root.querySelector('[data-profile-select]');
			const processButton = root.querySelector('[data-process]');
			const clearButton = root.querySelector('[data-clear]');
			const status = root.querySelector('[data-status]');
			const resultTitle = root.querySelector('[data-result-title]');
			const resultMeta = root.querySelector('[data-result-meta]');
			const downloadLink = root.querySelector('[data-download]');
			const converterOutput = root.querySelector('[data-converter-output]');
			const mediaPreview = root.querySelector('[data-media-preview]');
			const previewToggle = root.querySelector('[data-preview-toggle]');
			const sourceVideo = root.querySelector('[data-source-video]');
			const sourceAudio = root.querySelector('[data-source-audio]');
			const outputVideo = root.querySelector('[data-output-video]');
			const outputAudio = root.querySelector('[data-output-audio]');

			const state = {
				selectedFile: null,
				inputUrl: null,
				downloadUrl: null,
				outputKind: null,
			};
			const ffmpegRuntime = createFfmpegRuntime({
				timeoutMessage: copy.statusFfmpegTimeout,
				onLoading: () => setStatus(copy.statusFfmpegLoading, 'info'),
				onReady: () => setStatus(copy.statusFfmpegReady, 'success'),
				onProgress: (progress) => {
					setStatus(format(copy.statusFfmpegProgress, { progress }), 'info');
				},
			});

			fileInput.addEventListener('change', () => {
				void selectFile(fileInput.files && fileInput.files[0] ? fileInput.files[0] : null);
			});
			profileSelect.addEventListener('change', () => {
				updateSelectionUi();
			});
			processButton.addEventListener('click', () => {
				void convertFile();
			});
			clearButton.addEventListener('click', resetTool);
			previewToggle.addEventListener('click', () => {
				const showingOutput = Boolean(state.downloadUrl && (!outputVideo.hidden || !outputAudio.hidden));
				showMediaPreview(showingOutput ? 'source' : 'output');
			});

			function selectFile(file) {
				clearOutput();
				if (state.inputUrl) {
					URL.revokeObjectURL(state.inputUrl);
					state.inputUrl = null;
				}
				state.selectedFile = file || null;
				if (state.selectedFile) {
					state.inputUrl = URL.createObjectURL(state.selectedFile);
					showMediaPreview('source');
				} else {
					mediaPreview.hidden = true;
				}
				populateProfileOptions();
				updateSelectionUi();
				processButton.disabled = !state.selectedFile || !profileSelect.value;

				if (!file) {
					setStatus(copy.statusWaiting, 'info');
					return;
				}

				setStatus(copy.statusPreparing, 'info');
			}

			async function convertFile() {
				if (!state.selectedFile || !profileSelect.value) {
					return;
				}

				processButton.disabled = true;
				setStatus(copy.statusProcessing, 'info');

				try {
					const outputProfile = getSelectedProfile();
					const output = await convertFileWithFfmpeg(state.selectedFile, outputProfile);
					const blob = new Blob([output], { type: outputProfile.mimeType });
					const url = URL.createObjectURL(blob);

					if (state.downloadUrl) {
						URL.revokeObjectURL(state.downloadUrl);
					}

					state.downloadUrl = url;
					state.outputKind = outputProfile.kind;
					downloadLink.href = url;
					downloadLink.download = buildOutputName(state.selectedFile.name, outputProfile.extension);
					downloadLink.hidden = false;
					downloadLink.textContent = copy.download;
					resultTitle.textContent = format(copy.selectedFile, { name: state.selectedFile.name });
					resultMeta.textContent = format(copy.selectedMeta, {
						size: formatBytes(blob.size),
						type: outputProfile.label,
					});
					previewToggle.hidden = false;
					showMediaPreview('output');
					setStatus(copy.statusReady, 'success');
				} catch (error) {
					setStatus(format(copy.statusError, { message: messageFromError(error) }), 'error');
					throw error;
				} finally {
					processButton.disabled = !state.selectedFile || !profileSelect.value;
				}
			}

			async function convertFileWithFfmpeg(file, profile) {
				return ffmpegRuntime.run(async (ffmpeg) => {
					const inputName = `${Date.now()}-${Math.random().toString(16).slice(2)}${inputExtension(file)}`;
					const outputName = `${inputName}${profile.extension}`;
					const sourceBuffer = await file.arrayBuffer();

					await ffmpeg.writeFile(inputName, new Uint8Array(sourceBuffer.slice(0)));

					try {
						const result = await ffmpeg.exec(buildConversionArgs(inputName, outputName, file, profile));

						if (result !== 0) {
							throw new Error(`FFmpeg exited with code ${result}`);
						}

						const output = await ffmpeg.readFile(outputName);
						return output instanceof Uint8Array ? output : new TextEncoder().encode(String(output));
					} finally {
						await ffmpeg.deleteFile(inputName).catch(() => {});
						await ffmpeg.deleteFile(outputName).catch(() => {});
					}
				});
			}

			function populateProfileOptions() {
				const options = filterProfilesForMediaKind(profileDefinitions, state.selectedFile);
				const previousValue = profileSelect.value;
				const defaultValue = root.dataset.defaultProfile || '';
				profileSelect.innerHTML = '';
				const placeholder = document.createElement('option');
				placeholder.value = '';
				placeholder.textContent = copy.profilePlaceholder;
				profileSelect.appendChild(placeholder);

				for (const profile of options) {
					const option = document.createElement('option');
					option.value = profile.value;
					option.textContent = `${profile.label} (${profile.kind === 'video' ? 'video' : 'audio'})`;
					profileSelect.appendChild(option);
				}

				profileSelect.disabled = !state.selectedFile;
				if (previousValue && options.some((profile) => profile.value === previousValue)) {
					profileSelect.value = previousValue;
				} else if (defaultValue && options.some((profile) => profile.value === defaultValue)) {
					profileSelect.value = defaultValue;
				} else if (state.selectedFile) {
					profileSelect.value = options[0] ? options[0].value : '';
				}
			}

			function updateSelectionUi() {
				converterOutput.hidden = !state.selectedFile;
				if (!state.selectedFile) {
					fileName.textContent = copy.chooseFile;
					fileMeta.textContent = copy.fileHint;
					resultTitle.textContent = copy.selectedFile.replace('{name}', copy.chooseFile);
					resultMeta.textContent = copy.selectedMeta.replace('{size}', '—').replace('{type}', '—');
					downloadLink.hidden = true;
					return;
				}

				fileName.textContent = state.selectedFile.name;
				fileMeta.textContent = format(copy.selectedMeta, {
					size: formatBytes(state.selectedFile.size),
					type: state.selectedFile.type || detectMediaKind(state.selectedFile),
				});
				resultTitle.textContent = format(copy.selectedFile, { name: state.selectedFile.name });
				resultMeta.textContent = copy.outputHelp;
			}

			function resetTool() {
				clearOutput();
				if (state.inputUrl) {
					URL.revokeObjectURL(state.inputUrl);
					state.inputUrl = null;
				}
				fileInput.value = '';
				state.selectedFile = null;
				profileSelect.innerHTML = '<option value="">' + copy.profilePlaceholder + '</option>';
				profileSelect.disabled = true;
				processButton.disabled = true;
				updateSelectionUi();
				setStatus(copy.statusWaiting, 'info');
				mediaPreview.hidden = true;
			}

			function clearOutput() {
				if (state.downloadUrl) {
					URL.revokeObjectURL(state.downloadUrl);
					state.downloadUrl = null;
				}
				state.outputKind = null;
				downloadLink.hidden = true;
				downloadLink.removeAttribute('href');
				downloadLink.removeAttribute('download');
				previewToggle.hidden = true;
				outputVideo.removeAttribute('src');
				outputAudio.removeAttribute('src');
			}

			function showMediaPreview(view) {
				if (!state.selectedFile || !state.inputUrl || (view === 'output' && !state.downloadUrl)) {
					mediaPreview.hidden = true;
					return;
				}

				const showingOutput = view === 'output';
				const kind = showingOutput ? state.outputKind : detectMediaKind(state.selectedFile);
				const active = showingOutput
					? (kind === 'audio' ? outputAudio : outputVideo)
					: (kind === 'audio' ? sourceAudio : sourceVideo);

				for (const media of [sourceVideo, sourceAudio, outputVideo, outputAudio]) {
					media.hidden = media !== active;
					if (media !== active) {
						media.pause();
					}
				}

				const url = showingOutput ? state.downloadUrl : state.inputUrl;
				if (active.src !== url) {
					active.src = url;
				}
				mediaPreview.hidden = false;
				previewToggle.textContent = showingOutput ? copy.showSource : copy.showOutput;
			}

			function getSelectedProfile() {
				return profileDefinitions.find((profile) => profile.value === profileSelect.value) || profileDefinitions[0];
			}

			function setStatus(message, type) {
				status.textContent = message;
				status.dataset.state = type;
			}

			function messageFromError(error) {
				return error && typeof error === 'object' && 'message' in error
					? String(error.message)
					: copy.statusGeneric;
			}
		}
	})();
</script>

<style>
	.converter-tool {
		display: grid;
		gap: 18px;
	}

	.converter-tool [hidden] {
		display: none !important;
	}

	.converter-output {
		display: grid;
	}

	.converter-output[hidden] {
		display: none !important;
	}

	.file-picker {
		min-height: 160px;
		margin-top: 18px;
	}

	.media-preview {
		display: grid;
		gap: 12px;
		margin-top: 18px;
	}

	.media-preview-frame {
		display: grid;
		min-height: 180px;
		place-items: center;
		padding: 12px;
		background: var(--color-surface-alt);
		border: 1px solid var(--color-line);
		border-radius: 8px;
	}

	.media-preview-frame video {
		display: block;
		max-width: 100%;
		max-height: 420px;
	}

	.media-preview-frame audio {
		width: min(100%, 560px);
	}


	.file-picker span,
	.select-control span,
	.result-card p:first-child {
		color: var(--color-accent-dark);
		font-size: 0.78rem;
		font-weight: 850;
		text-transform: uppercase;
	}

	.tool-actions {
		gap: 12px;
	}

	.result-card p:last-child {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.status {
		margin-top: 18px;
	}
</style>
