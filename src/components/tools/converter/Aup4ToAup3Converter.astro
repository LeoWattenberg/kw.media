---
import type { Locale } from '../../../i18n';
import FilePicker from '../shared/FilePicker.astro';
import ToolActions from '../shared/ToolActions.astro';
import ToolIntro from '../shared/ToolIntro.astro';
import ToolPanel from '../shared/ToolPanel.astro';
import ToolResultCard from '../shared/ToolResultCard.astro';
import ToolStatus from '../shared/ToolStatus.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copyByLocale = {
	de: {
		eyebrow: 'Audacity-Projekt-Tool',
		title: 'AUP4 zu AUP3',
		intro: 'Erstelle eine AUP3-Kopie eines kompatiblen Audacity-AUP4-Projekts. Die bearbeitbaren Spuren und Audiodaten bleiben erhalten.',
		privacy: 'Deine Projektdatei bleibt lokal. Speichere und schließe das Projekt vor dem Konvertieren und behalte die Originaldatei.',
		sourceTitle: 'Audacity-Projekt',
		chooseFile: 'AUP4-Projekt auswählen',
		fileHint: 'Gespeicherte und geschlossene .aup4-Datei · Dateien über {threshold} benötigen eine Bestätigung',
		selectedFile: '{name} · {size}',
		largeProjectConfirm: 'Diese AUP4-Datei ist {size} groß und überschreitet die empfohlene Größe von {threshold}. Du kannst die Konvertierung trotzdem versuchen. Sie benötigt viel Arbeitsspeicher und kann den Browser-Tab beenden. Möchtest du fortfahren?',
		largeProjectCancelled: 'Die Konvertierung wurde abgebrochen.',
		outputTitle: 'AUP3-Ausgabe',
		compatibility: 'Für AUP4-Projekte mit der aktuell kompatiblen Projektstruktur. Öffne die heruntergeladene AUP3-Kopie in Audacity 3.7, um weiterzuarbeiten. Audacity 4 kann zusätzliche Tempo-Einstellungen speichern, die Audacity 3 nicht unterstützt.',
		warningTempoEditing: 'Das aktuelle Audio und Clip-Timing bleiben erhalten. Audacity 3 unterstützt keine unabhängigen Clip-Tempi oder deaktivierte Tempo-Anpassung: Bei späteren Änderungen des Projekttempos können diese Clips anders gedehnt werden als in Audacity 4.',
		convert: 'AUP3-Kopie erstellen',
		reset: 'Zurücksetzen',
		resultTitle: 'AUP3-Ergebnis',
		download: 'AUP3-Projekt herunterladen',
		statusWaiting: 'Wähle ein gespeichertes AUP4-Projekt aus.',
		statusSelected: '{name} ist bereit für die lokale Konvertierung.',
		statusConverting: 'AUP3-Kopie wird lokal erstellt…',
		statusReady: 'Die AUP3-Kopie ist fertig. Deine Originaldatei bleibt erhalten.',
		statusError: 'Die AUP4-Konvertierung ist fehlgeschlagen: {message}',
		statusGeneric: 'Unbekannter Fehler',
	},
	en: {
		eyebrow: 'Audacity project tool',
		title: 'AUP4 to AUP3',
		intro: 'Create an AUP3 copy of a compatible Audacity AUP4 project. Editable tracks and audio data are preserved.',
		privacy: 'Your project file stays local. Save and close the project before converting it, and keep the original file.',
		sourceTitle: 'Audacity project',
		chooseFile: 'Choose AUP4 project',
		fileHint: 'Saved and closed .aup4 file · files over {threshold} ask before conversion',
		selectedFile: '{name} · {size}',
		largeProjectConfirm: 'This AUP4 file is {size} and exceeds {threshold}, the recommended size. You can still attempt conversion. It uses substantial memory and may terminate the browser tab. Continue?',
		largeProjectCancelled: 'Conversion cancelled.',
		outputTitle: 'AUP3 output',
		compatibility: 'For AUP4 projects using the currently compatible project structure. Open the downloaded AUP3 copy in Audacity 3.7 to continue editing. Audacity 4 can store additional tempo settings that Audacity 3 does not support.',
		warningTempoEditing: 'Current audio and clip timing are preserved. Audacity 3 does not support independent clip tempos or disabled tempo matching: later project-tempo changes may stretch these clips differently from Audacity 4.',
		convert: 'Create AUP3 copy',
		reset: 'Reset',
		resultTitle: 'AUP3 result',
		download: 'Download AUP3 project',
		statusWaiting: 'Choose a saved AUP4 project.',
		statusSelected: '{name} is ready for local conversion.',
		statusConverting: 'Creating the AUP3 copy locally…',
		statusReady: 'The AUP3 copy is ready. Your original file is preserved.',
		statusError: 'AUP4 conversion failed: {message}',
		statusGeneric: 'Unknown error',
	},
} satisfies Record<Locale, Record<string, string>>;

const copy = copyByLocale[locale];
const copyJson = JSON.stringify(copy);
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />

<section class="section audacity-converter-section tool-workspace">
	<div class="container">
		<div class="audacity-converter" data-aup4-aup3-converter data-copy={copyJson}>
			<div class="converter-workspace">
				<ToolPanel class="converter-panel converter-stage" title={copy.sourceTitle}>
					<FilePicker
						label={copy.sourceTitle}
						name={copy.chooseFile}
						hint={copy.fileHint.replace('{threshold}', '256 MB')}
						accept=".aup4"
						nameAttrs={{ 'data-file-name': true }}
						metaAttrs={{ 'data-file-meta': true }}
						inputAttrs={{ 'data-file-input': true }}
					/>
					<div class="audacity-output" data-output hidden>
						<ToolResultCard
							title={copy.resultTitle}
							meta="—"
							downloadLabel={copy.download}
							titleAttrs={{ 'data-result-title': true }}
							metaAttrs={{ 'data-result-meta': true }}
							downloadAttrs={{ 'data-download': true }}
						/>
						<p class="converter-note" data-warning role="note" hidden></p>
					</div>
				</ToolPanel>

				<details class="converter-toolbar" open>
					<summary>{copy.outputTitle}</summary>
					<ToolPanel class="converter-panel" title={copy.outputTitle}>
						<p class="converter-note">{copy.compatibility}</p>
						<ToolActions>
							<button class="button primary" data-convert type="button" disabled>{copy.convert}</button>
							<button class="button secondary" data-reset type="button">{copy.reset}</button>
						</ToolActions>
						<ToolStatus data-status role="status" aria-live="polite" text={copy.statusWaiting} />
					</ToolPanel>
				</details>
			</div>
		</div>
	</div>
</section>

<script>
	import { convertAup4FileToAup3, aup4ToAup3OutputName } from '../../../lib/tools/aup4';
	import { getAup3MemoryLimits, requiresAup3LargeProjectConfirmation } from '../../../lib/tools/aup3-browser';
	import { formatBytes, formatTemplate as format } from '../../../lib/tools/format';

	(() => {
		const roots = document.querySelectorAll('[data-aup4-aup3-converter]:not([data-aup4-aup3-converter-bound])');
		for (const root of roots) {
			root.dataset.aup4Aup3ConverterBound = 'true';
			initConverter(root);
		}

		function initConverter(root) {
			const copy = JSON.parse(root.dataset.copy || '{}');
			const warningThreshold = formatBytes(getAup3MemoryLimits().databaseBytes);
			const fileInput = root.querySelector('[data-file-input]');
			const fileName = root.querySelector('[data-file-name]');
			const fileMeta = root.querySelector('[data-file-meta]');
			const convertButton = root.querySelector('[data-convert]');
			const resetButton = root.querySelector('[data-reset]');
			const status = root.querySelector('[data-status]');
			const output = root.querySelector('[data-output]');
			const resultTitle = root.querySelector('[data-result-title]');
			const resultMeta = root.querySelector('[data-result-meta]');
			const download = root.querySelector('[data-download]');
			const warning = root.querySelector('[data-warning]');

			if (!fileInput || !fileName || !fileMeta || !convertButton || !resetButton || !status || !output || !resultTitle || !resultMeta || !download || !warning) {
				return;
			}

			const state = { file: null, outputUrl: null, working: false, abortController: null, disposed: false };
			fileMeta.textContent = format(copy.fileHint, { threshold: warningThreshold });
			fileInput.addEventListener('change', () => selectFile(fileInput.files?.[0] || null));
			convertButton.addEventListener('click', () => void convertFile());
			resetButton.addEventListener('click', () => {
				if (state.working) return;
				fileInput.value = '';
				selectFile(null);
			});
			window.addEventListener('pagehide', (event) => {
				if (event.persisted) return;
				state.disposed = true;
				state.abortController?.abort();
				clearOutput();
			});

			function selectFile(file) {
				clearOutput();
				state.file = file;
				fileName.textContent = file?.name || copy.chooseFile;
				fileMeta.textContent = file
					? format(copy.selectedFile, { name: file.name, size: formatBytes(file.size) })
					: format(copy.fileHint, { threshold: warningThreshold });
				setStatus(file ? format(copy.statusSelected, { name: file.name }) : copy.statusWaiting, file ? 'success' : 'info');
				updateControls();
			}

			async function convertFile() {
				if (!state.file || state.working || state.disposed) return;
				const needsLargeProjectConfirmation = requiresAup3LargeProjectConfirmation(state.file.size);
				const allowLargeProject = needsLargeProjectConfirmation
					? window.confirm(format(copy.largeProjectConfirm, { size: formatBytes(state.file.size), threshold: warningThreshold }))
					: false;
				if (needsLargeProjectConfirmation && !allowLargeProject) {
					setStatus(copy.largeProjectCancelled, 'info');
					return;
				}
				state.working = true;
				state.abortController = new AbortController();
				clearOutput();
				updateControls();
				setStatus(copy.statusConverting, 'info');
				try {
					const blob = await convertAup4FileToAup3(state.file, {
						allowLargeProject,
						signal: state.abortController.signal,
						onWarning: (detail) => {
							if (!state.disposed && detail.code === 'AUP4_TEMPO_EDITING_CHANGED') {
								warning.textContent = copy.warningTempoEditing;
								warning.hidden = false;
								warning.dataset.warningCode = detail.code;
							}
						},
					});
					if (state.disposed) return;
					const outputName = aup4ToAup3OutputName(state.file.name);
					state.outputUrl = URL.createObjectURL(blob);
					download.href = state.outputUrl;
					download.download = outputName;
					download.hidden = false;
					resultTitle.textContent = outputName;
					resultMeta.textContent = formatBytes(blob.size);
					output.hidden = false;
					setStatus(copy.statusReady, 'success');
				} catch (error) {
					if (state.disposed) return;
					const message = error && typeof error === 'object' && 'message' in error
						? String(error.message)
						: String(error || copy.statusGeneric);
					setStatus(format(copy.statusError, { message }), 'error');
				} finally {
					state.working = false;
					state.abortController = null;
					updateControls();
				}
			}

			function clearOutput() {
				if (state.outputUrl) URL.revokeObjectURL(state.outputUrl);
				state.outputUrl = null;
				download.hidden = true;
				download.removeAttribute('href');
				download.removeAttribute('download');
				output.hidden = true;
				warning.hidden = true;
				warning.textContent = '';
				delete warning.dataset.warningCode;
			}

			function updateControls() {
				fileInput.disabled = state.working;
				convertButton.disabled = state.working || !state.file;
				resetButton.disabled = state.working;
			}

			function setStatus(message, type) {
				status.textContent = message;
				status.dataset.state = type;
			}
		}
	})();
</script>

<style>
	.audacity-converter,
	.converter-panel,
	.audacity-output {
		display: grid;
		gap: 16px;
	}

	.audacity-converter [hidden] {
		display: none !important;
	}

	.file-picker {
		min-height: 160px;
		margin-top: 18px;
	}

	.audacity-output {
		margin-top: 2px;
	}

	.converter-note {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}
</style>
