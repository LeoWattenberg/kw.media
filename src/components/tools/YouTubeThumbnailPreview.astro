---
import type { Locale } from "../../i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const copyByLocale = {
	de: {
		eyebrow: "Creator-Tool",
		title: "YouTube-Thumbnail-Vorschau",
		intro: "Teste, wie dein Thumbnail und Titel in typischen YouTube-Web- und App-Karten wirken, bevor du sie veröffentlichst.",
		privacy:
			"Dein Bild bleibt lokal im Browser. Die Vorschau ist eine Annäherung, weil YouTube Layouts je nach Gerät und Testgruppe ändern kann.",
		contentTitle: "Titel & Thumbnail",
		previewTitle: "Live-Vorschau",
		thumbnailTitle: "Thumbnail",
		chooseFile: "Thumbnail wählen",
		fileHint: "JPG, PNG, GIF, WebP oder AVIF, idealerweise 16:9",
		clearImage: "Bild entfernen",
		titleLabel: "Titel",
		titleCount: "Zeichen",
		homePreview: "Startseite",
		homeContext: "Desktop-Kachel im Feed",
		notificationPreview: "Benachrichtigungen",
		notificationContext: "Kleine Vorschau im Benachrichtigungsmenü",
		mobilePreview: "Mobiles Thumbnail",
		mobileContext: "Startseiten-Thumbnail in voller Gerätebreite.",
		deviceToggleLabel: "Gerätegröße",
		relatedPreview: "Ähnliche Videos",
		relatedContext: "Desktop-Seitenleiste neben dem Player",
		desktopOnly: "Nur Desktop",
		notificationsHeading: "Benachrichtigungen",
		notificationTag: "Neu",
		defaultTitle:
			"Das perfekte Thumbnail ist nicht laut. Es ist sofort lesbar.",
		defaultChannel: "kw.media",
		defaultMetadata: "24.000 Aufrufe vor 2 Tagen",
		defaultDuration: "12:34",
		avatarLabel: "Kanalavatar",
		client: {
			chooseFile: "Thumbnail wählen",
			fileHint: "JPG, PNG, GIF, WebP oder AVIF, idealerweise 16:9",
			fileMeta: "{type} ({size})",
			imageRemoved: "Bild entfernt",
			noTitle: "Titel eingeben",
			titleCount: "{count} Zeichen",
			deviceSize: "{device} · {height} × {width} mm",
		},
	},
	en: {
		eyebrow: "Creator tool",
		title: "YouTube Thumbnail Preview",
		intro: "Test how your thumbnail and title read in typical YouTube web and app cards before you publish.",
		privacy:
			"Your image stays local in the browser. The preview is an approximation because YouTube can change layouts by device and experiment group.",
		contentTitle: "Title & thumbnail",
		previewTitle: "Live preview",
		thumbnailTitle: "Thumbnail",
		chooseFile: "Choose thumbnail",
		fileHint: "JPG, PNG, GIF, WebP, or AVIF, ideally 16:9",
		clearImage: "Remove image",
		titleLabel: "Title",
		titleCount: "Characters",
		homePreview: "Home feed",
		homeContext: "Desktop grid card",
		notificationPreview: "Notifications",
		notificationContext: "Small thumbnail inside the notifications menu",
		mobilePreview: "Mobile thumbnail",
		mobileContext: "Home feed thumbnail at full device width.",
		deviceToggleLabel: "Device size",
		relatedPreview: "Related videos",
		relatedContext: "Desktop sidebar beside the player",
		desktopOnly: "Desktop only",
		notificationsHeading: "Notifications",
		notificationTag: "New",
		defaultTitle:
			"The perfect thumbnail is not loud. It is instantly readable.",
		defaultChannel: "kw.media",
		defaultMetadata: "24K views 2 days ago",
		defaultDuration: "12:34",
		avatarLabel: "Channel avatar",
		client: {
			chooseFile: "Choose thumbnail",
			fileHint: "JPG, PNG, GIF, WebP, or AVIF, ideally 16:9",
			fileMeta: "{type} ({size})",
			imageRemoved: "Image removed",
			noTitle: "Enter a title",
			titleCount: "{count} characters",
			deviceSize: "{device} · {height} × {width} mm",
		},
	},
} satisfies Record<
	Locale,
	Record<string, unknown> & { client: Record<string, string> }
>;

const copy = copyByLocale[locale];
const copyJson = JSON.stringify(copy.client);
---

<section class="tool-intro">
	<div class="container">
		<p class="eyebrow">{copy.eyebrow}</p>
		<h1>{copy.title}</h1>
		<p class="tool-lede">{copy.intro}</p>
		<p class="tool-note">{copy.privacy}</p>
	</div>
</section>

<section class="section thumbnail-preview-section tool-workspace">
	<div class="container">
		<div
			class="thumbnail-preview-tool"
			data-thumbnail-preview
			data-copy={copyJson}
		>
			<section
				class="preview-panel tool-panel controls-panel"
				aria-labelledby="thumbnail-preview-controls"
			>
				<h2 id="thumbnail-preview-controls">{copy.contentTitle}</h2>

				<div class="file-grid">
					<label class="file-picker tool-file-picker">
						<span>{copy.thumbnailTitle}</span>
						<strong data-file-name>{copy.chooseFile}</strong>
						<small data-file-meta>{copy.fileHint}</small>
						<input
							data-thumbnail-file
							type="file"
							accept="image/avif,image/gif,image/jpeg,image/png,image/webp"
						/>
					</label>
					<button
						class="button secondary"
						data-clear-image
						type="button">{copy.clearImage}</button
					>
				</div>

				<label class="field-control">
					<span>{copy.titleLabel}</span>
					<textarea data-title-input rows="4" maxlength="140"
						>{copy.defaultTitle}</textarea
					>
					<small data-title-count>{copy.titleCount}</small>
				</label>
			</section>

			<section
				class="preview-panel tool-panel output-panel"
				aria-labelledby="thumbnail-preview-output"
			>
				<div class="panel-heading">
					<div>
						<h2 id="thumbnail-preview-output">
							{copy.previewTitle}
						</h2>
					</div>
				</div>

				<div class="preview-grid">
					<article
						class="preview-card preview-card-notification"
						aria-labelledby="notification-preview-heading"
					>
						<div class="preview-label">
							<h3 id="notification-preview-heading">
								{copy.notificationPreview}
							</h3>
							<p>{copy.notificationContext}</p>
						</div>
						<div class="yt-surface yt-notification-surface">
							<div class="yt-notification-header">
								<strong>{copy.notificationsHeading}</strong>
								<span
									class="yt-notification-dot"
									aria-hidden="true"></span>
							</div>
							<div class="yt-notification-item">
								<div
									class="channel-avatar channel-avatar-small"
									aria-label={copy.avatarLabel}
									data-avatar
								>
								</div>
								<div class="yt-copy yt-copy-notification">
									<h4 data-title-preview>
										{copy.defaultTitle}
									</h4>
									<p>
										<span class="yt-tag"
											>{copy.notificationTag}</span
										>
										<span data-channel-preview
											>{copy.defaultChannel}</span
										>
										<span aria-hidden="true"> • </span>
										<span data-meta-preview
											>{copy.defaultMetadata}</span
										>
									</p>
								</div>
								<div
									class="yt-thumbnail yt-thumbnail-notification"
								>
									<img data-preview-image alt="" hidden />
									<div
										class="thumbnail-placeholder"
										data-thumbnail-placeholder
									>
										<span>16:9</span>
									</div>
									<span
										class="duration-badge"
										data-duration-preview
										>{copy.defaultDuration}</span
									>
								</div>
							</div>
						</div>
					</article>

					<article
						class="preview-card preview-card-related"
						aria-labelledby="related-preview-heading"
					>
						<div class="preview-label">
							<div class="preview-label-row">
								<h3 id="related-preview-heading">
									{copy.relatedPreview}
								</h3>
								<span class="device-pill"
									>{copy.desktopOnly}</span
								>
							</div>
							<p>{copy.relatedContext}</p>
						</div>
						<div class="yt-surface yt-related-surface">
							<div class="yt-related-item">
								<div class="yt-thumbnail yt-thumbnail-related">
									<img data-preview-image alt="" hidden />
									<div
										class="thumbnail-placeholder"
										data-thumbnail-placeholder
									>
										<span>16:9</span>
									</div>
									<span
										class="duration-badge"
										data-duration-preview
										>{copy.defaultDuration}</span
									>
								</div>
								<div class="yt-copy yt-copy-related">
									<h4 data-title-preview>
										{copy.defaultTitle}
									</h4>
									<p data-channel-preview>
										{copy.defaultChannel}
									</p>
									<p data-meta-preview>
										{copy.defaultMetadata}
									</p>
								</div>
							</div>
						</div>
					</article>
					<article
						class="preview-card preview-card-home"
						aria-labelledby="home-preview-heading"
					>
						<div class="preview-label">
							<h3 id="home-preview-heading">
								{copy.homePreview}
							</h3>
							<p>{copy.homeContext}</p>
						</div>
						<div class="yt-surface yt-home-surface">
							<div class="yt-home-track">
								<div class="yt-home-card">
									<div class="yt-thumbnail yt-thumbnail-home">
										<img data-preview-image alt="" hidden />
										<div
											class="thumbnail-placeholder"
											data-thumbnail-placeholder
										>
											<span>16:9</span>
										</div>
										<span
											class="duration-badge"
											data-duration-preview
											>{copy.defaultDuration}</span
										>
									</div>
									<div class="yt-home-meta">
										<div
											class="channel-avatar"
											aria-label={copy.avatarLabel}
											data-avatar
										>
										</div>
										<div class="yt-copy yt-copy-home">
											<h4 data-title-preview>
												{copy.defaultTitle}
											</h4>
											<p data-channel-preview>
												{copy.defaultChannel}
											</p>
											<p data-meta-preview>
												{copy.defaultMetadata}
											</p>
										</div>
										<span class="yt-more" aria-hidden="true"
										></span>
									</div>
								</div>
							</div>
						</div>
					</article>

					<article
						class="preview-card preview-card-mobile"
						aria-labelledby="mobile-preview-heading"
					>
						<div class="preview-label">
							<div class="preview-label-stack">
								<div>
									<h3 id="mobile-preview-heading">
										{copy.mobilePreview}
									</h3>
									<p>{copy.mobileContext}</p>
								</div>
								<div
									class="device-toggle"
									role="group"
									aria-label={copy.deviceToggleLabel}
								>
									<button
										class="device-toggle-button"
										data-mobile-device-option="iphone-se"
										type="button">iPhone SE</button
									>
									<button
										class="device-toggle-button is-active"
										data-mobile-device-option="iphone-17"
										type="button">iPhone 17</button
									>
									<button
										class="device-toggle-button"
										data-mobile-device-option="galaxy-s26-ultra"
										type="button">Galaxy S26 Ultra</button
									>
								</div>
							</div>
						</div>
						<div class="mobile-stage">
							<div
								class="mobile-device"
								data-mobile-device-frame
								data-mobile-device="iphone-17"
							>
								<div class="mobile-device-screen">
									<div
										class="mobile-device-cutout"
										aria-hidden="true"
									>
									</div>
									<div
										class="mobile-status-bar"
										aria-hidden="true"
									>
										<span>9:41</span>
										<span class="mobile-status-icons"
										></span>
									</div>
									<div
										class="mobile-app-bar"
										aria-hidden="true"
									>
										<span class="mobile-app-logo"></span>
										<strong>YouTube</strong>
										<span class="mobile-app-actions"></span>
									</div>
									<div class="mobile-feed">
										<div
											class="yt-thumbnail yt-thumbnail-mobile"
										>
											<img
												data-preview-image
												alt=""
												hidden
											/>
											<div
												class="thumbnail-placeholder"
												data-thumbnail-placeholder
											>
												<span>16:9</span>
											</div>
											<span
												class="duration-badge"
												data-duration-preview
												>{copy.defaultDuration}</span
											>
										</div>
										<div class="yt-mobile-meta">
											<div
												class="channel-avatar channel-avatar-mobile"
												aria-label={copy.avatarLabel}
												data-avatar
											>
											</div>
											<div class="yt-copy yt-copy-mobile">
												<h4 data-title-preview>
													{copy.defaultTitle}
												</h4>
												<p>
													<span data-channel-preview
														>{
															copy.defaultChannel
														}</span
													>
													<span aria-hidden="true">
														•
													</span>
													<span data-meta-preview
														>{
															copy.defaultMetadata
														}</span
													>
												</p>
											</div>
											<span
												class="yt-more"
												aria-hidden="true"></span>
										</div>
									</div>
									<span
										class="mobile-home-indicator"
										aria-hidden="true"></span>
								</div>
							</div>
							<p
								class="mobile-device-caption"
								data-mobile-device-label
							>
								iPhone 17
							</p>
						</div>
					</article>
				</div>
			</section>
		</div>
	</div>
</section>

<script is:inline>
	(() => {
		const roots = document.querySelectorAll(
			"[data-thumbnail-preview]:not([data-thumbnail-bound])",
		);

		for (const root of roots) {
			root.dataset.thumbnailBound = "true";
			initThumbnailPreview(root);
		}

		function initThumbnailPreview(root) {
			const copy = JSON.parse(root.dataset.copy || "{}");
			const fileInput = root.querySelector("[data-thumbnail-file]");
			const fileName = root.querySelector("[data-file-name]");
			const fileMeta = root.querySelector("[data-file-meta]");
			const clearImageButton = root.querySelector("[data-clear-image]");
			const titleInput = root.querySelector("[data-title-input]");
			const titleCount = root.querySelector("[data-title-count]");
			const previewImages = [
				...root.querySelectorAll("[data-preview-image]"),
			];
			const placeholders = [
				...root.querySelectorAll("[data-thumbnail-placeholder]"),
			];
			const titlePreviews = [
				...root.querySelectorAll("[data-title-preview]"),
			];
			const channelPreviews = [
				...root.querySelectorAll("[data-channel-preview]"),
			];
			const metaPreviews = [
				...root.querySelectorAll("[data-meta-preview]"),
			];
			const durationPreviews = [
				...root.querySelectorAll("[data-duration-preview]"),
			];
			const avatars = [...root.querySelectorAll("[data-avatar]")];
			const mobileDeviceButtons = [
				...root.querySelectorAll("[data-mobile-device-option]"),
			];
			const mobileDeviceFrame = root.querySelector(
				"[data-mobile-device-frame]",
			);
			const mobileDeviceLabel = root.querySelector(
				"[data-mobile-device-label]",
			);
			const defaultChannel =
				root
					.querySelector("[data-channel-preview]")
					?.textContent?.trim() || "kw.media";
			const defaultMeta =
				root
					.querySelector("[data-meta-preview]")
					?.textContent?.trim() || "";
			const defaultDuration =
				root
					.querySelector("[data-duration-preview]")
					?.textContent?.trim() || "";
			const mobileDevices = {
				"iphone-se": {
					label: "iPhone SE",
					bodyWidth: 67.3,
					bodyHeight: 138.4,
					screenWidth: 58.51,
					screenHeight: 104.06,
					bodyRadius: 11.5,
					screenRadius: 1.8,
					statusTop: 2.5,
					statusSide: 4.2,
					cutoutWidth: 0,
					cutoutHeight: 0,
					cutoutTop: 0,
					homeIndicatorWidth: 0,
				},
				"iphone-17": {
					label: "iPhone 17",
					bodyWidth: 71.5,
					bodyHeight: 149.6,
					screenWidth: 66.87,
					screenHeight: 145.38,
					bodyRadius: 15,
					screenRadius: 12.5,
					statusTop: 4.3,
					statusSide: 4.1,
					cutoutWidth: 18,
					cutoutHeight: 4.8,
					cutoutTop: 2.8,
					homeIndicatorWidth: 17,
				},
				"galaxy-s26-ultra": {
					label: "Galaxy S26 Ultra",
					bodyWidth: 77.6,
					bodyHeight: 162.8,
					screenWidth: 73.44,
					screenHeight: 159.13,
					bodyRadius: 12.8,
					screenRadius: 10.8,
					statusTop: 3.2,
					statusSide: 4.1,
					cutoutWidth: 3.4,
					cutoutHeight: 3.4,
					cutoutTop: 2.9,
					homeIndicatorWidth: 17,
				},
			};

			let imageUrl = "";

			fileInput.addEventListener("change", () => {
				setImage(fileInput.files && fileInput.files[0]);
			});
			clearImageButton.addEventListener("click", () => {
				fileInput.value = "";
				setImage(null);
			});

			for (const button of mobileDeviceButtons) {
				button.addEventListener("click", () => {
					setMobileDevice(
						button.dataset.mobileDeviceOption || "iphone-17",
					);
				});
			}

			for (const input of [titleInput]) {
				input.addEventListener("input", updatePreview);
			}

			setMobileDevice("iphone-17");
			updatePreview();

			function setImage(file) {
				if (imageUrl) {
					URL.revokeObjectURL(imageUrl);
					imageUrl = "";
				}

				if (!file) {
					for (const image of previewImages) {
						image.removeAttribute("src");
						image.hidden = true;
					}

					for (const placeholder of placeholders) {
						placeholder.hidden = false;
					}

					fileName.textContent = copy.chooseFile;
					fileMeta.textContent = copy.fileHint;
					return;
				}

				imageUrl = URL.createObjectURL(file);

				for (const image of previewImages) {
					image.src = imageUrl;
					image.hidden = false;
				}

				for (const placeholder of placeholders) {
					placeholder.hidden = true;
				}

				fileName.textContent = file.name;
				fileMeta.textContent = format(copy.fileMeta, {
					type:
						file.type ||
						file.name.split(".").pop()?.toUpperCase() ||
						"Image",
					size: formatBytes(file.size),
				});
			}

			function updatePreview() {
				const title = titleInput.value.trim() || copy.noTitle;
				titleCount.textContent = format(copy.titleCount, {
					count: titleInput.value.length,
				});

				for (const preview of titlePreviews) {
					preview.textContent = title;
				}

				for (const preview of channelPreviews) {
					preview.textContent = defaultChannel;
				}

				for (const preview of metaPreviews) {
					preview.textContent = defaultMeta;
				}

				for (const preview of durationPreviews) {
					preview.textContent = defaultDuration;
					preview.hidden = !defaultDuration;
				}

				for (const avatar of avatars) {
					avatar.textContent = avatarInitial(defaultChannel);
				}
			}

			function setMobileDevice(deviceKey) {
				const device =
					mobileDevices[deviceKey] || mobileDevices["iphone-17"];

				mobileDeviceFrame.dataset.mobileDevice = deviceKey;
				mobileDeviceFrame.style.setProperty(
					"--device-body-width-mm",
					device.bodyWidth,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-body-height-mm",
					device.bodyHeight,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-screen-width-mm",
					device.screenWidth,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-screen-height-mm",
					device.screenHeight,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-body-radius-mm",
					device.bodyRadius,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-screen-radius-mm",
					device.screenRadius,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-status-top-mm",
					device.statusTop,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-status-side-mm",
					device.statusSide,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-cutout-width-mm",
					device.cutoutWidth,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-cutout-height-mm",
					device.cutoutHeight,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-cutout-top-mm",
					device.cutoutTop,
				);
				mobileDeviceFrame.style.setProperty(
					"--device-home-indicator-width-mm",
					device.homeIndicatorWidth,
				);
				mobileDeviceLabel.textContent = format(copy.deviceSize, {
					device: device.label,
					height: device.bodyHeight.toFixed(1),
					width: device.bodyWidth.toFixed(1),
				});

				for (const button of mobileDeviceButtons) {
					const isActive =
						button.dataset.mobileDeviceOption === deviceKey;
					button.classList.toggle("is-active", isActive);
					button.setAttribute(
						"aria-pressed",
						isActive ? "true" : "false",
					);
				}
			}

			function avatarInitial(value) {
				return value.trim().charAt(0).toUpperCase() || "K";
			}

			function format(template, values) {
				return String(template).replace(/\{(\w+)\}/g, (_match, key) => {
					return values && key in values ? String(values[key]) : "";
				});
			}

			function formatBytes(bytes) {
				if (!Number.isFinite(bytes) || bytes <= 0) {
					return "0 B";
				}

				const units = ["B", "KB", "MB", "GB"];
				const power = Math.min(
					units.length - 1,
					Math.floor(Math.log(bytes) / Math.log(1024)),
				);
				const value = bytes / 1024 ** power;
				return `${value.toFixed(value >= 10 || power === 0 ? 0 : 1)} ${units[power]}`;
			}
		}
	})();
</script>

<style>
	.tool-intro h1 {
		max-width: 820px;
	}

	.thumbnail-preview-tool {
		display: grid;
		grid-template-columns: minmax(300px, 0.42fr) minmax(0, 1fr);
		gap: 18px;
		align-items: start;
	}

	.file-grid {
		display: grid;
		gap: 12px;
		margin-top: 18px;
	}

	.file-picker {
		min-height: 148px;
	}

	.field-control span {
		color: var(--color-accent-dark);
