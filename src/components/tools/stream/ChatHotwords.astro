---
import ChatCard from './ChatCard.astro';
import KitToolApp from './KitToolApp.astro';
import LayoutCard from './LayoutCard.astro';
import config from '../../../lib/tools/stream/chat-hotwords/config.js?raw';
import logic from '../../../lib/tools/stream/chat-hotwords/logic.js?raw';
import css from '../../../lib/tools/stream/chat-hotwords/tool.css?raw';
---

<KitToolApp title="Hotwords · kw.media" css={css} config={config} logic={logic}>
	<Fragment slot="left">
		<div class="panel">
			<div class="panel-head"><b data-i18n="liveTitle"></b><span id="liveStats" class="muted"></span><span style="flex:1"></span><button id="btnDemo" class="small"></button><button id="btnReset" class="small" data-i18n="reset"></button></div>
			<div id="liveList" class="hw-list"></div>
			<p class="hint-text" data-i18n="liveHint"></p>
		</div>
	</Fragment>
	<Fragment slot="side">
		<ChatCard />
		<div class="card">
			<h3 data-i18n="cardWords"></h3>
			<div class="field"><span data-i18n="fWin"></span><div class="seg" data-seg="win"><button data-val="10">10 s</button><button data-val="30">30 s</button><button data-val="60">60 s</button><button data-val="120">2 min</button></div></div>
			<div class="field"><span data-i18n="fMode"></span><div class="seg" data-seg="mode"><button data-val="words" data-i18n="modeWords"></button><button data-val="msgs" data-i18n="modeMsgs"></button></div></div>
			<label class="check"><input type="checkbox" data-key="once"> <span data-i18n="fOnce"></span></label>
			<label class="check"><input type="checkbox" data-key="stop"> <span data-i18n="fStop"></span></label>
			<label class="check"><input type="checkbox" data-key="noCmds"> <span data-i18n="fCmds"></span></label>
			<label class="field" style="margin-top:10px"><span data-i18n="fIgnore"></span><input type="text" data-key="ignore" data-i18n-ph="ignorePh" spellcheck="false"></label>
			<label class="field"><span data-i18n="fIgnoreUsers"></span><input type="text" data-key="ignoreUsers" spellcheck="false"></label>
		</div>
		<div class="card">
			<h3 data-i18n="cardLook"></h3>
			<label class="field"><span data-i18n="fHeading"></span><input type="text" data-key="title" maxlength="40"></label>
			<div class="field"><span data-i18n="fTop"></span><div class="seg" data-seg="top"><button data-val="3">3</button><button data-val="5">5</button><button data-val="8">8</button><button data-val="10">10</button></div></div>
			<label class="field"><span data-i18n="fBgMode"></span>
				<select data-key="bgMode">
					<option value="card" data-i18n="bgCard"></option>
					<option value="magenta" data-i18n="bgMagenta"></option>
					<option value="full" data-i18n="bgFull"></option>
				</select>
			</label>
		</div>
		<LayoutCard formats={[['panel', 'fmtPanel'], ['bar', 'fmtBar'], ['square', 'fmtSquare']]} />
	</Fragment>
	<Fragment slot="help">
		<h2 data-i18n="helpTitle"></h2>
		<ol>
			<li data-i18n="help1"></li>
			<li data-i18n="help2"></li>
			<li data-i18n="help3"></li>
		</ol>
	</Fragment>
</KitToolApp>
