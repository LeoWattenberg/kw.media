---
import type { Locale } from '../../i18n';
import FilePicker from './shared/FilePicker.astro';
import SelectControl from './shared/SelectControl.astro';
import ToolActions from './shared/ToolActions.astro';
import ToolIntro from './shared/ToolIntro.astro';
import ToolPanel from './shared/ToolPanel.astro';
import ToolStatus from './shared/ToolStatus.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = {
	de: {
		eyebrow: 'Automatische Crop-Erkennung', title: 'Schwarze Balken entfernen',
		intro: 'Erkenne schwarze Balken in lokalen Videos und exportiere eine sauber gecroppte Version.',
		privacy: 'Die Frame-Analyse läuft per Canvas lokal, der Export über FFmpeg WASM.',
		source: 'Video', choose: 'Video auswählen', hint: 'MP4, MOV, WebM, MKV und weitere Formate',
		settings: 'Crop', sensitivity: 'Empfindlichkeit', output: 'Ausgabeformat', analyze: 'Balken erkennen', crop: 'Video croppen', clear: 'Zurücksetzen',
		result: 'Ergebnis', download: 'Gecropptes Video herunterladen', waiting: 'Wähle ein Video.', selected: '{name} ist bereit.',
		analyzing: 'Analysiere Frame…', detected: 'Crop erkannt: {w}x{h} bei {x},{y}.', none: 'Keine deutlichen Balken erkannt.',
		processing: 'FFmpeg rendert den Crop…', loading: 'FFmpeg WASM wird geladen…', ready: 'FFmpeg WASM ist bereit.', progress: 'FFmpeg arbeitet… {progress}%',
		done: 'Crop abgeschlossen.', timeout: 'FFmpeg WASM hat nicht innerhalb von 90 Sekunden geladen.', error: 'Crop fehlgeschlagen: {message}', generic: 'Unbekannter Fehler',
	},
	en: {
		eyebrow: 'Automatic crop detection', title: 'Black Bar Remover',
		intro: 'Detect black bars in local videos and export a clean cropped version.',
		privacy: 'Frame analysis runs locally via Canvas, export uses FFmpeg WASM.',
		source: 'Video', choose: 'Choose video', hint: 'MP4, MOV, WebM, MKV, and more',
		settings: 'Crop', sensitivity: 'Sensitivity', output: 'Output format', analyze: 'Detect bars', crop: 'Crop video', clear: 'Reset',
		result: 'Result', download: 'Download cropped video', waiting: 'Choose a video.', selected: '{name} is ready.',
		analyzing: 'Analyzing frame…', detected: 'Crop detected: {w}x{h} at {x},{y}.', none: 'No obvious bars detected.',
		processing: 'FFmpeg is rendering the crop…', loading: 'Loading FFmpeg WASM…', ready: 'FFmpeg WASM is ready.', progress: 'FFmpeg is working… {progress}%',
		done: 'Crop complete.', timeout: 'FFmpeg WASM did not load within 90 seconds.', error: 'Crop failed: {message}', generic: 'Unknown error',
	},
}[locale];
const copyJson = JSON.stringify(copy);
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />
<section class="section crop-doctor-section tool-workspace">
	<div class="container">
		<div class="crop-doctor" data-crop-doctor data-copy={copyJson}>
			<ToolPanel title={copy.source}>
				<FilePicker label={copy.choose} name={copy.choose} hint={copy.hint} accept="video/*,.mkv,.mov,.mp4,.webm" nameAttrs={{ 'data-file-name': true }} metaAttrs={{ 'data-file-meta': true }} inputAttrs={{ 'data-file': true }} />
				<video class="crop-video" data-video controls hidden></video>
				<canvas data-preview hidden></canvas>
			</ToolPanel>
			<ToolPanel title={copy.settings}>
				<label class="tool-range-control"><span>{copy.sensitivity}: <strong data-threshold-label>24</strong></span><input data-threshold type="range" min="8" max="60" step="1" value="24" /></label>
				<SelectControl label={copy.output} selectAttrs={{ 'data-output': true }}><option value="mp4">MP4</option><option value="webm">WebM</option></SelectControl>
				<ToolActions><button class="button secondary" data-analyze type="button" disabled>{copy.analyze}</button><button class="button primary" data-crop type="button" disabled>{copy.crop}</button><button class="button secondary" data-clear type="button">{copy.clear}</button></ToolActions>
				<ToolStatus data-status text={copy.waiting} />
			</ToolPanel>
			<ToolPanel class="result-panel" data-result-panel title={copy.result} hidden><p data-result-meta>{copy.waiting}</p><a class="tool-download-link" data-download href="#" download hidden>{copy.download}</a></ToolPanel>
		</div>
	</div>
</section>

<script>
	import { createFfmpegRuntime } from '../../lib/ffmpeg-runtime';
	import { formatBytes } from '../../lib/tools/format';

	for (const root of document.querySelectorAll('[data-crop-doctor]:not([data-bound])')) {
		root.dataset.bound = 'true';
		const copy = JSON.parse(root.dataset.copy || '{}');
		const fileInput = root.querySelector('[data-file]');
		const fileName = root.querySelector('[data-file-name]');
		const fileMeta = root.querySelector('[data-file-meta]');
		const video = root.querySelector('[data-video]');
		const preview = root.querySelector('[data-preview]');
		const threshold = root.querySelector('[data-threshold]');
		const thresholdLabel = root.querySelector('[data-threshold-label]');
		const output = root.querySelector('[data-output]');
		const analyzeButton = root.querySelector('[data-analyze]');
		const cropButton = root.querySelector('[data-crop]');
		const clearButton = root.querySelector('[data-clear]');
		const status = root.querySelector('[data-status]');
		const resultMeta = root.querySelector('[data-result-meta]');
		const resultPanel = root.querySelector('[data-result-panel]');
		const download = root.querySelector('[data-download]');
		let inputUrl = null;
		let outputUrl = null;
		let crop = null;
		const runtime = createFfmpegRuntime({ timeoutMessage: copy.timeout, onLoading: () => setStatus(copy.loading, 'info'), onReady: () => setStatus(copy.ready, 'success'), onProgress: (progress) => setStatus(format(copy.progress, { progress }), 'info') });

		fileInput.addEventListener('change', onFile);
		threshold.addEventListener('input', () => thresholdLabel.textContent = threshold.value);
		analyzeButton.addEventListener('click', () => void analyze());
		cropButton.addEventListener('click', () => void cropVideo());
		clearButton.addEventListener('click', reset);

		function onFile() {
			const file = fileInput.files?.[0];
			if (!file) return;
			if (inputUrl) URL.revokeObjectURL(inputUrl);
			if (outputUrl) URL.revokeObjectURL(outputUrl);
			outputUrl = null; download.hidden = true; resultPanel.hidden = true;
			inputUrl = URL.createObjectURL(file);
			video.src = inputUrl; video.hidden = false;
			fileName.textContent = file.name; fileMeta.textContent = `${formatBytes(file.size)} · ${file.type || 'video'}`;
			analyzeButton.disabled = false; cropButton.disabled = true; setStatus(format(copy.selected, { name: file.name }), 'success');
		}

		async function analyze() {
			setStatus(copy.analyzing, 'info');
			try {
				await waitForMetadata(video);
				video.currentTime = Math.min(Math.max(video.duration * 0.25, 0), 5);
				await new Promise((resolve) => video.addEventListener('seeked', resolve, { once: true }));
				preview.width = video.videoWidth; preview.height = video.videoHeight;
				const ctx = preview.getContext('2d', { willReadFrequently: true });
				ctx.drawImage(video, 0, 0);
				const data = ctx.getImageData(0, 0, preview.width, preview.height);
				crop = detectCrop(data, Number(threshold.value));
				ctx.strokeStyle = '#ff3b30'; ctx.lineWidth = Math.max(4, preview.width / 180); ctx.strokeRect(crop.x, crop.y, crop.w, crop.h);
				preview.hidden = false;
				const changed = crop.w < preview.width - 4 || crop.h < preview.height - 4;
				cropButton.disabled = !changed;
				setStatus(changed ? format(copy.detected, crop) : copy.none, changed ? 'success' : 'info');
			} catch (error) { setStatus(format(copy.error, { message: error?.message || copy.generic }), 'error'); }
		}

		async function cropVideo() {
			const file = fileInput.files?.[0];
			if (!file || !crop) return;
			setStatus(copy.processing, 'info');
			try {
				const ext = output.value;
				const bytes = await runtime.run(async (ffmpeg) => {
					const stamp = `${Date.now()}-${Math.random().toString(16).slice(2)}`;
					const input = `input-${stamp}${extension(file.name)}`;
					const out = `crop-${stamp}.${ext}`;
					await ffmpeg.writeFile(input, new Uint8Array(await file.arrayBuffer()));
					try {
						const args = ['-i', input, '-vf', `crop=${crop.w}:${crop.h}:${crop.x}:${crop.y},setsar=1`];
						if (ext === 'webm') args.push('-c:v', 'libvpx-vp9', '-b:v', '0', '-crf', '34', '-c:a', 'libopus');
						else args.push('-c:v', 'libx264', '-crf', '23', '-preset', 'veryfast', '-c:a', 'aac', '-b:a', '128k', '-movflags', '+faststart');
						args.push('-y', out);
						const code = await ffmpeg.exec(args);
						if (code !== 0) throw new Error(`FFmpeg exited with code ${code}`);
						const result = await ffmpeg.readFile(out);
						return result instanceof Uint8Array ? result : new TextEncoder().encode(String(result));
					} finally { await ffmpeg.deleteFile(input).catch(() => {}); await ffmpeg.deleteFile(out).catch(() => {}); }
				});
				if (outputUrl) URL.revokeObjectURL(outputUrl);
				const blob = new Blob([bytes], { type: ext === 'webm' ? 'video/webm' : 'video/mp4' });
				outputUrl = URL.createObjectURL(blob);
				download.href = outputUrl; download.download = `${baseName(file.name)}-cropped.${ext}`; download.hidden = false; resultMeta.textContent = `${download.download} · ${formatBytes(blob.size)}`;
				resultPanel.hidden = false;
				setStatus(copy.done, 'success');
			} catch (error) { setStatus(format(copy.error, { message: error?.message || copy.generic }), 'error'); }
		}

		function detectCrop(imageData, limit) {
			const { width, height, data } = imageData;
			const dark = (x, y) => { const i = (y * width + x) * 4; return data[i] < limit && data[i + 1] < limit && data[i + 2] < limit; };
			const rowDark = (y) => { let hits = 0; for (let x = 0; x < width; x += 8) if (dark(x, y)) hits++; return hits / Math.ceil(width / 8) > 0.92; };
			const colDark = (x) => { let hits = 0; for (let y = 0; y < height; y += 8) if (dark(x, y)) hits++; return hits / Math.ceil(height / 8) > 0.92; };
			let top = 0, bottom = height - 1, left = 0, right = width - 1;
			while (top < height / 2 && rowDark(top)) top++;
			while (bottom > height / 2 && rowDark(bottom)) bottom--;
			while (left < width / 2 && colDark(left)) left++;
			while (right > width / 2 && colDark(right)) right--;
			const even = (v) => Math.max(2, Math.floor(v / 2) * 2);
			return { x: even(left), y: even(top), w: even(right - left + 1), h: even(bottom - top + 1) };
		}
		function waitForMetadata(media) {
			if (media.readyState >= 1) return Promise.resolve();
			if (media.error) return Promise.reject(new Error(media.error.message || copy.generic));
			return new Promise((resolve, reject) => {
				media.addEventListener('loadedmetadata', resolve, { once: true });
				media.addEventListener('error', () => reject(new Error(media.error?.message || copy.generic)), { once: true });
			});
		}
		function reset() { fileInput.value = ''; fileName.textContent = copy.choose; fileMeta.textContent = copy.hint; video.hidden = true; video.removeAttribute('src'); preview.hidden = true; analyzeButton.disabled = true; cropButton.disabled = true; download.hidden = true; resultPanel.hidden = true; resultMeta.textContent = copy.waiting; for (const url of [inputUrl, outputUrl]) if (url) URL.revokeObjectURL(url); inputUrl = outputUrl = null; crop = null; setStatus(copy.waiting, 'info'); }
		function setStatus(message, state) { status.textContent = message; status.dataset.state = state; }
		function format(template, values) { return Object.entries(values).reduce((text, [key, value]) => text.replace(`{${key}}`, String(value)), template); }
		function extension(name) { const match = String(name).match(/\.[^.]+$/); return match ? match[0] : '.bin'; }
		function baseName(name) { return String(name).replace(/\.[^.]+$/, '') || 'video'; }
	}
</script>

<style>
	.crop-doctor { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
	.crop-doctor .result-panel { grid-column: 1 / -1; }
	.crop-doctor [hidden] { display: none !important; }
	.crop-video, .crop-doctor canvas { width: 100%; margin-top: 14px; border-radius: 6px; background: #000; }
	@media (max-width: 860px) { .crop-doctor { grid-template-columns: 1fr; } }
</style>
