---
import type { Locale } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const copyByLocale = {
	de: {
		eyebrow: 'Creator-Tool',
		title: 'VTuber-Vorschau',
		intro: 'Verbinde deine Webcam und teste, wie Bewegung auf einen einfachen 3D-Avatar reagiert.',
		privacy: 'Die Kamera bleibt lokal im Browser. Es wird kein Video hochgeladen oder gespeichert.',
		avatarTitle: '3D-Avatar',
		cameraTitle: 'Kamera',
		trackingTitle: 'Tracking',
		start: 'Kamera starten',
		stop: 'Stoppen',
		reset: 'Neutral',
		showCamera: 'Kamera anzeigen',
		motionLabel: 'Gesichtsaktivität',
		xLabel: 'Links/Rechts',
		yLabel: 'Hoch/Runter',
		sensitivityLabel: 'Empfindlichkeit',
		smoothingLabel: 'Glättung',
		expressionLabel: 'Ausdruck',
		client: {
			cameraHidden: 'Kameravorschau ausgeblendet',
			cameraIdle: 'Kamera aus',
			cameraStarting: 'Kamerazugriff wird angefragt...',
			cameraStopped: 'Kamera gestoppt.',
			loadingTracker: 'Face-Landmark-Tracking wird geladen...',
			loadingScene: '3D-Szene wird geladen...',
			noCamera: 'Dieser Browser stellt keine Webcam-API bereit.',
			noFace: 'Kein Gesicht erkannt.',
			notSecure: 'Webcam-Zugriff braucht HTTPS oder localhost.',
			permissionError: 'Kamerazugriff wurde blockiert oder es wurde keine Kamera gefunden.',
			ready: '3D-Szene bereit.',
			renderError: 'Die 3D-Szene konnte nicht gestartet werden: {message}',
			trackerError: 'Das Face-Landmark-Tracking konnte nicht gestartet werden: {message}',
			reset: 'Avatar neutralisiert.',
			sceneMissing: 'Die 3D-Szene ist noch nicht bereit.',
			trackingLive: 'Tracking live.',
			unknownError: 'Unbekannter Fehler',
			expressionIdle: 'Neutral',
			expressionSoft: 'Leicht',
			expressionActive: 'Aktiv',
			expressionHigh: 'Stark',
			percent: '{value}%',
			axis: '{value}',
		},
	},
	en: {
		eyebrow: 'Creator tool',
		title: 'VTuber Preview',
		intro: 'Connect your webcam and test how movement reacts on a simple 3D avatar.',
		privacy: 'The camera stays local in your browser. No video is uploaded or stored.',
		avatarTitle: '3D avatar',
		cameraTitle: 'Camera',
		trackingTitle: 'Tracking',
		start: 'Start camera',
		stop: 'Stop',
		reset: 'Neutral',
		showCamera: 'Show camera',
		motionLabel: 'Face activity',
		xLabel: 'Left/right',
		yLabel: 'Up/down',
		sensitivityLabel: 'Sensitivity',
		smoothingLabel: 'Smoothing',
		expressionLabel: 'Expression',
		client: {
			cameraHidden: 'Camera preview hidden',
			cameraIdle: 'Camera off',
			cameraStarting: 'Requesting camera access...',
			cameraStopped: 'Camera stopped.',
			loadingTracker: 'Loading face landmark tracker...',
			loadingScene: 'Loading 3D scene...',
			noCamera: 'This browser does not expose a webcam API.',
			noFace: 'No face detected.',
			notSecure: 'Webcam access needs HTTPS or localhost.',
			permissionError: 'Camera access was blocked or no camera was found.',
			ready: '3D scene ready.',
			renderError: 'The 3D scene could not start: {message}',
			trackerError: 'The face landmark tracker could not start: {message}',
			reset: 'Avatar reset.',
			sceneMissing: 'The 3D scene is not ready yet.',
			trackingLive: 'Tracking live.',
			unknownError: 'Unknown error',
			expressionIdle: 'Neutral',
			expressionSoft: 'Soft',
			expressionActive: 'Active',
			expressionHigh: 'High',
			percent: '{value}%',
			axis: '{value}',
		},
	},
} satisfies Record<Locale, Record<string, unknown> & { client: Record<string, string> }>;

const copy = copyByLocale[locale];
const copyJson = JSON.stringify(copy.client);
---

<section class="tool-intro">
	<div class="container">
		<p class="eyebrow">{copy.eyebrow}</p>
		<h1>{copy.title}</h1>
		<p class="tool-lede">{copy.intro}</p>
		<p class="tool-note">{copy.privacy}</p>
	</div>
</section>

<section class="section vtuber-preview-section tool-workspace">
	<div class="container">
		<div class="vtuber-preview" data-vtuber-preview data-copy={copyJson}>
			<section class="vtuber-stage" aria-labelledby="vtuber-avatar-heading">
				<div class="vtuber-stage-heading">
					<h2 id="vtuber-avatar-heading">{copy.avatarTitle}</h2>
					<p data-scene-label>{copy.client.loadingScene}</p>
				</div>
				<div class="vtuber-canvas-frame">
					<canvas data-avatar-canvas aria-label={copy.avatarTitle}></canvas>
					<span class="render-badge" data-render-badge>{copy.client.loadingScene}</span>
				</div>
			</section>

			<div class="vtuber-side">
				<section class="tool-panel camera-panel" aria-labelledby="vtuber-camera-heading">
					<h2 id="vtuber-camera-heading">{copy.cameraTitle}</h2>
					<div class="camera-frame" data-camera-frame>
						<video data-camera-video playsinline muted hidden></video>
						<canvas data-tracking-overlay hidden></canvas>
						<div class="camera-placeholder" data-camera-placeholder>{copy.client.cameraIdle}</div>
					</div>
					<div class="tool-actions">
						<button class="button primary" data-start-camera type="button">{copy.start}</button>
						<button class="button secondary" data-stop-camera type="button" disabled>{copy.stop}</button>
						<button class="button secondary" data-reset-avatar type="button">{copy.reset}</button>
					</div>
					<label class="toggle-control">
						<input data-show-camera type="checkbox" checked />
						<span>{copy.showCamera}</span>
					</label>
					<p class="tool-status" data-status>{copy.client.loadingScene}</p>
				</section>

				<section class="tool-panel tracking-panel" aria-labelledby="vtuber-tracking-heading">
					<h2 id="vtuber-tracking-heading">{copy.trackingTitle}</h2>
					<div class="tracking-readout">
						<div class="metric-row">
							<span>{copy.motionLabel}</span>
							<meter data-motion-meter min="0" max="1" value="0"></meter>
							<strong data-motion-value>0%</strong>
						</div>
						<div class="metric-row">
							<span>{copy.xLabel}</span>
							<meter data-x-meter min="-1" max="1" value="0"></meter>
							<strong data-x-value>0</strong>
						</div>
						<div class="metric-row">
							<span>{copy.yLabel}</span>
							<meter data-y-meter min="-1" max="1" value="0"></meter>
							<strong data-y-value>0</strong>
						</div>
					</div>
					<label class="tool-range-control">
						<span>{copy.sensitivityLabel}: <strong data-sensitivity-value>65%</strong></span>
						<input data-sensitivity type="range" min="20" max="120" step="5" value="65" />
					</label>
					<label class="tool-range-control">
						<span>{copy.smoothingLabel}: <strong data-smoothing-value>55%</strong></span>
						<input data-smoothing type="range" min="10" max="90" step="5" value="55" />
					</label>
					<p class="expression-line">
						<span>{copy.expressionLabel}</span>
						<strong data-expression-value>{copy.client.expressionIdle}</strong>
					</p>
				</section>
			</div>
		</div>
	</div>
</section>

<script is:inline>
	(() => {
		const roots = document.querySelectorAll('[data-vtuber-preview]:not([data-vtuber-bound])');

		for (const root of roots) {
			root.dataset.vtuberBound = 'true';
			initVtuberPreview(root);
		}

		function initVtuberPreview(root) {
			const copy = JSON.parse(root.dataset.copy || '{}');
			const avatarCanvas = root.querySelector('[data-avatar-canvas]');
			const renderBadge = root.querySelector('[data-render-badge]');
			const sceneLabel = root.querySelector('[data-scene-label]');
			const video = root.querySelector('[data-camera-video]');
			const trackingOverlay = root.querySelector('[data-tracking-overlay]');
			const cameraPlaceholder = root.querySelector('[data-camera-placeholder]');
			const status = root.querySelector('[data-status]');
			const startButton = root.querySelector('[data-start-camera]');
			const stopButton = root.querySelector('[data-stop-camera]');
			const resetButton = root.querySelector('[data-reset-avatar]');
			const showCameraInput = root.querySelector('[data-show-camera]');
			const sensitivityInput = root.querySelector('[data-sensitivity]');
			const smoothingInput = root.querySelector('[data-smoothing]');
			const sensitivityValue = root.querySelector('[data-sensitivity-value]');
			const smoothingValue = root.querySelector('[data-smoothing-value]');
			const motionMeter = root.querySelector('[data-motion-meter]');
			const xMeter = root.querySelector('[data-x-meter]');
			const yMeter = root.querySelector('[data-y-meter]');
			const motionValue = root.querySelector('[data-motion-value]');
			const xValue = root.querySelector('[data-x-value]');
			const yValue = root.querySelector('[data-y-value]');
			const expressionValue = root.querySelector('[data-expression-value]');
			const overlayContext = trackingOverlay.getContext('2d');
			const tracking = { x: 0, y: 0, roll: 0, energy: 0 };
			const target = { x: 0, y: 0, roll: 0, energy: 0 };
			const threeUrl = 'https://cdn.jsdelivr.net/npm/three@0.166.1/build/three.module.js';
			const visionUrl = 'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/+esm';
			const visionWasmUrl = 'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm';
			const faceModelUrl = 'https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task';
			const driverLandmarkIndexes = {
				forehead: 10,
				leftEye: 33,
				rightEye: 263,
				nose: 1,
				mouthLeft: 61,
				mouthRight: 291,
				mouthTop: 13,
				mouthBottom: 14,
				chin: 152,
			};

			let stream = null;
			let faceLandmarker = null;
			let processFrameId = 0;
			let renderFrameId = 0;
			let renderer = null;
			let scene = null;
			let camera = null;
			let model = null;
			let resizeObserver = null;
			let sceneReady = false;
			let sceneFailed = false;
			let trackerReady = false;
			let lastVideoTime = -1;

			const scenePromise = initScene();
			const trackerPromise = initFaceTracker();

			startButton.addEventListener('click', startCamera);
			stopButton.addEventListener('click', () => stopCamera());
			resetButton.addEventListener('click', () => {
				resetMotion();
				setStatus(copy.reset, 'success');
			});
			showCameraInput.addEventListener('change', syncCameraVisibility);
			sensitivityInput.addEventListener('input', updateRangeLabels);
			smoothingInput.addEventListener('input', updateRangeLabels);
			window.addEventListener('pagehide', cleanup);
			window.addEventListener('resize', resizeTrackingOverlay);

			updateRangeLabels();
			updateReadout();

			async function initScene() {
				setStatus(copy.loadingScene);

				try {
					const THREE = await import(/* @vite-ignore */ threeUrl);
					renderer = new THREE.WebGLRenderer({
						canvas: avatarCanvas,
						antialias: true,
						alpha: true,
					});
					renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
					renderer.outputColorSpace = THREE.SRGBColorSpace;

					scene = new THREE.Scene();
					camera = new THREE.PerspectiveCamera(34, 16 / 10, 0.1, 100);
					camera.position.set(0, 0.35, 6.2);

					const ambient = new THREE.HemisphereLight(0xfff3e8, 0x5e7b86, 2.8);
					const key = new THREE.DirectionalLight(0xffffff, 2.4);
					const rim = new THREE.DirectionalLight(0x77d8ff, 1.35);
					key.position.set(3.8, 4.5, 4.5);
					rim.position.set(-4, 2.5, -2.5);
					scene.add(ambient, key, rim);

					model = createAvatarModel(THREE);
					scene.add(model.root);

					resizeObserver = new ResizeObserver(resizeRenderer);
					resizeObserver.observe(avatarCanvas.parentElement);
					resizeRenderer();
					sceneReady = true;
					renderBadge.hidden = true;
					sceneLabel.textContent = copy.ready;
					setStatus(copy.ready, 'success');
					renderLoop();
				} catch (error) {
					const message = error instanceof Error ? error.message : copy.unknownError;
					sceneFailed = true;
					sceneLabel.textContent = format(copy.renderError, { message });
					renderBadge.textContent = copy.sceneMissing;
					setStatus(format(copy.renderError, { message }), 'error');
				}
			}

			async function initFaceTracker() {
				setStatus(copy.loadingTracker);

				try {
					const { FaceLandmarker, FilesetResolver } = await import(/* @vite-ignore */ visionUrl);
					const vision = await FilesetResolver.forVisionTasks(visionWasmUrl);
					faceLandmarker = await createFaceLandmarker(FaceLandmarker, vision, 'GPU').catch(() =>
						createFaceLandmarker(FaceLandmarker, vision, 'CPU'),
					);
					trackerReady = true;
					/* A dead 3D scene is the headline: the tracker finishing later must not bury it
					   under a "loading the scene" line that will never resolve. */
					if (!sceneFailed) {
						setStatus(sceneReady ? copy.ready : copy.loadingScene, sceneReady ? 'success' : '');
					}
				} catch (error) {
					const message = error instanceof Error ? error.message : copy.unknownError;
					setStatus(format(copy.trackerError, { message }), 'error');
				}
			}

			function createFaceLandmarker(FaceLandmarker, vision, delegate) {
				return FaceLandmarker.createFromOptions(vision, {
					baseOptions: {
						modelAssetPath: faceModelUrl,
						delegate,
					},
					runningMode: 'VIDEO',
					numFaces: 1,
					minFaceDetectionConfidence: 0.5,
					minFacePresenceConfidence: 0.5,
					minTrackingConfidence: 0.5,
					outputFaceBlendshapes: true,
					outputFacialTransformationMatrixes: true,
				});
			}

			async function startCamera() {
				if (!navigator.mediaDevices?.getUserMedia) {
					setStatus(copy.noCamera, 'error');
					return;
				}

				if (!window.isSecureContext && !/^(localhost|127\.0\.0\.1)$/.test(window.location.hostname)) {
					setStatus(copy.notSecure, 'error');
					return;
				}

				startButton.disabled = true;

				try {
					await Promise.all([scenePromise, trackerPromise]);

					if (!sceneReady || !trackerReady) {
						setStatus(copy.sceneMissing, 'error');
						startButton.disabled = false;
						return;
					}

					setStatus(copy.cameraStarting);
					stream = await navigator.mediaDevices.getUserMedia({
						audio: false,
						video: {
							width: { ideal: 1280 },
							height: { ideal: 720 },
							facingMode: 'user',
						},
					});
					video.srcObject = stream;
					await video.play();
					lastVideoTime = -1;
					resizeTrackingOverlay();
					stopButton.disabled = false;
					syncCameraVisibility();
					setStatus(copy.trackingLive, 'success');
					processLoop();
				} catch (error) {
					const isPermissionError = error instanceof DOMException && ['AbortError', 'NotAllowedError', 'NotFoundError', 'NotReadableError'].includes(error.name);
					setStatus(isPermissionError ? copy.permissionError : error instanceof Error ? error.message : copy.unknownError, 'error');
					startButton.disabled = false;
					stopCamera(false);
				}
			}

			function stopCamera(announceStatus = true) {
				if (processFrameId) {
					cancelAnimationFrame(processFrameId);
					processFrameId = 0;
				}

				if (stream) {
					for (const track of stream.getTracks()) {
						track.stop();
					}
				}

				stream = null;
				video.pause();
				video.srcObject = null;
				lastVideoTime = -1;
				resetMotion();
				clearTrackingOverlay();
				startButton.disabled = false;
				stopButton.disabled = true;
				syncCameraVisibility();

				if (sceneReady && announceStatus) {
					setStatus(copy.cameraStopped);
				}
			}

			function cleanup() {
				stopCamera(false);

				if (renderFrameId) {
					cancelAnimationFrame(renderFrameId);
					renderFrameId = 0;
				}

				if (resizeObserver) {
					resizeObserver.disconnect();
					resizeObserver = null;
				}

				window.removeEventListener('resize', resizeTrackingOverlay);
			}

			function syncCameraVisibility() {
				const isActive = Boolean(stream);
				const showCamera = Boolean(showCameraInput.checked);
				video.hidden = !isActive || !showCamera;
				trackingOverlay.hidden = !isActive || !showCamera;
				cameraPlaceholder.hidden = isActive && showCamera;
				cameraPlaceholder.textContent = isActive && !showCamera ? copy.cameraHidden : copy.cameraIdle;

				if (isActive && showCamera) {
					resizeTrackingOverlay();
				}
			}

			function processLoop() {
				readMotionFrame();
				processFrameId = requestAnimationFrame(processLoop);
			}

			function readMotionFrame() {
				if (!stream || video.readyState < HTMLMediaElement.HAVE_CURRENT_DATA) {
					return;
				}

				if (!faceLandmarker || video.currentTime === lastVideoTime) {
					return;
				}

				lastVideoTime = video.currentTime;
				const results = faceLandmarker.detectForVideo(video, performance.now());
				const landmarks = results.faceLandmarks && results.faceLandmarks[0];

				if (landmarks) {
					applyFaceLandmarks(landmarks, results.faceBlendshapes && results.faceBlendshapes[0]);
					drawTrackingOverlay(landmarks);
				} else {
					target.x *= 0.88;
					target.y *= 0.88;
					target.roll *= 0.88;
					target.energy *= 0.82;
					clearTrackingOverlay();
				}

				updateTracking();
				updateReadout();
			}

			function applyFaceLandmarks(landmarks, blendshapes) {
				const sensitivity = Number(sensitivityInput.value) / 65;
				const forehead = landmarks[driverLandmarkIndexes.forehead];
				const leftEye = landmarks[driverLandmarkIndexes.leftEye];
				const rightEye = landmarks[driverLandmarkIndexes.rightEye];
				const nose = landmarks[driverLandmarkIndexes.nose];
				const mouthLeft = landmarks[driverLandmarkIndexes.mouthLeft];
				const mouthRight = landmarks[driverLandmarkIndexes.mouthRight];
				const mouthTop = landmarks[driverLandmarkIndexes.mouthTop];
				const mouthBottom = landmarks[driverLandmarkIndexes.mouthBottom];
				const chin = landmarks[driverLandmarkIndexes.chin];
				const faceHeight = Math.max(0.001, distance(forehead, chin));
				const mouthWidth = Math.max(0.001, distance(mouthLeft, mouthRight));
				const mouthOpen = clamp(distance(mouthTop, mouthBottom) / mouthWidth * 4.2, 0, 1);
				const centerX = (forehead.x + nose.x + chin.x) / 3;
				const centerY = (forehead.y + nose.y + chin.y) / 3;
				const eyeRoll = Math.atan2(rightEye.y - leftEye.y, rightEye.x - leftEye.x);
				const blendshapeScores = getBlendshapeScores(blendshapes);
				const jawOpen = blendshapeScores.jawOpen ?? 0;
				const smile = Math.max(blendshapeScores.mouthSmileLeft ?? 0, blendshapeScores.mouthSmileRight ?? 0);
				const brow = blendshapeScores.browInnerUp ?? 0;
				const expression = clamp(Math.max(mouthOpen, jawOpen, smile * 0.9, brow * 0.7), 0, 1);

				target.x = clamp((0.5 - centerX) * 2.4 * sensitivity, -1, 1);
				target.y = clamp((0.5 - centerY) * 2.1 * sensitivity, -1, 1);
				target.roll = clamp(-eyeRoll * 2.8, -1, 1);
				target.energy = expression;
			}

			function updateTracking() {
				const smoothing = Number(smoothingInput.value) / 100;
				const follow = clamp(1 - smoothing, 0.1, 0.9);
				tracking.x += (target.x - tracking.x) * follow;
				tracking.y += (target.y - tracking.y) * follow;
				tracking.roll += (target.roll - tracking.roll) * follow;
				tracking.energy += (target.energy - tracking.energy) * follow;
			}

			function resetMotion() {
				target.x = 0;
				target.y = 0;
				target.roll = 0;
				target.energy = 0;
				tracking.x = 0;
				tracking.y = 0;
				tracking.roll = 0;
				tracking.energy = 0;
				updateReadout();
			}

			function updateReadout() {
				const energyPercent = Math.round(tracking.energy * 100);
				const xAxis = Math.round(tracking.x * 100);
				const yAxis = Math.round(tracking.y * 100);
				motionMeter.value = tracking.energy;
				xMeter.value = tracking.x;
				yMeter.value = tracking.y;
				motionValue.textContent = format(copy.percent, { value: energyPercent });
				xValue.textContent = format(copy.axis, { value: xAxis });
				yValue.textContent = format(copy.axis, { value: yAxis });
				expressionValue.textContent =
					tracking.energy > 0.7
						? copy.expressionHigh
						: tracking.energy > 0.36
							? copy.expressionActive
							: tracking.energy > 0.12
								? copy.expressionSoft
								: copy.expressionIdle;
			}

			function updateRangeLabels() {
				sensitivityValue.textContent = format(copy.percent, { value: sensitivityInput.value });
				smoothingValue.textContent = format(copy.percent, { value: smoothingInput.value });
			}

			function renderLoop(time = 0) {
				if (!renderer || !scene || !camera || !model) {
					return;
				}

				applyAvatarPose(time / 1000);
				renderer.render(scene, camera);
				renderFrameId = requestAnimationFrame(renderLoop);
			}

			function applyAvatarPose(time) {
				const breath = Math.sin(time * 1.7) * 0.025;
				const spark = tracking.energy * 0.08;
				model.root.position.y = -0.15 + breath + spark;
				model.root.rotation.y = tracking.x * 0.18;
				model.torso.rotation.z = -tracking.x * 0.12;
				model.torso.rotation.x = tracking.y * 0.05;
				model.head.rotation.y = tracking.x * 0.8;
				model.head.rotation.x = -tracking.y * 0.48;
				model.head.rotation.z = tracking.roll * 0.36 - tracking.x * 0.1;
				model.leftArm.rotation.z = 0.34 + tracking.energy * 0.82 - tracking.x * 0.22;
				model.rightArm.rotation.z = -0.34 - tracking.energy * 0.82 - tracking.x * 0.22;
				model.leftArm.rotation.x = -0.08 - tracking.y * 0.22;
				model.rightArm.rotation.x = -0.08 - tracking.y * 0.22;
				model.mouth.scale.y = 1 + tracking.energy * 5.8;
				model.mouth.scale.x = 1 + tracking.energy * 0.65;
				model.faceLight.intensity = 0.8 + tracking.energy * 1.8;
				camera.position.x = tracking.x * 0.22;
				camera.position.y = 0.35 + tracking.y * 0.08;
				camera.lookAt(0, 0.05, 0);
			}

			function drawTrackingOverlay(landmarks) {
				resizeTrackingOverlay();
				const width = trackingOverlay.clientWidth;
				const height = trackingOverlay.clientHeight;
				const driverIndexes = Object.values(driverLandmarkIndexes);

				overlayContext.clearRect(0, 0, width, height);
				overlayContext.lineWidth = 1.5;

				for (const point of landmarks) {
					drawPoint(point, width, height, 1.6, 'rgba(255, 255, 255, 0.34)');
				}

				overlayContext.strokeStyle = 'rgba(255, 122, 26, 0.86)';
				overlayContext.beginPath();
				for (const index of driverIndexes) {
					const point = landmarks[index];
					const x = (1 - point.x) * width;
					const y = point.y * height;
					overlayContext.moveTo(x + 7, y);
					overlayContext.arc(x, y, 7, 0, Math.PI * 2);
				}
				overlayContext.stroke();

				for (const index of driverIndexes) {
					drawPoint(landmarks[index], width, height, 4.2, 'rgba(255, 122, 26, 0.98)');
				}
			}

			function clearTrackingOverlay() {
				overlayContext.clearRect(0, 0, trackingOverlay.clientWidth, trackingOverlay.clientHeight);
			}

			function resizeTrackingOverlay() {
				const rect = trackingOverlay.getBoundingClientRect();
				const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
				const width = Math.max(1, Math.round(rect.width * pixelRatio));
				const height = Math.max(1, Math.round(rect.height * pixelRatio));

				if (trackingOverlay.width !== width || trackingOverlay.height !== height) {
					trackingOverlay.width = width;
					trackingOverlay.height = height;
					overlayContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
				}
			}

			function drawPoint(point, width, height, radius, fillStyle) {
				overlayContext.fillStyle = fillStyle;
				overlayContext.beginPath();
				overlayContext.arc((1 - point.x) * width, point.y * height, radius, 0, Math.PI * 2);
				overlayContext.fill();
			}

			function resizeRenderer() {
				if (!renderer || !camera) {
					return;
				}

				const rect = avatarCanvas.parentElement.getBoundingClientRect();

				if (!rect.width || !rect.height) {
					return;
				}

				renderer.setSize(Math.floor(rect.width), Math.floor(rect.height), false);
				camera.aspect = rect.width / rect.height;
				camera.updateProjectionMatrix();
			}

			function setStatus(message, state = '') {
				status.textContent = message;
				status.dataset.state = state;
			}

			function format(template, values) {
				return Object.entries(values).reduce(
					(result, [key, value]) => result.replace(`{${key}}`, String(value)),
					template,
				);
			}

			function clamp(value, min, max) {
				return Math.min(max, Math.max(min, value));
			}

			function distance(first, second) {
				return Math.hypot(first.x - second.x, first.y - second.y);
			}

			function getBlendshapeScores(blendshapes) {
				return Object.fromEntries((blendshapes?.categories || []).map((category) => [category.categoryName, category.score]));
			}

			function createAvatarModel(THREE) {
				const root = new THREE.Group();
				const torso = new THREE.Group();
				const head = new THREE.Group();
				const leftArm = new THREE.Group();
				const rightArm = new THREE.Group();
				const skin = new THREE.MeshStandardMaterial({ color: 0xffc7a8, roughness: 0.72 });
				const blush = new THREE.MeshStandardMaterial({ color: 0xff8f8f, roughness: 0.8 });
				const hair = new THREE.MeshStandardMaterial({ color: 0x30223a, roughness: 0.58 });
				const jacket = new THREE.MeshStandardMaterial({ color: 0x1f8a8a, roughness: 0.62, metalness: 0.03 });
				const shirt = new THREE.MeshStandardMaterial({ color: 0xf7f1ea, roughness: 0.65 });
				const accent = new THREE.MeshStandardMaterial({ color: 0xff7a1a, roughness: 0.52 });
				const ink = new THREE.MeshStandardMaterial({ color: 0x17120f, roughness: 0.5 });
				const mouthMaterial = new THREE.MeshStandardMaterial({
					color: 0xb83a4a,
					roughness: 0.45,
					emissive: 0x3a0710,
					emissiveIntensity: 0.18,
				});

				torso.position.y = -0.75;
				root.add(torso);

				const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.58, 0.74, 12, 32), jacket);
				body.scale.set(1.18, 1.08, 0.58);
				torso.add(body);

				const shirtPanel = new THREE.Mesh(new THREE.BoxGeometry(0.44, 0.72, 0.035), shirt);
				shirtPanel.position.set(0, 0.08, 0.36);
				torso.add(shirtPanel);

				const tie = new THREE.Mesh(new THREE.ConeGeometry(0.12, 0.42, 4), accent);
				tie.position.set(0, -0.06, 0.4);
				tie.rotation.y = Math.PI / 4;
				torso.add(tie);

				const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.18, 0.24, 24), skin);
				neck.position.y = -0.1;
				root.add(neck);

				head.position.y = 0.48;
				root.add(head);

				const face = new THREE.Mesh(new THREE.SphereGeometry(0.68, 40, 32), skin);
				face.scale.set(0.95, 1.08, 0.86);
				head.add(face);

				const hairBack = new THREE.Mesh(new THREE.SphereGeometry(0.71, 40, 24), hair);
				hairBack.position.set(0, 0.12, -0.12);
				hairBack.scale.set(1.02, 0.82, 0.88);
				head.add(hairBack);

				const hairCap = new THREE.Mesh(new THREE.SphereGeometry(0.7, 40, 16, 0, Math.PI * 2, 0, Math.PI * 0.55), hair);
				hairCap.position.y = 0.2;
				hairCap.rotation.x = -0.16;
				hairCap.scale.set(1.04, 0.78, 0.94);
				head.add(hairCap);

				for (const [x, rotation] of [[-0.26, -0.5], [0, 0.08], [0.24, 0.52]]) {
					const bang = new THREE.Mesh(new THREE.ConeGeometry(0.13, 0.48, 18), hair);
					bang.position.set(x, 0.18, 0.53);
					bang.rotation.set(0.22, 0, rotation);
					head.add(bang);
				}

				for (const x of [-0.23, 0.23]) {
					const eye = new THREE.Mesh(new THREE.SphereGeometry(0.055, 20, 16), ink);
					eye.position.set(x, 0.02, 0.59);
					eye.scale.y = 1.35;
					head.add(eye);

					const cheek = new THREE.Mesh(new THREE.SphereGeometry(0.05, 16, 12), blush);
					cheek.position.set(x * 1.35, -0.15, 0.57);
					cheek.scale.set(1.55, 0.45, 0.16);
					head.add(cheek);
				}

				const nose = new THREE.Mesh(new THREE.ConeGeometry(0.035, 0.14, 16), skin);
				nose.position.set(0, -0.06, 0.64);
				nose.rotation.x = Math.PI / 2;
				head.add(nose);

				const mouth = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.025, 0.025), mouthMaterial);
				mouth.position.set(0, -0.27, 0.62);
				head.add(mouth);

				const faceLight = new THREE.PointLight(0xff8a42, 0.8, 3);
				faceLight.position.set(0, -0.05, 1.2);
				head.add(faceLight);

				for (const [arm, side] of [[leftArm, -1], [rightArm, 1]]) {
					arm.position.set(side * 0.68, -0.38, 0);
					torso.add(arm);

					const sleeve = new THREE.Mesh(new THREE.CapsuleGeometry(0.105, 0.7, 8, 18), jacket);
					sleeve.position.y = -0.34;
					sleeve.rotation.z = side * 0.14;
					arm.add(sleeve);

					const hand = new THREE.Mesh(new THREE.SphereGeometry(0.13, 20, 16), skin);
					hand.position.set(side * 0.08, -0.76, 0.02);
					arm.add(hand);
				}

				const base = new THREE.Mesh(new THREE.CylinderGeometry(0.95, 1.12, 0.08, 48), new THREE.MeshStandardMaterial({ color: 0x2f3e46, roughness: 0.7 }));
				base.position.y = -1.63;
				root.add(base);

				root.traverse((part) => {
					if (part.isMesh) {
						part.castShadow = true;
						part.receiveShadow = true;
					}
				});

				return { root, torso, head, leftArm, rightArm, mouth, faceLight };
			}
		}
	})();
</script>

