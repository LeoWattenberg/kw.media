---
import type { Locale } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const positions = [
	{ value: 'top-left', label: { de: 'Oben links', en: 'Top left' } },
	{ value: 'top-center', label: { de: 'Oben mittig', en: 'Top center' } },
	{ value: 'top-right', label: { de: 'Oben rechts', en: 'Top right' } },
	{ value: 'center-left', label: { de: 'Mitte links', en: 'Center left' } },
	{ value: 'center', label: { de: 'Mitte', en: 'Center' } },
	{ value: 'center-right', label: { de: 'Mitte rechts', en: 'Center right' } },
	{ value: 'bottom-left', label: { de: 'Unten links', en: 'Bottom left' } },
	{ value: 'bottom-center', label: { de: 'Unten mittig', en: 'Bottom center' } },
	{ value: 'bottom-right', label: { de: 'Unten rechts', en: 'Bottom right' } },
];

const copyByLocale = {
	de: {
		eyebrow: 'Text- & Bild-Overlays',
		title: 'Bild- & Video-Wasserzeichen',
		intro: 'Lege eigene Text- oder Bild-Wasserzeichen über lokale Bilder und Videos. Bilder werden per Canvas verarbeitet, Videos per FFmpeg wasm.',
		privacy: 'Deine Datei wird nicht hochgeladen. Die Verarbeitung läuft clientseitig in deinem Browser.',
		sourceTitle: 'Quelldatei',
		chooseSource: 'Bild oder Video auswählen',
		sourceHint: 'PNG, JPEG, WebP, GIF, MP4, WebM, MOV und weitere Browser-/FFmpeg-kompatible Formate',
		animatedGif: 'Animierte GIFs werden als Einzelbild exportiert. Die Ausgabe enthält nur das erste Bild.',
		watermarkTitle: 'Wasserzeichen',
		modeLabel: 'Art',
		textMode: 'Text',
		imageMode: 'Bild',
		textLabel: 'Text',
		textPlaceholder: 'kw.media',
		colorLabel: 'Textfarbe',
		watermarkImage: 'Wasserzeichen-Bild',
		chooseWatermark: 'PNG oder anderes Bild auswählen',
		positionLabel: 'Position',
		opacityLabel: 'Deckkraft',
		sizeLabel: 'Größe',
		marginLabel: 'Abstand',
		tileLabel: 'Wiederholen',
		process: 'Wasserzeichen anwenden',
		clear: 'Zurücksetzen',
		resultTitle: 'Ergebnis',
		download: 'Datei herunterladen',
		sourcePreview: 'Vorschau',
		outputPreview: 'Ausgabe',
		client: {
			waiting: 'Wähle eine Bild- oder Videodatei aus, um zu starten.',
			sourceReady: '{name} ist ausgewählt ({size}).',
			watermarkReady: '{name} wird als Wasserzeichen verwendet.',
			needSource: 'Wähle zuerst eine Quelldatei.',
			needWatermark: 'Gib einen Text ein oder wähle ein Wasserzeichen-Bild.',
			metadataMissing: 'Die Abmessungen der Datei konnten nicht gelesen werden.',
			processingImage: 'Bild wird verarbeitet...',
			processingVideo: 'Video wird vorbereitet...',
			ffmpegLoading: 'FFmpeg wasm wird geladen...',
			ffmpegProgress: 'FFmpeg rendert... {progress}%',
			ffmpegReady: 'FFmpeg wasm ist bereit.',
			ffmpegTimeout: 'FFmpeg wasm hat nicht innerhalb von 90 Sekunden geladen.',
			imageReady: 'Das Bild wurde mit Wasserzeichen erzeugt.',
			videoReady: 'Das Video wurde mit Wasserzeichen erzeugt.',
			reset: 'Das Tool wurde zurückgesetzt.',
			meta: '{width} x {height}px | {size}',
			fileMeta: '{size} | {type}',
			outputImage: '{name}.png',
			outputVideo: '{name}.mp4',
			unknownError: 'Unbekannter Fehler',
		},
	},
	en: {
		eyebrow: 'Text & image overlays',
		title: 'Image & Video Watermark',
		intro: 'Place custom text or image watermarks over local images and videos. Images are processed with Canvas, videos with FFmpeg wasm.',
		privacy: 'Your file is not uploaded. Processing runs client-side in your browser.',
		sourceTitle: 'Source file',
		chooseSource: 'Choose image or video',
		sourceHint: 'PNG, JPEG, WebP, GIF, MP4, WebM, MOV, and other browser/FFmpeg-compatible formats',
		animatedGif: 'Animated GIFs are exported as a single frame. The output contains only the first frame.',
		watermarkTitle: 'Watermark',
		modeLabel: 'Type',
		textMode: 'Text',
		imageMode: 'Image',
		textLabel: 'Text',
		textPlaceholder: 'kw.media',
		colorLabel: 'Text color',
		watermarkImage: 'Watermark image',
		chooseWatermark: 'Choose PNG or another image',
		positionLabel: 'Position',
		opacityLabel: 'Opacity',
		sizeLabel: 'Size',
		marginLabel: 'Margin',
		tileLabel: 'Repeat',
		process: 'Apply watermark',
		clear: 'Reset',
		resultTitle: 'Result',
		download: 'Download file',
		sourcePreview: 'Preview',
		outputPreview: 'Output',
		client: {
			waiting: 'Choose an image or video file to start.',
			sourceReady: '{name} is selected ({size}).',
			watermarkReady: '{name} will be used as the watermark.',
			needSource: 'Choose a source file first.',
			needWatermark: 'Enter watermark text or choose a watermark image.',
			metadataMissing: 'The file dimensions could not be read.',
			processingImage: 'Processing image...',
			processingVideo: 'Preparing video...',
			ffmpegLoading: 'Loading FFmpeg wasm...',
			ffmpegProgress: 'FFmpeg is rendering... {progress}%',
			ffmpegReady: 'FFmpeg wasm is ready.',
			ffmpegTimeout: 'FFmpeg wasm did not finish loading within 90 seconds.',
			imageReady: 'The watermarked image is ready.',
			videoReady: 'The watermarked video is ready.',
			reset: 'The tool has been reset.',
			meta: '{width} x {height}px | {size}',
			fileMeta: '{size} | {type}',
			outputImage: '{name}.png',
			outputVideo: '{name}.mp4',
			unknownError: 'Unknown error',
		},
	},
} satisfies Record<Locale, Record<string, unknown> & { client: Record<string, string> }>;

const copy = copyByLocale[locale];
const copyJson = JSON.stringify(copy.client);
---

<section class="tool-intro">
	<div class="container">
		<p class="eyebrow">{copy.eyebrow}</p>
		<h1>{copy.title}</h1>
		<p class="tool-lede">{copy.intro}</p>
		<p class="tool-note">{copy.privacy}</p>
	</div>
</section>

<section class="section watermarker-section">
	<div class="container">
		<div class="watermarker-tool" data-watermarker data-copy={copyJson}>
			<div class="watermarker-grid">
				<section class="watermarker-panel">
					<h2>{copy.sourceTitle}</h2>
					<label class="file-picker">
						<span>{copy.sourceTitle}</span>
						<strong data-source-name>{copy.chooseSource}</strong>
						<small data-source-meta>{copy.sourceHint}</small>
						<input data-source-file type="file" accept="image/*,video/*,.mkv,.mov,.mp4,.webm,.avi,.m4v" />
					</label>
					<p class="source-note" data-animated-notice hidden>{copy.animatedGif}</p>
					<div class="preview-card" data-output-preview hidden>
						<div class="result-heading">
							<p>{copy.outputPreview}</p>
							<a class="button primary" data-download href="#" download hidden>{copy.download}</a>
						</div>
						<div class="preview-frame">
							<img data-output-image alt="" hidden />
							<video data-output-video controls playsinline hidden></video>
						</div>
						<small data-output-details></small>
					</div>
				</section>

				<section class="watermarker-panel settings-panel">
					<h2>{copy.watermarkTitle}</h2>
					<label class="select-control">
						<span>{copy.modeLabel}</span>
						<select data-mode>
							<option value="text">{copy.textMode}</option>
							<option value="image">{copy.imageMode}</option>
						</select>
					</label>
					<label class="text-control" data-text-group>
						<span>{copy.textLabel}</span>
						<input data-watermark-text type="text" value={copy.textPlaceholder} placeholder={copy.textPlaceholder} />
					</label>
					<label class="color-control" data-color-group>
						<span>{copy.colorLabel}</span>
						<input data-watermark-color type="color" value="#ffffff" />
					</label>
					<label class="file-picker watermark-file" data-image-group hidden>
						<span>{copy.watermarkImage}</span>
						<strong data-watermark-name>{copy.chooseWatermark}</strong>
						<small>{copy.chooseWatermark}</small>
						<input data-watermark-file type="file" accept="image/*,.avif,.bmp,.gif,.jpeg,.jpg,.png,.svg,.webp" />
					</label>
					<label class="select-control">
						<span>{copy.positionLabel}</span>
						<select data-position>
							{positions.map((position) => <option value={position.value}>{position.label[locale]}</option>)}
						</select>
					</label>
					<label class="range-control">
						<span>{copy.opacityLabel}: <strong data-opacity-label>55%</strong></span>
						<input data-opacity type="range" min="5" max="100" step="1" value="55" />
					</label>
					<label class="range-control">
						<span>{copy.sizeLabel}: <strong data-size-label>24%</strong></span>
						<input data-size type="range" min="5" max="60" step="1" value="24" />
					</label>
					<label class="range-control">
						<span>{copy.marginLabel}: <strong data-margin-label>4%</strong></span>
						<input data-margin type="range" min="0" max="20" step="1" value="4" />
					</label>
					<label class="toggle-control">
						<input data-tile type="checkbox" />
						<span>{copy.tileLabel}</span>
					</label>
					<div class="tool-actions">
						<button class="button primary" data-process type="button" disabled>{copy.process}</button>
						<button class="button secondary" data-clear type="button">{copy.clear}</button>
					</div>
					<p class="status" data-status role="status">{copy.client.waiting}</p>
				</section>
			</div>

		</div>
	</div>
</section>

<script>
	import { createFfmpegRuntime } from '../../lib/ffmpeg-runtime';
	import { formatBytes } from '../../lib/tools/format';
	import { isAnimatedGif, readPngSize } from '../../lib/tools/watermarker';

	(() => {
		const roots = document.querySelectorAll('[data-watermarker]:not([data-watermarker-bound])');

		for (const root of roots) {
			root.dataset.watermarkerBound = 'true';
			initWatermarker(root);
		}

		function initWatermarker(root) {
			const copy = JSON.parse(root.dataset.copy || '{}');
			const sourceInput = root.querySelector('[data-source-file]');
			const sourceName = root.querySelector('[data-source-name]');
			const sourceMeta = root.querySelector('[data-source-meta]');
			const animatedNotice = root.querySelector('[data-animated-notice]');
			const outputPreview = root.querySelector('[data-output-preview]');
			const modeSelect = root.querySelector('[data-mode]');
			const textGroup = root.querySelector('[data-text-group]');
			const colorGroup = root.querySelector('[data-color-group]');
			const imageGroup = root.querySelector('[data-image-group]');
			const textInput = root.querySelector('[data-watermark-text]');
			const colorInput = root.querySelector('[data-watermark-color]');
			const watermarkInput = root.querySelector('[data-watermark-file]');
			const watermarkName = root.querySelector('[data-watermark-name]');
			const positionSelect = root.querySelector('[data-position]');
			const opacityInput = root.querySelector('[data-opacity]');
			const opacityLabel = root.querySelector('[data-opacity-label]');
			const sizeInput = root.querySelector('[data-size]');
			const sizeLabel = root.querySelector('[data-size-label]');
			const marginInput = root.querySelector('[data-margin]');
			const marginLabel = root.querySelector('[data-margin-label]');
			const tileInput = root.querySelector('[data-tile]');
			const processButton = root.querySelector('[data-process]');
			const clearButton = root.querySelector('[data-clear]');
			const status = root.querySelector('[data-status]');
			const downloadLink = root.querySelector('[data-download]');
			const outputImage = root.querySelector('[data-output-image]');
			const outputVideo = root.querySelector('[data-output-video]');
			const outputDetails = root.querySelector('[data-output-details]');

			if (
				!sourceInput || !sourceName || !sourceMeta || !animatedNotice || !outputPreview || !modeSelect ||
				!textGroup || !colorGroup || !imageGroup || !textInput ||
				!colorInput || !watermarkInput || !watermarkName || !positionSelect || !opacityInput ||
				!opacityLabel || !sizeInput || !sizeLabel || !marginInput || !marginLabel || !tileInput ||
				!processButton || !clearButton || !status || !downloadLink || !outputImage ||
				!outputVideo || !outputDetails
			) {
				return;
			}

			const state = {
				sourceFile: null,
				sourceUrl: null,
				sourceKind: null,
				sourceWidth: 0,
				sourceHeight: 0,
				sizeUnknown: false,
				watermarkFile: null,
				watermarkUrl: null,
				outputUrl: null,
				isWorking: false,
			};
			const ffmpegRuntime = createFfmpegRuntime({
				timeoutMessage: copy.ffmpegTimeout,
				onLoading: () => setStatus(copy.ffmpegLoading, 'info'),
				onReady: () => setStatus(copy.ffmpegReady, 'success'),
				onProgress: (progress) => {
					setStatus(format(copy.ffmpegProgress, { progress }), 'info');
				},
			});
			const defaults = {
				sourceName: sourceName.textContent,
				sourceMeta: sourceMeta.textContent,
				watermarkName: watermarkName.textContent,
			};

			sourceInput.addEventListener('change', () => {
				void setSourceFile(sourceInput.files && sourceInput.files[0] ? sourceInput.files[0] : null);
			});
			watermarkInput.addEventListener('change', () => {
				setWatermarkFile(watermarkInput.files && watermarkInput.files[0] ? watermarkInput.files[0] : null);
			});
			modeSelect.addEventListener('change', updateModeUi);
			textInput.addEventListener('input', updateReadyState);
			for (const input of [opacityInput, sizeInput, marginInput]) {
				input.addEventListener('input', updateRangeLabels);
			}
			processButton.addEventListener('click', () => {
				void processSource();
			});
			clearButton.addEventListener('click', resetTool);

			updateModeUi();
			updateRangeLabels();
			updateReadyState();

			async function setSourceFile(file) {
				resetOutput();
				revokeUrl('sourceUrl');
				state.sourceFile = file;
				state.sourceKind = null;
				state.sourceWidth = 0;
				state.sourceHeight = 0;

				if (!file) {
					sourceInput.value = '';
					sourceName.textContent = defaults.sourceName;
					sourceMeta.textContent = defaults.sourceMeta;
					animatedNotice.hidden = true;
					setStatus(copy.waiting, 'info');
					updateReadyState();
					return;
				}

				state.sourceUrl = URL.createObjectURL(file);
				state.sourceKind = detectSourceKind(file);
				sourceName.textContent = file.name;
				sourceMeta.textContent = format(copy.fileMeta, {
					size: formatBytes(file.size),
					type: file.type || state.sourceKind,
				});
				animatedNotice.hidden = !(await isAnimatedGifFile(file));

				try {
					if (state.sourceKind === 'video') {
						/*
						 * AVI, WMV and some MOV files never report a size here. FFmpeg still renders them,
						 * so a failed metadata read only means the size is read from the decoded frame later.
						 */
						const metadata = await loadVideoMetadata(state.sourceUrl).catch(() => null);
						state.sourceWidth = metadata?.width || 0;
						state.sourceHeight = metadata?.height || 0;
						/*
						 * A read that fails leaves the size unknown and FFmpeg is given the file anyway.
						 * A read that succeeds while reporting no picture is a different answer: the file
						 * carries no video track, and no amount of FFmpeg work will produce a frame.
						 */
						state.sizeUnknown = !metadata;

						if (metadata && !(metadata.width && metadata.height)) {
							throw new Error(copy.metadataMissing);
						}
					} else {
						const image = await loadImage(state.sourceUrl);
						state.sourceKind = 'image';
						state.sourceWidth = image.naturalWidth;
						state.sourceHeight = image.naturalHeight;

						if (!state.sourceWidth || !state.sourceHeight) {
							throw new Error(copy.metadataMissing);
						}
					}

					setStatus(format(copy.sourceReady, { name: file.name, size: formatBytes(file.size) }), 'success');
				} catch (error) {
					setStatus(messageFromError(error), 'error');
				} finally {
					updateReadyState();
				}
			}

			async function isAnimatedGifFile(file) {
				if (String(file.type || '').toLowerCase() !== 'image/gif' && inputExtension(file.name) !== '.gif') {
					return false;
				}

				try {
					return isAnimatedGif(new Uint8Array(await file.arrayBuffer()));
				} catch {
					return false;
				}
			}

			function setWatermarkFile(file) {
				revokeUrl('watermarkUrl');
				state.watermarkFile = file;

				if (!file) {
					watermarkInput.value = '';
					watermarkName.textContent = defaults.watermarkName;
					updateReadyState();
					return;
				}

				state.watermarkUrl = URL.createObjectURL(file);
				watermarkName.textContent = file.name;
				setStatus(format(copy.watermarkReady, { name: file.name }), 'success');
				updateReadyState();
			}

			async function processSource() {
				if (!state.sourceFile) {
					setStatus(copy.needSource, 'error');
					return;
				}

				if (!hasWatermark()) {
					setStatus(copy.needWatermark, 'error');
					return;
				}

				setWorking(true);
				resetOutput();

				try {
					if (state.sourceKind === 'video') {
						await processVideo();
					} else {
						await processImage();
					}
				} catch (error) {
					setStatus(messageFromError(error), 'error');
				} finally {
					setWorking(false);
				}
			}

			async function processImage() {
				setStatus(copy.processingImage, 'info');
				const source = await loadImage(state.sourceUrl);
				const canvas = document.createElement('canvas');
				canvas.width = source.naturalWidth;
				canvas.height = source.naturalHeight;
				const context = canvas.getContext('2d');
				context.drawImage(source, 0, 0);
				await drawWatermark(context, canvas.width, canvas.height);
				const blob = await canvasToBlob(canvas, 'image/png', 0.95);
				const outputName = format(copy.outputImage, { name: baseName(state.sourceFile.name) });

				state.outputUrl = URL.createObjectURL(blob);
				outputImage.src = state.outputUrl;
				outputImage.hidden = false;
				outputVideo.hidden = true;
				downloadLink.href = state.outputUrl;
				downloadLink.download = outputName;
				downloadLink.hidden = false;
				outputDetails.textContent = format(copy.meta, {
					width: canvas.width,
					height: canvas.height,
					size: formatBytes(blob.size),
				});
				outputPreview.hidden = false;
				setStatus(copy.imageReady, 'success');
			}

			async function processVideo() {
				setStatus(copy.processingVideo, 'info');

				if (!state.sourceWidth || !state.sourceHeight) {
					const size = await probeVideoSize(state.sourceFile);
					state.sourceWidth = size.width;
					state.sourceHeight = size.height;
				}

				const overlayCanvas = document.createElement('canvas');
				overlayCanvas.width = state.sourceWidth;
				overlayCanvas.height = state.sourceHeight;
				await drawWatermark(overlayCanvas.getContext('2d'), overlayCanvas.width, overlayCanvas.height);
				const overlayBlob = await canvasToBlob(overlayCanvas, 'image/png', 0.95);
				const output = await renderVideoWithOverlay(state.sourceFile, overlayBlob);
				const blob = new Blob([output], { type: 'video/mp4' });
				const outputName = format(copy.outputVideo, { name: baseName(state.sourceFile.name) });

				state.outputUrl = URL.createObjectURL(blob);
				outputVideo.src = state.outputUrl;
				outputVideo.hidden = false;
				outputImage.hidden = true;
				downloadLink.href = state.outputUrl;
				downloadLink.download = outputName;
				downloadLink.hidden = false;
				outputDetails.textContent = format(copy.meta, {
					width: state.sourceWidth,
					height: state.sourceHeight,
					size: formatBytes(blob.size),
				});
				outputPreview.hidden = false;
				setStatus(copy.videoReady, 'success');
			}

			/* FFmpeg decodes the containers the browser refuses, so the first frame it writes reports the size. */
			async function probeVideoSize(file) {
				const frame = await ffmpegRuntime.run(async (ffmpeg) => {
					const stamp = Date.now();
					const inputName = `probe-${stamp}${inputExtension(file.name)}`;
					const frameName = `probe-${stamp}.png`;

					await ffmpeg.writeFile(inputName, new Uint8Array(await file.arrayBuffer()));

					try {
						const resultCode = await ffmpeg.exec(['-i', inputName, '-frames:v', '1', '-an', '-y', frameName]);

						if (resultCode !== 0) {
							throw new Error(copy.metadataMissing);
						}

						const output = await ffmpeg.readFile(frameName);
						return output instanceof Uint8Array ? output : null;
					} finally {
						await ffmpeg.deleteFile(inputName).catch(() => {});
						await ffmpeg.deleteFile(frameName).catch(() => {});
					}
				});
				const size = readPngSize(frame);

				if (!size) {
					throw new Error(copy.metadataMissing);
				}

				return size;
			}

			async function renderVideoWithOverlay(file, overlayBlob) {
				return ffmpegRuntime.run(async (ffmpeg) => {
					const inputName = `input-${Date.now()}${inputExtension(file.name)}`;
					const overlayName = `watermark-${Date.now()}.png`;
					const outputName = `output-${Date.now()}.mp4`;

					await ffmpeg.writeFile(inputName, new Uint8Array(await file.arrayBuffer()));
					await ffmpeg.writeFile(overlayName, new Uint8Array(await overlayBlob.arrayBuffer()));

					try {
						const resultCode = await ffmpeg.exec([
							'-i', inputName,
							'-i', overlayName,
							'-filter_complex', '[0:v][1:v]overlay=0:0:format=auto,scale=trunc(iw/2)*2:trunc(ih/2)*2[v]',
							'-map', '[v]',
							'-map', '0:a?',
							'-c:v', 'libx264',
							'-preset', 'veryfast',
							'-crf', '23',
							'-pix_fmt', 'yuv420p',
							'-c:a', 'aac',
							'-b:a', '160k',
							'-shortest',
							'-movflags', '+faststart',
							'-y', outputName,
						]);

						if (resultCode !== 0) {
							throw new Error(`FFmpeg exited with code ${resultCode}`);
						}

						const output = await ffmpeg.readFile(outputName);
						return output instanceof Uint8Array ? output : new TextEncoder().encode(String(output));
					} finally {
						await ffmpeg.deleteFile(inputName).catch(() => {});
						await ffmpeg.deleteFile(overlayName).catch(() => {});
						await ffmpeg.deleteFile(outputName).catch(() => {});
					}
				});
			}

			async function drawWatermark(context, width, height) {
				const opacity = Number(opacityInput.value) / 100;
				const size = Number(sizeInput.value) / 100;
				const margin = Math.round(Math.min(width, height) * (Number(marginInput.value) / 100));
				const position = positionSelect.value;
				const shouldTile = tileInput.checked;
				context.save();
				context.globalAlpha = opacity;

				if (modeSelect.value === 'image') {
					const watermark = await loadImage(state.watermarkUrl);
					let targetWidth = Math.max(12, Math.round(width * size));
					const ratio = watermark.naturalHeight / watermark.naturalWidth;
					let targetHeight = Math.max(12, Math.round(targetWidth * ratio));
					const maxHeight = Math.round(height * 0.9);

					if (targetHeight > maxHeight) {
						targetHeight = maxHeight;
						targetWidth = Math.max(12, Math.round(targetHeight / ratio));
					}

					drawWatermarkItem(context, {
						draw: (x, y) => context.drawImage(watermark, x, y, targetWidth, targetHeight),
						width: targetWidth,
						height: targetHeight,
						canvasWidth: width,
						canvasHeight: height,
						margin,
						position,
						shouldTile,
					});
				} else {
					const text = textInput.value.trim();
					const targetWidth = Math.max(80, width * size);
					let fontSize = Math.max(16, Math.round(height * size * 0.18));
					context.font = `800 ${fontSize}px system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif`;

					while (context.measureText(text).width > targetWidth && fontSize > 12) {
						fontSize -= 2;
						context.font = `800 ${fontSize}px system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif`;
					}

					const metrics = context.measureText(text);
					const textWidth = Math.ceil(metrics.width);
					const textHeight = Math.ceil(fontSize * 1.18);
					context.textBaseline = 'top';
					context.lineJoin = 'round';
					context.lineWidth = Math.max(3, Math.round(fontSize * 0.08));
					context.strokeStyle = 'rgba(0, 0, 0, 0.58)';
					context.fillStyle = colorInput.value || '#ffffff';

					drawWatermarkItem(context, {
						draw: (x, y) => {
							context.strokeText(text, x, y);
							context.fillText(text, x, y);
						},
						width: textWidth,
						height: textHeight,
						canvasWidth: width,
						canvasHeight: height,
						margin,
						position,
						shouldTile,
					});
				}

				context.restore();
			}

			function drawWatermarkItem(context, item) {
				if (item.shouldTile) {
					const gap = Math.max(item.margin, Math.round(Math.min(item.canvasWidth, item.canvasHeight) * 0.05));
					for (let y = gap; y < item.canvasHeight; y += item.height + gap) {
						for (let x = gap; x < item.canvasWidth; x += item.width + gap) {
							item.draw(x, y);
						}
					}
					return;
				}

				const point = placementFor(item.position, item.canvasWidth, item.canvasHeight, item.width, item.height, item.margin);
				item.draw(point.x, point.y);
			}

			function placementFor(position, canvasWidth, canvasHeight, itemWidth, itemHeight, margin) {
				const xMap = {
					'top-left': margin,
					'center-left': margin,
					'bottom-left': margin,
					'top-center': (canvasWidth - itemWidth) / 2,
					center: (canvasWidth - itemWidth) / 2,
					'bottom-center': (canvasWidth - itemWidth) / 2,
					'top-right': canvasWidth - itemWidth - margin,
					'center-right': canvasWidth - itemWidth - margin,
					'bottom-right': canvasWidth - itemWidth - margin,
				};
				const yMap = {
					'top-left': margin,
					'top-center': margin,
					'top-right': margin,
					'center-left': (canvasHeight - itemHeight) / 2,
					center: (canvasHeight - itemHeight) / 2,
					'center-right': (canvasHeight - itemHeight) / 2,
					'bottom-left': canvasHeight - itemHeight - margin,
					'bottom-center': canvasHeight - itemHeight - margin,
					'bottom-right': canvasHeight - itemHeight - margin,
				};
				return {
					x: Math.max(0, Math.round(xMap[position] ?? xMap['bottom-right'])),
					y: Math.max(0, Math.round(yMap[position] ?? yMap['bottom-right'])),
				};
			}

			function updateModeUi() {
				const isImageMode = modeSelect.value === 'image';
				textGroup.hidden = isImageMode;
				colorGroup.hidden = isImageMode;
				imageGroup.hidden = !isImageMode;
				updateReadyState();
			}

			function updateRangeLabels() {
				opacityLabel.textContent = `${opacityInput.value}%`;
				sizeLabel.textContent = `${sizeInput.value}%`;
				marginLabel.textContent = `${marginInput.value}%`;
			}

			function updateReadyState() {
				/* Video sizes may only arrive from FFmpeg at render time, so they cannot gate the button. */
				const hasSize = state.sizeUnknown || Boolean(state.sourceWidth && state.sourceHeight);
				const ready = Boolean(state.sourceFile && hasSize && hasWatermark());
				processButton.disabled = state.isWorking || !ready;
				sourceInput.disabled = state.isWorking;
				watermarkInput.disabled = state.isWorking;
				modeSelect.disabled = state.isWorking;
				textInput.disabled = state.isWorking;
				colorInput.disabled = state.isWorking;
				positionSelect.disabled = state.isWorking;
				opacityInput.disabled = state.isWorking;
				sizeInput.disabled = state.isWorking;
				marginInput.disabled = state.isWorking;
				tileInput.disabled = state.isWorking;
				clearButton.disabled = state.isWorking || (!state.sourceFile && !state.watermarkFile && !state.outputUrl);
			}

			function hasWatermark() {
				if (modeSelect.value === 'image') {
					return Boolean(state.watermarkFile && state.watermarkUrl);
				}

				return Boolean(textInput.value.trim());
			}

			function setWorking(isWorking) {
				state.isWorking = isWorking;
				updateReadyState();
			}

			function resetTool() {
				sourceInput.value = '';
				watermarkInput.value = '';
				state.sourceFile = null;
				state.sourceKind = null;
				state.sourceWidth = 0;
				state.sourceHeight = 0;
				state.watermarkFile = null;
				revokeUrl('sourceUrl');
				revokeUrl('watermarkUrl');
				resetOutput();
				sourceName.textContent = defaults.sourceName;
				sourceMeta.textContent = defaults.sourceMeta;
				watermarkName.textContent = defaults.watermarkName;
				animatedNotice.hidden = true;
				setStatus(copy.reset, 'info');
				updateReadyState();
			}

			function resetOutput() {
				revokeUrl('outputUrl');
				outputPreview.hidden = true;
				downloadLink.hidden = true;
				downloadLink.removeAttribute('href');
				downloadLink.removeAttribute('download');
				outputImage.hidden = true;
				outputVideo.hidden = true;
				outputImage.removeAttribute('src');
				outputVideo.removeAttribute('src');
				outputDetails.textContent = '';
			}

			function revokeUrl(key) {
				if (state[key]) {
					URL.revokeObjectURL(state[key]);
					state[key] = null;
				}
			}

			function detectSourceKind(file) {
				const type = String(file.type || '').toLowerCase();
				if (type.startsWith('video/')) {
					return 'video';
				}
				if (type.startsWith('image/')) {
					return 'image';
				}
				const extension = inputExtension(file.name).slice(1);
				return videoExtensions.has(extension) ? 'video' : 'image';
			}

			function inputExtension(name) {
				const match = String(name || '').toLowerCase().match(/\.[a-z0-9]+$/);
				return match ? match[0] : '.bin';
			}

			const videoExtensions = new Set(['3g2', '3gp', 'avi', 'flv', 'm4v', 'mkv', 'mov', 'mp4', 'mpeg', 'mpg', 'ogv', 'ts', 'webm', 'wmv']);

			function loadImage(url) {
				return new Promise((resolve, reject) => {
					const image = new Image();
					image.onload = () => resolve(image);
					image.onerror = () => reject(new Error(copy.metadataMissing));
					image.src = url;
				});
			}

			function loadVideoMetadata(url) {
				return new Promise((resolve, reject) => {
					const video = document.createElement('video');
					video.preload = 'metadata';
					video.muted = true;
					video.onloadedmetadata = () => resolve({
						width: video.videoWidth,
						height: video.videoHeight,
					});
					video.onerror = () => reject(new Error(copy.metadataMissing));
					video.src = url;
				});
			}

			function canvasToBlob(canvas, type, quality) {
				return new Promise((resolve, reject) => {
					canvas.toBlob((blob) => {
						if (blob) {
							resolve(blob);
						} else {
							reject(new Error(copy.unknownError));
						}
					}, type, quality);
				});
			}

			function setStatus(message, type) {
				status.textContent = message;
				status.dataset.state = type;
			}

			function format(template, values) {
				return String(template).replace(/\{(\w+)\}/g, (_match, key) => {
					return values && key in values ? String(values[key]) : '';
				});
			}

			function baseName(name) {
				return String(name || '').replace(/\.[^.]+$/, '') || 'watermarked-media';
			}

			function messageFromError(error) {
				return error && typeof error === 'object' && 'message' in error
					? String(error.message)
					: copy.unknownError;
			}

		}
	})();
</script>

