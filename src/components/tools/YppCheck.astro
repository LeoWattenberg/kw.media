				reused: 'Reused content',
				repetitive: 'Repetitive bzw. generic content (ältere Mails: „Repetitious content“)',
				offputting: 'Unsatisfying or off-putting content',
				inauthentic: 'Inauthentic content',
				persona: 'AI personas related to sensitive topics',
				kids: 'Quality principles for kids and family content',
