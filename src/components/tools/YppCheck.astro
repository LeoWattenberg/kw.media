				options: { no: 'No', voiced: 'Yes, with narration and my own take', plain: 'Yes, without' },
				text: 'YouTube explicitly lists slideshows, templated stories and scrolling text with no narrative, commentary or educational value as not monetizable.',
			},
			'g-ai': {
				label: 'What role does AI play in your videos?',
