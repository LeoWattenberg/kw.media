			},
			'u-ai-clips': {
				label: 'Do you stitch AI clips together without a common thread?',
				short: 'AI clips without a common thread',
				options: { no: 'No', yes: 'Yes' },
				text: 'YouTube explicitly lists stitched-together AI clips without a clear narrative as not monetizable.',
			},
			'p-expert': {
				label: 'Does an AI character or AI voice appear as an expert in your videos and give advice on health, law, finance or politics?',
				short: 'AI as an expert',
				options: { no: 'No', yes: 'Yes' },
				text: 'YouTube excludes these channels from monetization, e.g. an AI “doctor” or AI podcast hosts giving financial tips.',
			},
			'k-promo': {
				label: 'Do products, brands or unboxing take centre stage in your kids videos?',
				short: 'Heavily promotional kids videos',
				options: { no: 'No', yes: 'Yes' },
				text: 'Heavily promotional content is one of the quality principles YouTube enforces for kids content.',
			},
			'k-fake-edu': {
				label: 'Do titles or thumbnails promise learning (colours, numbers) that the video doesn’t deliver?',
				short: 'Deceptively educational',
				options: { no: 'No', yes: 'Yes' },
				text: 'Content that promises learning and doesn’t deliver is explicitly a problem for kids content.',
			},
			'k-characters': {
				label: 'Do well-known kids characters appear in inappropriate situations, or are your titles stuffed with keywords?',
				short: 'Kids characters and keyword-stuffed titles',
				options: { no: 'No', yes: 'Yes' },
				text: 'Well-known characters in inappropriate situations and keyword-stuffed titles are explicitly a problem for kids content.',
			},
			'i-bought': {
				label: 'Have you ever bought views, subscribers or likes, or joined sub4sub or view exchanges?',
				short: 'Bought or exchanged reach',
				options: { no: 'No', yes: 'Yes' },
				text: 'Artificially inflated views, subscribers or likes break the creator integrity policy and can lead to removal.',
			},
			'i-deleted': {
				label: 'Have you let problematic videos collect views and then deleted or hidden them?',
				short: 'Deleted videos after they got views',
				options: { no: 'No', yes: 'Yes' },
				text: 'That is exactly what the creator integrity policy forbids: letting problematic videos collect engagement, then deleting or hiding them.',
			},
			'c-strikes': {
				label: 'Do you have active Community Guidelines strikes, or has YouTube removed any of your videos?',
				short: 'Strikes',
				options: { no: 'No', yes: 'Yes' },
				text: 'Sort out the strikes first. Content that violates the Community Guidelines can’t be monetized.',
			},
			's-top': {
				label: 'Do your most viewed videos match what you make today?',
				short: 'Most viewed videos',
				options: { yes: 'Yes', no: 'No' },
				text: 'If an old video with other people’s material tops your list, that’s the first thing reviewers see.',
			},
			's-about': {
				label: 'Does your About section say what you do and how your videos are made?',
				short: 'About section',
				options: { yes: 'Yes', no: 'No' },
				text: 'The About section is one of the places YouTube says reviewers look at.',
			},
		},
		evaluate: 'Show my result',
		reset: 'Start over',
		status: {
			start: 'Start by choosing what happened.',
			setup: 'Add the date and choose the policy and channel size.',
			missing: '{count} questions still need an answer.',
			done: 'Done. Your result is below.',
			exit: 'This check doesn’t fit your situation.',
		},
		result: {
			title: 'Your result',
			levels: { ok: 'Looks fine', warn: 'Worth checking', risk: 'Probably applies' },
			nothing: 'Nothing stands out here.',
			permission: 'Permission or a licence doesn’t help with reused content. The rule isn’t about copyright, only about whether you add enough of your own.',
			policyLink: 'Read the policy',
			deadlinesTitle: 'Your deadlines',
			appealBy: 'Appeal by {date}',
			noticeAppeal: 'Appeal within 7 days, so by about {date}. An appeal in that window pauses the suspension until there’s a decision.',
			reapplyFrom: 'Re-apply from {date}',
			noticeReapply: 'If the channel is suspended, you can re-apply 90 days later.',
			reapplyAfterFailedAppeal: 'If an appeal is rejected: re-apply only from {date}',
			decision: 'YouTube decides on an appeal within 14 days.',
			studio: 'The exact deadline is shown in YouTube Studio under “Earn”, next to “Start appeal”.',
			recommendationTitle: 'Appeal or fix?',
			recommendations: {
				fix: { title: 'Fix your channel and re-apply', text: 'Based on your answers, what YouTube criticises does apply. An appeal then has little chance.' },
				borderline: { title: 'Borderline', text: 'An appeal can work if you can show how your videos are made. If you can’t, fix your channel first and re-apply.' },
				appeal: { title: 'Consider an appeal', text: 'Based on your answers, your channel fits the policies. Maybe the reviewers couldn’t tell what your part is. Show how you work in an appeal video, and make your contribution visible in descriptions and your About section.' },
			},
			failedAppeal: 'After a first rejection, a failed appeal costs time: you can only re-apply after 90 days instead of 30.',
			longFix: 'With gameplay without commentary, the earliest date is rarely the realistic one. In our experience it takes months of new videos where people can see or hear you.',
			deleteTitle: 'Don’t delete anything before you’ve talked to an expert.',
			deleteText: 'Deleting hurts before an appeal, because YouTube reviews your channel as it is now. And before re-applying, it matters which videos you change and how.',
			checklistTitle: 'Checklist for your appeal video',
			checklist: [
				'Under 5 minutes, a new upload, unlisted, on the channel you’re appealing for.',
				'No appeal info in the description.',
				'Your channel URL within the first 30 seconds.',
				'Refer to specific parts of the policies and back them up with examples from your channel.',
				'Talk about the channel as a whole, not just a few good videos.',
				'Show how you film and edit, on camera or as a voice-over.',
			],
			language: 'Appeal videos must be narrated in Arabic, Bengali, English, French, Hindi, Indonesian, Japanese, Korean, Mandarin, Portuguese, Russian, Spanish, Thai, Turkish or Vietnamese. Otherwise YouTube accepts manually created English subtitles. In our experience, an English voice-over works much better.',
			support: 'Alternatively you can appeal through Creator Support in YouTube Studio, if it’s offered there.',
			appealLink: 'YouTube’s appeal requirements',
			offerTitle: 'Have an expert look at it',
			offers: {
				rejection: [
					{ name: 'Written', price: '€49', text: 'I go through your channel, name the videos that cause problems and tell you what to change.' },
					{ name: 'With appeal', price: '€99', text: 'Plus feedback on the script for your appeal video.' },
				],
				scope: [
					{ name: 'Review', price: 'based on scope', text: 'With more than 200 videos the effort depends a lot on the channel. Send me the link and you get a fixed price up front.' },
				],
				suspension: [
					{ name: 'Suspension', price: 'from €199', text: 'I go through the channel, name the videos that cause problems and help you with the appeal. With an upcoming suspension every day counts, so write to me right away.' },
				],
			},
			dub: 'We can also voice your appeal video in English. Price on request.',
			vat: 'All prices include German VAT.',
			channelLabel: 'Link to your channel (optional)',
			request: 'Request a review',
			requestHint: 'The button opens an email to team@kw.media with your result. Nothing is sent until you press send in your email program.',
			disclaimer: 'This assessment is based only on your answers and YouTube’s public policies. We are not affiliated with YouTube and can’t guarantee any outcome. YouTube makes the decision.',
		},
		mail: {
			subject: 'YPP check',
			situation: 'Situation',
			date: 'Date of the email',
			repeat: 'Rejected before',
			yes: 'yes',
			no: 'no',
			policies: 'Policies named in the email',
			videos: 'Public videos',
			channel: 'Channel',
			result: 'Result',
			recommendation: 'Recommendation',
			offer: 'Matching review',
		},
	},
}[locale];

const situations = ['rejected', 'suspension-notice', 'suspended', 'yellow-icons', 'terminated'];
const policies = Object.keys(copy.policies.options);
const videoOptions = Object.keys(copy.videos.options);
const offerKeys = Object.keys(copy.result.offers);
const copyJson = JSON.stringify({ ...copy, policyUrl, dateLocale: locale === 'de' ? 'de-DE' : 'en-GB' });
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />

<section class="section tool-workspace ypp-section">
	<div class="container ypp-layout">
		<form class="ypp-check" data-ypp-check data-copy={copyJson} novalidate>
			<ToolPanel title={copy.setupTitle}>
				<fieldset class="ypp-question" data-field="situation">
					<legend class="visually-hidden">{copy.situation.legend}</legend>
					<div class="ypp-options">
						{situations.map((id) => (
							<label><input type="radio" name="situation" value={id} /><span>{copy.situation.options[id]}</span></label>
						))}
					</div>
				</fieldset>
				<div class="ypp-exit" data-exit hidden>
					<p data-exit-text></p>
					<a data-exit-link href="#" rel="noopener noreferrer" target="_blank"></a>
				</div>
				<div class="ypp-setup" data-setup hidden>
					<label class="ypp-date">
						<span>{copy.date.label}</span>
						<input type="date" name="date" data-date />
						<small>{copy.date.hint}</small>
					</label>
					<fieldset class="ypp-question" data-field="repeat" data-repeat>
						<legend>{copy.repeat.legend}</legend>
						<div class="ypp-options">
							<label><input type="radio" name="repeat" value="first" /><span>{copy.repeat.options.first}</span></label>
							<label><input type="radio" name="repeat" value="repeat" /><span>{copy.repeat.options.repeat}</span></label>
						</div>
					</fieldset>
					<fieldset class="ypp-question" data-field="policies">
						<legend>{copy.policies.legend} <small>{copy.policies.hint}</small></legend>
						<div class="ypp-options">
							{policies.map((id) => (
								<label><input type="checkbox" name="policy" value={id} /><span>{copy.policies.options[id]}</span></label>
							))}
						</div>
					</fieldset>
					<fieldset class="ypp-question" data-field="videos">
						<legend>{copy.videos.legend}</legend>
						<div class="ypp-options ypp-options-row">
							{videoOptions.map((id) => (
								<label><input type="radio" name="videos" value={id} /><span>{copy.videos.options[id]}</span></label>
							))}
						</div>
					</fieldset>
				</div>
			</ToolPanel>

			{
				MODULE_ORDER.map((module) => (
					<ToolPanel class="ypp-module" title={copy.modules[module].title} data-module={module} hidden>
						<p class="ypp-module-intro">{copy.modules[module].intro}</p>
						{QUESTIONS.filter((question) => question.module === module).map((question) => (
							<fieldset class="ypp-question" data-question={question.id}>
								<legend>{copy.questions[question.id].label}</legend>
								<div class="ypp-options">
									{question.options.map((option) => (
										<label><input type="radio" name={question.id} value={option.id} /><span>{copy.questions[question.id].options[option.id]}</span></label>
									))}
								</div>
							</fieldset>
						))}
					</ToolPanel>
				))
			}

			<ToolActions>
				<button class="button primary" type="submit" data-evaluate>{copy.evaluate}</button>
				<button class="button secondary" type="button" data-reset>{copy.reset}</button>
			</ToolActions>
			<ToolStatus text={copy.status.start} data-status aria-live="polite" />
		</form>

		<section class="ypp-result" data-result hidden tabindex="-1" aria-labelledby="ypp-result-title">
			<h2 id="ypp-result-title">{copy.result.title}</h2>
			<div class="ypp-module-results" data-module-results></div>

			<div class="ypp-box">
				<h3>{copy.result.deadlinesTitle}</h3>
				<ul class="ypp-deadlines" data-deadlines></ul>
				<p>{copy.result.decision}</p>
				<p class="ypp-muted">{copy.result.studio}</p>
			</div>

			<div class="ypp-box" data-recommendation>
				<h3>{copy.result.recommendationTitle}</h3>
				<p class="ypp-recommendation-title" data-recommendation-title></p>
				<p data-recommendation-text></p>
				<p data-failed-appeal hidden>{copy.result.failedAppeal}</p>
				<p data-long-fix hidden>{copy.result.longFix}</p>
			</div>

			<div class="ypp-warning" role="note">
				<p><strong>{copy.result.deleteTitle}</strong></p>
				<p>{copy.result.deleteText}</p>
			</div>

			<div class="ypp-box" data-checklist>
				<h3>{copy.result.checklistTitle}</h3>
				<ul class="ypp-checklist">
					{copy.result.checklist.map((item) => <li>{item}</li>)}
				</ul>
				<p>{copy.result.language}</p>
				<p class="ypp-muted">{copy.result.support}</p>
				<a href={appealUrl} rel="noopener noreferrer" target="_blank">{copy.result.appealLink}</a>
			</div>

			<div class="ypp-box ypp-offer" data-offer>
				<h3>{copy.result.offerTitle}</h3>
				{offerKeys.map((key) => (
					<div class="ypp-offer-items" data-offer-variant={key} hidden>
						{copy.result.offers[key].map((item) => (
							<article>
								<p class="ypp-offer-head"><strong>{item.name}</strong><span>{item.price}</span></p>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				))}
				<p>{copy.result.dub}</p>
				<p class="ypp-muted">{copy.result.vat}</p>
				<label class="ypp-channel">
					<span>{copy.result.channelLabel}</span>
					<input type="text" data-channel autocomplete="url" />
				</label>
				<a class="button primary" href="mailto:team@kw.media" data-request>{copy.result.request}</a>
				<p class="ypp-muted">{copy.result.requestHint}</p>
			</div>

			<p class="ypp-disclaimer">{copy.result.disclaimer}</p>
		</section>
	</div>
</section>

<script>
	import {
		assessModules,
		buildRequestMailto,
		deadlines,
		modulesForPolicies,
		needsLongFix,
		offerFor,
		recommendation,
		SITUATIONS,
		unansweredQuestions,
	} from '../../lib/tools/ypp-check.js';

	for (const form of document.querySelectorAll<HTMLFormElement>('[data-ypp-check]')) {
		const copy = JSON.parse(form.dataset.copy ?? '{}');
		const root = form.closest('.ypp-layout') ?? document;
		const status = form.querySelector<HTMLElement>('[data-status]');
		const exit = form.querySelector<HTMLElement>('[data-exit]');
		const setup = form.querySelector<HTMLElement>('[data-setup]');
		const repeatField = form.querySelector<HTMLElement>('[data-repeat]');
		const dateInput = form.querySelector<HTMLInputElement>('[data-date]');
		const result = root.querySelector<HTMLElement>('[data-result]');
		const moduleResults = root.querySelector<HTMLElement>('[data-module-results]');
		const deadlineList = root.querySelector<HTMLElement>('[data-deadlines]');
		const requestLink = root.querySelector<HTMLAnchorElement>('[data-request]');
		const channelInput = root.querySelector<HTMLInputElement>('[data-channel]');
		const dateFormat = new Intl.DateTimeFormat(copy.dateLocale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
		let lastResult: { lines: string[] } | null = null;

		const today = () => {
			const now = new Date();
			return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
		};
		const formatDate = (iso: string) => dateFormat.format(new Date(`${iso}T00:00:00Z`));
		const fill = (template: string, values: Record<string, string | number>) =>
			template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));
		const setStatus = (text: string, state?: 'success' | 'error') => {
			if (!status) return;
			status.textContent = text;
			if (state) status.dataset.state = state;
			else delete status.dataset.state;
		};

		const readState = () => {
			const data = new FormData(form);
			const situation = String(data.get('situation') ?? '');
			const policies = data.getAll('policy').map(String);
			const answers: Record<string, string> = {};
			for (const [key, value] of data.entries()) {
				if (!['situation', 'date', 'repeat', 'policy', 'videos'].includes(key)) answers[key] = String(value);
			}
			return {
				situation,
				date: String(data.get('date') ?? ''),
				repeat: data.get('repeat') === 'repeat',
				repeatAnswered: data.has('repeat'),
				policies,
				videos: String(data.get('videos') ?? ''),
				answers,
			};
		};

		const activeModules = (state: ReturnType<typeof readState>) => {
			if (!state.situation || SITUATIONS[state.situation]?.exit) return [];
			return state.policies.length ? modulesForPolicies(state.policies) : [];
		};

		const sync = () => {
			const state = readState();
			const isExit = Boolean(SITUATIONS[state.situation]?.exit);
			if (exit) {
				exit.hidden = !isExit;
				if (isExit) {
					const target = copy.exits[state.situation];
					exit.querySelector('[data-exit-text]')!.textContent = target.text;
					const link = exit.querySelector<HTMLAnchorElement>('[data-exit-link]')!;
					link.textContent = target.link;
					link.href = target.href;
					setStatus(copy.status.exit);
				}
			}
			if (setup) setup.hidden = !state.situation || isExit;
			if (repeatField) repeatField.hidden = state.situation !== 'rejected';
			const modules = new Set(activeModules(state));
			for (const panel of form.querySelectorAll<HTMLElement>('[data-module]')) {
				panel.hidden = !modules.has(panel.dataset.module ?? '');
			}
			if (isExit && result) result.hidden = true;
		};

		const levelBadge = (level: string) => {
			const badge = document.createElement('span');
			badge.className = 'ypp-badge';
			badge.dataset.level = level;
			badge.textContent = copy.result.levels[level];
			return badge;
		};

		const render = (state: ReturnType<typeof readState>) => {
			const modules = activeModules(state);
			const assessments = assessModules(modules, state.answers);
			const advice = recommendation(assessments);
			const dates = deadlines({ situation: state.situation, date: state.date, repeat: state.repeat });
			const offer = offerFor({ situation: state.situation, videos: state.videos });

			moduleResults!.replaceChildren();
			for (const assessment of assessments) {
				const card = document.createElement('article');
				card.className = 'ypp-module-result';
				card.dataset.level = assessment.level;
				card.dataset.moduleResult = assessment.module;
				const head = document.createElement('header');
				const title = document.createElement('h3');
				title.textContent = copy.modules[assessment.module].title;
				head.append(levelBadge(assessment.level), title);
				card.append(head);
				if (assessment.flagged.length) {
					const list = document.createElement('ul');
					for (const flag of assessment.flagged) {
						const question = copy.questions[flag.question];
						const item = document.createElement('li');
						const strong = document.createElement('strong');
						strong.textContent = `${question.short}: ${question.options[flag.option]}. `;
						item.append(strong, question.text);
						item.dataset.level = flag.level;
						list.append(item);
					}
					card.append(list);
				} else {
					const nothing = document.createElement('p');
					nothing.textContent = copy.result.nothing;
					card.append(nothing);
				}
				if (assessment.module === 'reused') {
					const note = document.createElement('p');
					note.className = 'ypp-muted';
					note.textContent = copy.result.permission;
					card.append(note);
				}
				if (assessment.module !== 'channel') {
					const link = document.createElement('a');
					link.href = copy.policyUrl;
					link.rel = 'noopener noreferrer';
					link.target = '_blank';
					link.textContent = copy.result.policyLink;
					card.append(link);
				}
				moduleResults!.append(card);
			}

			deadlineList!.replaceChildren();
			const addDeadline = (text: string) => {
				const item = document.createElement('li');
				item.textContent = text;
				deadlineList!.append(item);
			};
			if (dates) {
				if (state.situation === 'suspension-notice') {
					addDeadline(fill(copy.result.noticeAppeal, { date: formatDate(dates.appealBy) }));
					addDeadline(copy.result.noticeReapply);
				} else {
					addDeadline(fill(copy.result.appealBy, { date: formatDate(dates.appealBy) }));
					if (dates.reapplyFrom) addDeadline(fill(copy.result.reapplyFrom, { date: formatDate(dates.reapplyFrom) }));
					if (dates.reapplyAfterFailedAppeal) {
						addDeadline(fill(copy.result.reapplyAfterFailedAppeal, { date: formatDate(dates.reapplyAfterFailedAppeal) }));
					}
				}
			}

			const adviceCopy = copy.result.recommendations[advice];
			root.querySelector('[data-recommendation]')!.setAttribute('data-advice', advice);
			root.querySelector('[data-recommendation-title]')!.textContent = adviceCopy.title;
			root.querySelector('[data-recommendation-text]')!.textContent = adviceCopy.text;
			root.querySelector<HTMLElement>('[data-failed-appeal]')!.hidden = !(state.situation === 'rejected' && !state.repeat);
			root.querySelector<HTMLElement>('[data-long-fix]')!.hidden = !needsLongFix(state.answers);
			root.querySelector<HTMLElement>('[data-checklist]')!.hidden = advice === 'fix';
			for (const variant of root.querySelectorAll<HTMLElement>('[data-offer-variant]')) {
				variant.hidden = variant.dataset.offerVariant !== offer;
			}

			const yes = copy.mail.yes;
			const no = copy.mail.no;
			const lines = [
				`${copy.mail.situation}: ${copy.situation.options[state.situation]}`,
				`${copy.mail.date}: ${state.date ? formatDate(state.date) : '-'}`,
				...(state.situation === 'rejected' ? [`${copy.mail.repeat}: ${state.repeat ? yes : no}`] : []),
				`${copy.mail.policies}: ${state.policies.map((policy) => copy.policies.options[policy]).join(', ')}`,
				`${copy.mail.videos}: ${copy.videos.options[state.videos]}`,
				'',
				`${copy.mail.result}:`,
				...assessments.flatMap((assessment) => [
					`- ${copy.modules[assessment.module].title}: ${copy.result.levels[assessment.level]}`,
					...assessment.flagged.map((flag) => `    ${copy.questions[flag.question].short}: ${copy.questions[flag.question].options[flag.option]}`),
				]),
				'',
				`${copy.mail.recommendation}: ${adviceCopy.title}`,
				`${copy.mail.offer}: ${copy.result.offers[offer].map((item: { name: string; price: string }) => `${item.name} (${item.price})`).join(' / ')}`,
			];
			lastResult = { lines };
			updateRequest();

			result!.hidden = false;
			result!.focus({ preventScroll: true });
			result!.scrollIntoView({ behavior: 'smooth', block: 'start' });
		};

		const updateRequest = () => {
			if (!lastResult || !requestLink) return;
			const channel = channelInput?.value.trim() ?? '';
			const subject = channel ? `${copy.mail.subject} – ${channel}` : copy.mail.subject;
			const lines = channel ? [`${copy.mail.channel}: ${channel}`, ...lastResult.lines] : lastResult.lines;
			requestLink.href = buildRequestMailto({ email: 'team@kw.media', subject, lines });
		};

		form.addEventListener('change', () => {
			sync();
			if (result && !result.hidden) result.hidden = true;
		});
		channelInput?.addEventListener('input', updateRequest);

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const state = readState();
			if (!state.situation || SITUATIONS[state.situation]?.exit) {
				setStatus(state.situation ? copy.status.exit : copy.status.start, 'error');
				return;
			}
			if (!deadlines({ situation: state.situation, date: state.date, repeat: state.repeat })
				|| !state.policies.length
				|| !state.videos
				|| (state.situation === 'rejected' && !state.repeatAnswered)) {
				setStatus(copy.status.setup, 'error');
				form.querySelector<HTMLElement>('[data-setup]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				return;
			}
			const modules = activeModules(state);
			const missing = unansweredQuestions(modules, state.answers);
			for (const fieldset of form.querySelectorAll<HTMLElement>('[data-question]')) {
				fieldset.toggleAttribute('data-missing', missing.some((question) => question.id === fieldset.dataset.question));
			}
			if (missing.length) {
				setStatus(fill(copy.status.missing, { count: missing.length }), 'error');
				const first = form.querySelector<HTMLElement>(`[data-question="${missing[0].id}"]`);
				first?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				first?.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
				return;
			}
			setStatus(copy.status.done, 'success');
			render(state);
		});

		form.querySelector('[data-reset]')?.addEventListener('click', () => {
			form.reset();
			if (dateInput) dateInput.value = today();
			for (const fieldset of form.querySelectorAll<HTMLElement>('[data-missing]')) fieldset.removeAttribute('data-missing');
			lastResult = null;
			if (result) result.hidden = true;
			sync();
			setStatus(copy.status.start);
		});

		if (dateInput && !dateInput.value) dateInput.value = today();
		sync();
	}
</script>

