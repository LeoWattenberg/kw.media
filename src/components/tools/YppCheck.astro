import ToolActions from './shared/ToolActions.astro';
import ToolIntro from './shared/ToolIntro.astro';
import ToolPanel from './shared/ToolPanel.astro';
import ToolStatus from './shared/ToolStatus.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const helpLanguage = locale === 'de' ? 'de' : 'en';
const policyUrl = `https://support.google.com/youtube/answer/1311392?hl=${helpLanguage}`;
const appealUrl = `https://support.google.com/youtube/answer/9564590?hl=${helpLanguage}`;

const copy = {
