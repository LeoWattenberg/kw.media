				href: 'https://support.google.com/youtube/answer/6162278?hl=de',
			},
			terminated: {
				text: 'Bei einer Kanalkündigung läuft der Einspruch anders. Dieser Check hilft dir dabei nicht.',
				link: 'Kanal- und Kontokündigungen',
				href: 'https://support.google.com/youtube/answer/2802168?hl=de',
			},
		},
