---
import type { Locale } from '../../i18n';
import type { ToolCategoryId } from '../../data/tool-categories';
import { getToolCategory } from '../../data/tool-categories';
import { toolGroup, toolPages } from '../../data/tools';
import { withBase } from '../../lib/url';

interface Props {
	categoryId: ToolCategoryId;
	locale: Locale;
}

const { categoryId, locale } = Astro.props;
const category = getToolCategory(categoryId);
const copy = category.translations[locale];
const toolsById = new Map(toolPages.filter((tool) => tool.locale === locale).map((tool) => [toolGroup(tool.id), tool]));
const tools = category.toolIds.map((toolId) => toolsById.get(toolId)).filter(Boolean);
---

<section class="tool-category-hero">
	<div class="container">
		<p class="eyebrow">{copy.eyebrow}</p>
		<h1>{copy.title}</h1>
		<p>{copy.description}</p>
	</div>
</section>

<section class="section tool-category-section">
	<div class="container tool-category-grid">
		{
			tools.map((tool) => (
				<a class="tool-category-card" href={withBase(tool.path)}>
					<span>{copy.open}</span>
					<h2>{tool.title}</h2>
					<p>{tool.description}</p>
				</a>
			))
		}
	</div>
</section>

<style>
	.tool-category-hero {
		padding-block: clamp(42px, 7vw, 82px);
		background: var(--color-surface-alt);
		border-bottom: 1px solid var(--color-line);
	}

	.tool-category-hero h1 {
		max-width: 780px;
		margin: 0;
		font-size: clamp(2.6rem, 7vw, 5.6rem);
		line-height: 0.96;
		letter-spacing: 0;
	}

	.tool-category-hero p:not(.eyebrow) {
		max-width: 720px;
		margin: 18px 0 0;
		color: var(--color-muted);
		font-size: 1.08rem;
	}

	.tool-category-section {
		background: var(--color-surface-raised);
	}

	.tool-category-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 16px;
	}

	.tool-category-card {
		display: grid;
		grid-template-rows: auto auto 1fr;
		gap: 12px;
		min-height: 210px;
		padding: clamp(18px, 3vw, 28px);
		color: inherit;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-line);
		border-radius: 8px;
		text-decoration: none;
	}

	.tool-category-card:hover {
		background: var(--color-surface-alt);
		border-color: var(--color-accent);
	}

	.tool-category-card:focus-visible {
		border-color: var(--color-accent);
		outline: 3px solid color-mix(in srgb, var(--color-accent) 24%, transparent);
		outline-offset: 2px;
	}

	.tool-category-card span {
		color: var(--color-accent-dark);
		font-size: 0.78rem;
		font-weight: 850;
		text-transform: uppercase;
	}

	.tool-category-card h2 {
		margin: 0;
		color: var(--color-ink);
		font-size: clamp(1.25rem, 3vw, 1.75rem);
		line-height: 1.1;
		letter-spacing: 0;
	}

	.tool-category-card p {
		margin: 0;
		color: var(--color-muted);
		font-weight: 700;
	}
</style>
