					</div>
					<div class="track-lane" data-track-lane tabindex="0">
						<canvas class="track-waveform" data-track-waveform aria-hidden="true"></canvas>
						<div class="clip-layer" data-clip-layer></div>
						<div class="track-selection" data-track-selection hidden></div>
					</div>
				</section>
			</template>

			<template data-clip-template>
				<div class="audio-clip" data-clip tabindex="0" role="button" aria-pressed="false">
