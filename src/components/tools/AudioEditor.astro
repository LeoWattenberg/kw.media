								<label class="field" data-quality-field hidden><span>{copy.quality}</span><select data-export-field="quality"></select></label>
								<label class="field"><span>{copy.sampleRate}</span><select data-export-field="sampleRate"><option value="44100">44.1 kHz</option><option value="48000" selected>48 kHz</option></select></label>
							</div>
							<label class="check-field"><input type="checkbox" data-export-field="tails" checked /><span>{copy.includeTails}</span></label>
							<p class="panel-hint">{copy.exportHint}</p>
							<progress data-export-progress max="1" value="0" hidden></progress>
							<div class="panel-actions"><button class="primary" type="button" data-export-action="start">{copy.startExport}</button><button type="button" data-export-action="cancel" hidden>{copy.cancelExport}</button></div>
							<a class="export-download" data-export-download href="#" download hidden>{copy.done}</a>
