const tabIds = ['clip', 'effects', 'analysis', 'export'] as const;
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />

<section class="section audio-editor-section tool-workspace">
	<div class="container audio-editor-container">
		<div class="audio-editor" data-audio-editor data-copy={copyJson} data-locale={locale}>
			<header class="project-bar" aria-label={copy.project}>
				<div class="project-identity">
					<span class="local-dot" aria-hidden="true"></span>
					<div>
						<span class="project-kicker">{copy.project}</span>
						<strong data-project-name>{copy.untitledProject}</strong>
					</div>
					<span class="save-state" data-save-state data-state="saved">{copy.projectSaved}</span>
				</div>

				<div class="project-actions">
					<div class="menu-shell file-menu" data-file-menu>
						<button class="editor-button" type="button" data-file-menu-toggle aria-haspopup="menu" aria-expanded="false">{copy.fileMenu} <span aria-hidden="true">▾</span></button>
						<div class="editor-menu" role="menu" data-file-menu-panel hidden>
							<button type="button" role="menuitem" data-project-action="new">{copy.newProject}</button>
							<button type="button" role="menuitem" data-project-action="open">{copy.openProject}</button>
							<hr />
							<button type="button" role="menuitem" data-project-action="rename">{copy.renameProject}</button>
							<button type="button" role="menuitem" data-project-action="duplicate">{copy.duplicateProject}</button>
							<button class="danger" type="button" role="menuitem" data-project-action="delete">{copy.deleteProject}</button>
						</div>
					</div>
					<label class="editor-button primary import-button">
						{copy.importAudio}
						<input data-import-input type="file" accept="audio/*,.aif,.aiff,.aup3,.flac,.m4a,.mp3,.oga,.ogg,.opus,.wav,.webm" multiple />
					</label>
				</div>
			</header>

			<div class="control-deck">
				<div class="button-strip edit-strip" role="group" aria-label={copy.editControls}>
					<button class="deck-button" type="button" data-edit="undo" title={copy.undo} disabled><span aria-hidden="true">↶</span><span>{copy.undo}</span></button>
					<button class="deck-button" type="button" data-edit="redo" title={copy.redo} disabled><span aria-hidden="true">↷</span><span>{copy.redo}</span></button>
					<span class="strip-divider" aria-hidden="true"></span>
					<button class="deck-button" type="button" data-edit="cut" title={copy.cut} disabled><span aria-hidden="true">✂</span><span>{copy.cut}</span></button>
					<button class="deck-button" type="button" data-edit="copy" title={copy.copy} disabled><span aria-hidden="true">▣</span><span>{copy.copy}</span></button>
					<button class="deck-button" type="button" data-edit="paste" title={copy.paste} disabled><span aria-hidden="true">▤</span><span>{copy.paste}</span></button>
					<button class="deck-button" type="button" data-edit="split" title={copy.split} disabled><span aria-hidden="true">│</span><span>{copy.split}</span></button>
					<button class="deck-button" type="button" data-edit="delete" title={copy.liftDelete} disabled><span aria-hidden="true">⌫</span><span>{copy.liftDelete}</span></button>
					<button class="deck-button" type="button" data-edit="ripple-delete" title={copy.rippleDelete} disabled><span aria-hidden="true">⇤</span><span>{copy.rippleDelete}</span></button>
				</div>

				<div class="transport-strip" role="group" aria-label={copy.transport}>
					<button class="transport-button" type="button" data-transport="jump-start" aria-label={copy.jumpStart} title={copy.jumpStart}>|◀</button>
					<button class="transport-button" type="button" data-transport="rewind" aria-label={copy.rewind} title={copy.rewind}>−5</button>
					<button class="transport-button main" type="button" data-transport="play" aria-label={copy.play} title={copy.play}><span data-play-icon aria-hidden="true">▶</span><span class="visually-hidden" data-play-label>{copy.play}</span></button>
					<button class="transport-button" type="button" data-transport="stop" aria-label={copy.stop} title={copy.stop}>■</button>
					<button class="transport-button" type="button" data-transport="forward" aria-label={copy.forward} title={copy.forward}>+5</button>
					<button class="transport-button" type="button" data-transport="jump-end" aria-label={copy.jumpEnd} title={copy.jumpEnd}>▶|</button>
					<button class="transport-button toggle" type="button" data-transport="loop" aria-label={copy.loop} title={copy.loop} aria-pressed="false">↻</button>
					<button class="transport-button record" type="button" data-transport="record" aria-label={copy.record} title={copy.record} aria-pressed="false"><span aria-hidden="true"></span></button>
				</div>

				<div class="time-cluster">
					<div class="time-readout">
						<span>{copy.playhead}</span>
						<output data-time-display aria-live="off">00:00:00.000</output>
					</div>
					<div class="input-cluster">
						<label class="monitor-toggle"><input type="checkbox" data-monitor /> <span>{copy.monitor}</span></label>
						<label class="latency-control"><span>{copy.latencyOffset}</span><input type="number" min="-500" max="500" step="1" value="0" data-latency-offset /></label>
						<div class="input-meter" data-input-meter role="meter" aria-label={copy.inputLevel} aria-valuemin="-60" aria-valuemax="0" aria-valuenow="-60"><span data-input-meter-fill></span></div>
					</div>
				</div>
			</div>

			<div class="editor-status-row">
				<p class="editor-status" data-status data-state="info" role="status">{copy.ready}</p>
				<p class="project-stat"><span>{copy.localProject}</span><span aria-hidden="true">·</span><span data-storage-usage>{copy.storage}: —</span></p>
			</div>

			<div class="editor-workspace">
				<main class="timeline-panel" aria-labelledby={`timeline-heading-${locale}`}>
					<div class="timeline-heading-row">
						<div>
							<h2 id={`timeline-heading-${locale}`}>{copy.timeline}</h2>
							<p>{copy.timelineHint}</p>
						</div>
						<div class="timeline-actions">
							<button class="editor-button" type="button" data-add-track>+ {copy.addTrack}</button>
							<div class="view-strip" role="group" aria-label={`${copy.waveformView} / ${copy.spectrogramView}`}>
								<button type="button" data-timeline-view="waveform" aria-pressed="true">{copy.waveformView}</button>
								<button type="button" data-timeline-view="spectrogram" aria-pressed="false">{copy.spectrogramView}</button>
							</div>
							<div class="zoom-strip" role="group" aria-label={copy.zoomControls}>
								<button type="button" data-zoom="out" aria-label={copy.zoomOut} title={copy.zoomOut}>−</button>
								<button type="button" data-zoom="fit" title={copy.zoomFit}>{copy.zoomFit}</button>
								<button type="button" data-zoom="in" aria-label={copy.zoomIn} title={copy.zoomIn}>+</button>
							</div>
							<button class="inspector-launch" type="button" data-inspector-toggle aria-controls={`audio-editor-inspector-${locale}`} aria-expanded="false">{copy.openInspector}</button>
						</div>
					</div>

					<div class="timeline-scroll" data-timeline tabindex="0" aria-label={copy.timeline}>
						<div class="timeline-inner" data-timeline-inner>
							<div class="ruler-row">
								<div class="ruler-corner"><span>{copy.tracks}</span></div>
								<div class="ruler" data-ruler>
									<canvas data-ruler-canvas aria-hidden="true"></canvas>
									<div class="selection-overlay" data-selection-overlay hidden></div>
									<button class="ruler-playhead" type="button" role="slider" data-playhead aria-label={copy.playhead} aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" style="--playhead-x: 0px"><span></span></button>
								</div>
							</div>

							<div class="track-list" data-track-list aria-label={copy.tracks}></div>
							<div class="timeline-empty" data-empty-state>
								<span class="empty-wave" aria-hidden="true">⌁⌁⌁</span>
								<strong>{copy.emptyTitle}</strong>
