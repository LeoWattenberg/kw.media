---
import type { Locale } from '../../i18n';
import ToolIntro from './shared/ToolIntro.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const configuredOrigin = import.meta.env.PUBLIC_SOUNDSCAPER_ORIGIN ?? 'https://soundscaper.org';
const soundscaperOrigin = new URL(configuredOrigin);
const embedUrl = new URL(`/embed/${locale}/`, soundscaperOrigin);
const standaloneUrl = new URL(`/${locale}/`, soundscaperOrigin);
const copy = {
	de: {
		eyebrow: 'Mehrspur-Audio lokal bearbeiten',
		title: 'Soundscaper',
		intro: 'Nimm Audio auf, schneide mehrere Spuren nondestruktiv, mische Effekte und prüfe Lautheit und Spektrum.',
		privacy: 'Soundscaper verarbeitet deine Aufnahmen, Projekte und Audiodateien lokal in deinem Browser.',
		frameTitle: 'Soundscaper Audio-Editor',
		open: 'Soundscaper in einem neuen Tab öffnen',
	},
	en: {
		eyebrow: 'Edit multitrack audio locally',
		title: 'Soundscaper',
		intro: 'Record audio, edit multiple tracks nondestructively, mix effects, and inspect loudness and spectrum.',
		privacy: 'Soundscaper processes your recordings, projects, and audio files locally in your browser.',
		frameTitle: 'Soundscaper audio editor',
		open: 'Open Soundscaper in a new tab',
	},
}[locale];
---

<ToolIntro eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} note={copy.privacy} />

<section class="section soundscaper-embed tool-workspace" data-soundscaper-embed>
	<div class="container soundscaper-embed__container">
		<iframe
			class="soundscaper-embed__frame"
			src={embedUrl.toString()}
			title={copy.frameTitle}
			loading="eager"
			allow="microphone; clipboard-read; clipboard-write; fullscreen"
			allowfullscreen
			referrerpolicy="strict-origin-when-cross-origin"
		></iframe>
		<p class="soundscaper-embed__fallback">
			<a href={standaloneUrl.toString()} target="_blank" rel="noopener noreferrer">{copy.open}</a>
		</p>
	</div>
</section>

<style>
	.soundscaper-embed {
		padding-block: 20px 42px;
		background: var(--color-surface-raised);
	}

	.soundscaper-embed__container {
		width: min(100% - 24px, 1600px);
	}

	.soundscaper-embed__frame {
		display: block;
		width: 100%;
		height: max(780px, calc(100vh - 40px));
		background: var(--color-surface-raised);
		border: 1px solid var(--color-line);
		border-radius: 8px;
	}

	.soundscaper-embed__fallback {
		margin: 12px 0 0;
		color: var(--color-muted);
		font-size: 0.9rem;
		font-weight: 750;
		text-align: right;
	}

	.soundscaper-embed__fallback a:hover {
		color: var(--color-accent-dark);
	}

	@media (max-width: 900px) {
		.soundscaper-embed { padding-top: 12px; }
		.soundscaper-embed__container { width: 100%; }
		.soundscaper-embed__frame { min-height: 720px; border-inline: 0; border-radius: 0; }
		.soundscaper-embed__fallback { padding-inline: 12px; }
	}
</style>
