				</form>
			</dialog>
		</div>
	</div>
</section>

<script>
	import { initAudioEditors } from '../../lib/tools/audio-editor/app';

	for (const root of document.querySelectorAll('[data-audio-editor]:not([data-audio-editor-bound])')) {
