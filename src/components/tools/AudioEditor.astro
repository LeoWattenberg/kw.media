					<span class="clip-label" data-clip-label>{copy.clip}</span>
					<span class="clip-fade in" data-clip-fade="in"></span>
					<span class="clip-fade out" data-clip-fade="out"></span>
					<span class="clip-handle end" data-clip-handle="end"></span>
				</div>
			</template>

			<template data-effect-template>
