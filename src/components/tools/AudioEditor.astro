						<div class="track-toggles"><button type="button" data-track-action="mute" aria-pressed="false">M <span>{copy.mute}</span></button><button type="button" data-track-action="solo" aria-pressed="false">S <span>{copy.solo}</span></button><button class="arm" type="button" data-track-action="arm" aria-pressed="false">● <span>{copy.arm}</span></button></div>
						<label class="compact-slider"><span>{copy.gain}</span><input type="range" min="-60" max="12" step="0.1" value="0" data-track-gain /><output data-track-gain-value>0.0 dB</output></label>
