---
interface Props {
	label: string;
	metric: string;
	unit: string;
	wide?: boolean;
}

const { label, metric, unit, wide = false } = Astro.props;
---

<div class:list={['metric-card', { 'metric-wide': wide }]}>
	<span>{label}</span>
	<strong data-metric={metric}>—</strong>
	<small>{unit}</small>
</div>

<style>
	.metric-card {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 5px 8px;
		align-items: end;
		padding: 13px;
		background: var(--color-surface-alt);
		border: 1px solid var(--color-line);
		border-radius: 7px;
	}

	.metric-card span {
		grid-column: 1 / -1;
		min-height: 2.25em;
		color: var(--color-muted);
		font-size: 0.76rem;
		font-weight: 800;
		line-height: 1.15;
		text-transform: uppercase;
	}

	.metric-card strong {
		font-size: clamp(1.4rem, 2.5vw, 2rem);
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.metric-card small {
		color: var(--color-muted);
		font-weight: 750;
	}

	.metric-wide {
		grid-column: 1 / -1;
	}

	@media (max-width: 1100px) {
		.metric-wide {
			grid-column: auto;
		}
	}
</style>
