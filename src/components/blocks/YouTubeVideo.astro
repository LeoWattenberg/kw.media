---
import type { YouTubeVideoBlock } from '../../data/pages';
import YouTubeConsentEmbed from '../YouTubeConsentEmbed.astro';

interface Props {
	block: YouTubeVideoBlock;
	locale: 'de' | 'en';
}

const { block, locale } = Astro.props;
const videoUrl = `https://www.youtube.com/embed/${encodeURIComponent(block.videoId)}`;
---

<section class="section video-block" id={block.anchor}>
	<div class="container video-inner">
		<div class="section-head">
			{block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
			<h2>{block.title}</h2>
			{block.body?.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<YouTubeConsentEmbed
			class="video-frame"
			locale={locale}
			src={videoUrl}
			title={block.title}
			referrerpolicy="strict-origin-when-cross-origin"
		/>
	</div>
</section>

<style>
	.video-block {
		background: var(--color-surface-alt);
		scroll-margin-top: 24px;
	}

	.video-inner {
		display: grid;
		gap: 28px;
	}

	.section-head {
		max-width: 760px;
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1;
		letter-spacing: 0;
	}

	.section-head > p:not(.eyebrow) {
		margin: 18px 0 0;
		color: var(--color-muted);
		font-size: 1.08rem;
	}

	.video-frame {
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: var(--color-deep);
		border: 1px solid var(--color-line);
		border-radius: 8px;
		box-shadow: var(--shadow-soft);
	}

	.video-frame :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.video-frame :global(.youtube-consent-placeholder) {
		min-height: 100%;
	}
</style>
