---
import type { CredentialsBlock } from '../../data/pages';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
	block: CredentialsBlock;
	locale: Locale;
}

const { block, locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="credentials" aria-label={t('a11y.credentials')}>
	<div class="container credentials-inner">
		{block.items.map((item) => <span>{item}</span>)}
	</div>
</section>

<style>
	.credentials {
		background: var(--color-deep);
		color: var(--color-deep-contrast);
	}

	.credentials-inner {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1px;
	}

	span {
		display: grid;
		min-height: 92px;
		place-items: center;
		padding: 18px;
		background: var(--color-deep-subtle);
		font-weight: 800;
		text-align: center;
	}
</style>
