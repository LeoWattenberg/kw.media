---
import type { TextBlock } from '../../data/pages';
import { contentImage } from '../../lib/images';
import { localizeMediaUrl } from '../../lib/media';
import { withBase } from '../../lib/url';

interface Props {
	block: TextBlock;
}

const { block } = Astro.props;
const image = block.image ? localizeMediaUrl(block.image) : undefined;
// The image track tops out at 420.95px — .container caps at 1120px, the grid gap at 80px,
// and the track takes 0.68 of the remaining 1.68fr — so `sizes` says 420px rather than a vw
// share that keeps growing past that cap. 420px is also what contentWidths is built around,
// so a 1x panel asks for the 420 variant and a 2x panel for the 840 one; rounding the last
// 0.95px up instead would push every retina panel onto the 1260 variant for two pixels.
// Below 820px the panel stacks and spans the container: the viewport less its 32px gutter.
const responsive = await contentImage(image);
---

<section class="section text-panel">
	<div class:list={['container', 'text-inner', block.reverse && 'reverse', !image && 'no-image']}>
		<div>
			{block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
			<h2>{block.title}</h2>
			{block.body.map((paragraph) => <p>{paragraph}</p>)}
			{
				block.checks && (
					<ul>
						{block.checks.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				)
			}
		</div>
		{
			image && (
				responsive ? (
					<img
						src={responsive.src}
						srcset={responsive.srcset}
						sizes="(max-width: 820px) calc(100vw - 32px), 420px"
						width={responsive.width}
						height={responsive.height}
						alt={block.imageAlt ?? ''}
						loading="lazy"
						decoding="async"
					/>
				) : (
					<img src={withBase(image)} alt={block.imageAlt ?? ''} loading="lazy" decoding="async" />
				)
			)
		}
	</div>
</section>

<style>
	.text-panel {
		background: var(--color-surface-alt);
	}

	.text-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.68fr);
		gap: clamp(32px, 7vw, 80px);
		align-items: center;
	}

	.text-inner.reverse {
		grid-template-columns: minmax(280px, 0.68fr) minmax(0, 1fr);
	}

	.text-inner.no-image {
		display: block;
		max-width: 920px;
	}

	.text-inner.reverse img {
		order: -1;
	}

	h2 {
		margin: 0;
		font-size: clamp(2.1rem, 5vw, 4.4rem);
		line-height: 1;
		letter-spacing: 0;
	}

	p:not(.eyebrow) {
		max-width: 48rem;
		margin: 18px 0 0;
		color: var(--color-muted);
		font-size: 1.06rem;
	}

	ul {
		display: grid;
		gap: 10px;
		margin: 24px 0 0;
		padding: 0;
		list-style: none;
	}

	li {
		color: var(--color-ink);
		font-weight: 750;
	}

	li::before {
		content: '✓';
		margin-right: 10px;
		color: var(--color-accent);
	}

	img {
		width: 100%;
		/* Without height:auto the hinted height from the height attribute wins over
		   aspect-ratio, and the panel image stretches to the source's full pixel height. */
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 8px;
	}

	@media (max-width: 820px) {
		.text-inner,
		.text-inner.reverse {
			grid-template-columns: 1fr;
		}

		.text-inner.reverse img {
			order: 0;
		}
	}
</style>
