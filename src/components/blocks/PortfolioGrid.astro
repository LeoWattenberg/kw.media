---
import type { PortfolioBlock } from '../../data/pages';
import { contentImage } from '../../lib/images';
import { localizeMediaUrl } from '../../lib/media';
import { withBase } from '../../lib/url';

interface Props {
	block: PortfolioBlock;
}

const { block } = Astro.props;
const projects = await Promise.all(block.items.map(async (item) => {
	const image = localizeMediaUrl(item.image);

	return {
		item,
		image,
		responsive: await contentImage(image),
	};
}));
---

<section class="section portfolio" data-portfolio>
	<div class="container">
		<div class="section-head">
			{block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
			<h2>{block.title}</h2>
			{block.intro && <p>{block.intro}</p>}
		</div>
		<div class="project-grid" data-portfolio-grid>
			{
				projects.map(({ item, image, responsive }) => (
					<article>
						<a class="project-card" href={withBase(item.href)}>
							<div class="project-image">
								{
									responsive ? (
										<img
											src={responsive.src}
											srcset={responsive.srcset}
											sizes="(max-width: 760px) calc(100vw - 32px), 550px"
											width={responsive.width}
											height={responsive.height}
											alt={item.imageAlt}
											loading="lazy"
											decoding="async"
										/>
									) : image ? (
										<img src={withBase(image)} alt={item.imageAlt} loading="lazy" decoding="async" />
									) : null
								}
							</div>
							<div class="project-copy">
								<p class="project-kind">{item.kind}</p>
								<h3>{item.title}</h3>
								<p class="project-text">{item.text}</p>
								<span class="project-action">
									{block.linkLabel}
									<span aria-hidden="true">↗</span>
								</span>
							</div>
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.portfolio {
		background: var(--color-surface-raised);
	}

	.section-head {
		max-width: 760px;
		margin-bottom: 32px;
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 4.2rem);
		line-height: 1;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.section-head > p:not(.eyebrow) {
		margin: 16px 0 0;
		color: var(--color-muted);
		font-size: 1.05rem;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}

	article {
		min-width: 0;
	}

	.project-card {
		display: grid;
		grid-template-rows: auto 1fr;
		height: 100%;
		overflow: hidden;
		color: var(--color-ink);
		background: var(--color-surface-alt);
		border: 1px solid var(--color-line);
		border-radius: 8px;
		box-shadow: var(--shadow-soft);
		text-decoration: none;
		transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.project-card:focus-visible {
		outline: 3px solid var(--color-accent);
		outline-offset: 4px;
	}

	.project-image {
		overflow: hidden;
		aspect-ratio: 16 / 10;
		background: var(--color-line);
		border-bottom: 1px solid var(--color-line);
	}

	img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 240ms ease;
	}

	.project-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(20px, 3vw, 28px);
	}

	.project-kind {
		margin: 0 0 8px;
		color: var(--color-accent-dark);
		font-size: 0.76rem;
		font-weight: 850;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	h3 {
		margin: 0;
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		line-height: 1.12;
		letter-spacing: 0;
	}

	.project-text {
		margin: 14px 0 0;
		color: var(--color-muted);
	}

	.project-action {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: auto;
		padding-top: 22px;
		color: var(--color-accent-dark);
		font-weight: 850;
	}

	.project-action span {
		font-size: 1.05em;
		transition: transform 180ms ease;
	}

	@media (hover: hover) {
		.project-card:hover {
			border-color: var(--color-accent-line);
			box-shadow: var(--shadow-raised);
			transform: translateY(-4px);
		}

		.project-card:hover img {
			transform: scale(1.015);
		}

		.project-card:hover .project-action span {
			transform: translate(2px, -2px);
		}
	}

	@media (max-width: 760px) {
		.project-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card,
		img,
		.project-action span {
			transition: none;
		}
	}
</style>
