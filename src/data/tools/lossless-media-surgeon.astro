---
import ToolPageShell from '../../components/ToolPageShell.astro';
import LosslessMediaSurgeon from '../../components/tools/LosslessMediaSurgeon.astro';
import { defineToolModule } from '../../lib/tool-page-module';

export const toolModule = defineToolModule('lossless-media-surgeon', {
	id: 'lossless-media-surgeon',
	translations: {
		de: { path: '/de/tools/lossless-media-surgeon/', title: 'Lossless Media Surgeon', description: 'Remuxe, schneide und ändere lokale Audio- und Videotracks ohne erneute Kodierung mit FFmpeg WASM.' },
		en: { path: '/en/tools/lossless-media-surgeon/', title: 'Lossless Media Surgeon', description: 'Remux, trim, and change local audio and video tracks without re-encoding using FFmpeg WASM.' },
	},
});
const { tool, alternatePaths } = Astro.props;
---
<ToolPageShell tool={tool} alternatePaths={alternatePaths}><LosslessMediaSurgeon locale={tool.locale} /></ToolPageShell>
