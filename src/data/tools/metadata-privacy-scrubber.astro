---
import ToolPageShell from '../../components/ToolPageShell.astro';
import MetadataPrivacyScrubber from '../../components/tools/MetadataPrivacyScrubber.astro';
import { defineToolModule } from '../../lib/tool-page-module';

export const toolModule = defineToolModule('metadata-privacy-scrubber', {
	id: 'metadata-privacy-scrubber',
	translations: {
		de: { path: '/de/tools/metadaten-entfernen/', title: 'Metadaten entfernen', description: 'Entferne EXIF, XMP, Kapitel und Container-Metadaten aus lokalen Medien.' },
		en: { path: '/en/tools/metadata-remover/', title: 'Metadata Remover', description: 'Remove EXIF, XMP, chapters, and container metadata from local media.' },
	},
});
const { tool, alternatePaths } = Astro.props;
---
<ToolPageShell tool={tool} alternatePaths={alternatePaths}><MetadataPrivacyScrubber locale={tool.locale} /></ToolPageShell>
