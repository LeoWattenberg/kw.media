---
import ToolPageShell from '../../components/ToolPageShell.astro';
import RasterSvgWorkbench from '../../components/tools/RasterSvgWorkbench.astro';
import { defineToolModule } from '../../lib/tool-page-module';

export const toolModule = defineToolModule('raster-svg-workbench', {
	id: 'raster-svg-workbench',
	translations: {
		de: { path: '/de/tools/raster-svg-workbench/', title: 'Raster/SVG Workbench', description: 'Vektorisiere Rasterbilder zu SVG und rendere SVGs lokal als PNG.' },
		en: { path: '/en/tools/raster-svg-workbench/', title: 'Raster/SVG Workbench', description: 'Vectorize raster images to SVG and render SVGs locally as PNG.' },
	},
});
const { tool, alternatePaths } = Astro.props;
---
<ToolPageShell tool={tool} alternatePaths={alternatePaths}><RasterSvgWorkbench locale={tool.locale} /></ToolPageShell>
